#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require
#include "../Common/Common.glsl"
#include "../SSGI/SSGISurface.glsl"
#include "../GI/GIReceiverOrigin.glsl"
#include "../GIReceiverBias/GIReceiverBiasCommon.glsl"
layout(set=0,binding=0) uniform accelerationStructureEXT tlas;
layout(set=1,binding=0) uniform sampler2D inputPosition;
layout(set=1,binding=1) uniform sampler2D inputNormal;
layout(set=1,binding=2) uniform sampler2D inputMaterial;
struct Region { vec4 minimum; vec4 sizeBias; vec4 trace; vec4 countsPriority; };
layout(set=1,binding=4) uniform Info { vec4 screenSize; vec4 regionInfo; Region regions[8]; vec4 debug; };
layout(set=1,binding=15,std430) buffer ReceiverBiasOutput
{
    uvec4 header;
    GIReceiverBiasRecord records[];
};
layout(location=0) rayPayloadEXT float hitDistance;
float MeasureClearance(vec3 position,vec3 direction,float requested,float epsilon)
{
    if(requested<=epsilon) return -1.0;
    hitDistance=-1.0;
    // 必须获取最近命中，不能使用任意 first-hit 距离限制偏移。
    traceRayEXT(tlas,gl_RayFlagsNoneEXT,0xff,0,0,0,position+direction*epsilon,
        0.0,direction,requested*1.25-epsilon,0);
    return hitDistance<0.0?-1.0:hitDistance+epsilon;
}
void main()
{
    uvec2 coord=gl_LaunchIDEXT.xy;
    uvec2 size=(uvec2(screenSize.xy)+3u)/4u;
    if(any(greaterThanEqual(coord,size))) return;
    uint index=coord.y*size.x+coord.x;
    if(index==0u) header=uvec4(1u,size,0u);
    records[index].surface=vec4(0.0);records[index].limits=vec4(0.0);
    ivec2 fullSize=ivec2(screenSize.xy);
    ivec2 pixel=min(ivec2(coord)*4+2,fullSize-1);
    vec4 position=texelFetch(inputPosition,pixel,0);
    if(position.w<=0.0) return;
    float material=round(texelFetch(inputMaterial,pixel,0).z);
    if(int(material)==MATERIAL_ID_GRASS || int(material)==MATERIAL_ID_TREE) return;
    vec3 shading=normalize(texelFetch(inputNormal,pixel,0).xyz);
    vec3 dx=SSGI_SurfaceDerivative(position,
        texelFetch(inputPosition,max(pixel-ivec2(1,0),ivec2(0)),0),
        texelFetch(inputPosition,min(pixel+ivec2(1,0),fullSize-1),0));
    vec3 dy=SSGI_SurfaceDerivative(position,
        texelFetch(inputPosition,max(pixel-ivec2(0,1),ivec2(0)),0),
        texelFetch(inputPosition,min(pixel+ivec2(0,1),fullSize-1),0));
    vec3 N=SSGI_NormalFromDerivatives(dx,dy,shading);
    uint selected=0xffffffffu;float priority=-3.402823e38,fade=-1.0;
    for(uint r=0u;r<min(uint(regionInfo.x),8u);++r)
    {
        Region v=regions[r];
        if(any(lessThan(position.xyz,v.minimum.xyz)) || any(greaterThan(position.xyz,v.minimum.xyz+v.sizeBias.xyz))) continue;
        vec3 edge=min(position.xyz-v.minimum.xyz,v.minimum.xyz+v.sizeBias.xyz-position.xyz);
        float f=v.trace.z>1e-4?smoothstep(0.0,v.trace.z,min(min(edge.x,edge.y),edge.z)):1.0;
        if(selected==0xffffffffu || v.countsPriority.w>priority || (v.countsPriority.w==priority && f>fade))
        {selected=r;priority=v.countsPriority.w;fade=f;}
    }
    if(selected==0xffffffffu) return;
    float requested=max(regions[selected].sizeBias.w,0.0);
    float epsilon=GI_ReceiverOriginEpsilon(position.xyz);
    // 相同方向只测一次；不同方向分别测量，不能拿任意 Probe 射线距离代替法向净空。
    bool sameDirection=dot(N,shading)>0.999999;
    float normalDistance=MeasureClearance(position.xyz,N,sameDirection?max(requested,0.05):requested,epsilon);
    float screenDistance=sameDirection?normalDistance:MeasureClearance(position.xyz,shading,0.05,epsilon);
    records[index].surface=SSGI_EncodeSurface(position.xyz,N,material);
    records[index].limits=vec4(GI_ClampReceiverBias(requested,normalDistance,epsilon),
        GI_ClampReceiverBias(0.05,screenDistance,epsilon),0.0,float(selected+1u));
}
