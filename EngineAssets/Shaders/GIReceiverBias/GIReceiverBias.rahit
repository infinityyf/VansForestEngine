#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#include "../Common/Common.glsl"
#define GI_RECEIVER_MESH_SET 0
#include "../GI/GIReceiverGeometry.glsl"
#define GI_INSTANCE_MATERIAL_SET 0
#include "../GI/GIInstanceMaterial.glsl"
layout(set=0,binding=50) uniform sampler2D PBRTextures[];
hitAttributeEXT vec2 attribs;
void main()
{
    GIInstanceMaterial material=instanceMaterialData.materials[gl_InstanceID];
    uint packed=material.packedTextureIndex;
    if(GIRejectMaterialFace(material,gl_HitKindEXT!=gl_HitKindBackFacingTriangleEXT))
    {
        ignoreIntersectionEXT;
        return;
    }
    if(material.alphaCutoff<=0.0) return;
    uint textureIndex=GICoverageTextureIndex(material);
    if(packed==0xffffffffu || textureIndex>=2048u) return;
    uint mesh=receiverInstances.instances[gl_InstanceID];
    vec2 uv=ReceiverInterpolatedAttribute(mesh,ReceiverTriangle(mesh),vec3(1.0-attribs.x-attribs.y,attribs),1u).xy;
    if(GIRejectMaterialCoverage(material,textureLod(PBRTextures[nonuniformEXT(textureIndex)],uv,0.0)))
        ignoreIntersectionEXT;
}
