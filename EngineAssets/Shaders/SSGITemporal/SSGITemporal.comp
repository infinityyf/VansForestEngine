#version 450
#extension GL_GOOGLE_include_directive : require
#include "../Common/Common.glsl"
#include "../Common/CameraData.glsl"
#include "../SSGI/SSGISurface.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 1, binding = 0) uniform sampler2D inputPosition;
layout(set = 1, binding = 1) uniform sampler2D inputMotionVector;
layout(set = 1, binding = 2) uniform sampler2D inputHistoryGI;
layout(set = 1, binding = 3, rgba16f) readonly uniform image2D inputCurrentGI;
layout(set = 1, binding = 4, rgba16f) writeonly uniform image2D outputAccumulatedGI;
layout(set = 1, binding = 5) uniform ssgiTemporalInfo
{
    vec4 screenSize;
    vec4 frameParams; // x = 历史帧号（0 重置），yz = previous jitter UV - current jitter UV
};
layout(set = 1, binding = 6) uniform sampler2D inputHistoryMoments;
layout(set = 1, binding = 7, rg16f) writeonly uniform image2D outputMoments;
layout(set = 1, binding = 8) uniform sampler2D inputHistorySurface;
layout(set = 1, binding = 9) uniform sampler2D inputNormal;
layout(set = 1, binding = 10) uniform sampler2D inputMaterial;
layout(set = 1, binding = 11, rgba32f) writeonly uniform image2D outputSurface;

const int TILE_SIZE = 10;
shared vec4 tileGI[100];
shared vec4 tilePosition[100];
shared vec4 tileNormalMaterial[100];

void main()
{
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputAccumulatedGI);
    ivec2 localCoord = ivec2(gl_LocalInvocationID.xy);
    ivec2 groupBase = ivec2(gl_WorkGroupID.xy) * 8;
    // 边缘 workgroup 的越界线程仍须参加共享 tile 和 barrier。
    for (int i = int(gl_LocalInvocationIndex); i < 100; i += 64)
    {
        ivec2 coord = clamp(groupBase + ivec2(i % TILE_SIZE, i / TILE_SIZE) - 1, ivec2(0), size - 1);
        tileGI[i] = imageLoad(inputCurrentGI, coord);
        tilePosition[i] = texelFetch(inputPosition, coord, 0);
        tileNormalMaterial[i] = vec4(texelFetch(inputNormal, coord, 0).xyz, texelFetch(inputMaterial, coord, 0).z);
    }
    barrier();
    if (any(greaterThanEqual(id, size))) return;
    int center = (localCoord.y + 1) * TILE_SIZE + localCoord.x + 1;
    vec4 position = tilePosition[center];
    if (position.w <= 0.0 || position.w >= FarPlane)
    {
        imageStore(outputAccumulatedGI, id, vec4(0.0));
        imageStore(outputMoments, id, vec4(0.0));
        imageStore(outputSurface, id, vec4(0.0));
        return;
    }
    vec3 normal = normalize(tileNormalMaterial[center].xyz);
    float material = tileNormalMaterial[center].w;
    vec3 dx = SSGI_SurfaceDerivative(position, tilePosition[center - 1], tilePosition[center + 1]);
    vec3 dy = SSGI_SurfaceDerivative(position, tilePosition[center - TILE_SIZE], tilePosition[center + TILE_SIZE]);
    vec3 geometricNormal = SSGI_NormalFromDerivatives(dx, dy, normal);
    float footprint = max(length(dx), length(dy));
    float tolerance = SSGI_PlaneTolerance(position);
    vec3 mean = vec3(0.0);
    float totalWeight = 0.0;
    for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x)
    {
        int tap = center + y * TILE_SIZE + x;
        if (tilePosition[tap].w <= 0.0 || abs(round(material) - round(tileNormalMaterial[tap].w)) > 0.25) continue;
        float weight = SSGI_PlaneWeight(tilePosition[tap].xyz - position.xyz, geometricNormal, tolerance);
        weight *= pow(max(dot(normal, normalize(tileNormalMaterial[tap].xyz)), 0.0), 8.0);
        vec3 value = tileGI[tap].rgb;
        mean += value * weight;
        totalWeight += weight;
    }
    mean /= max(totalWeight, 1e-5);
    vec2 uv = (vec2(id) + 0.5) / vec2(size);
    vec2 motion = texelFetch(inputMotionVector, id, 0).xy;
    vec2 previousUV = uv - motion + frameParams.yz;
    vec4 previousClip = LastVPMatrix * vec4(position.xyz, 1.0);
    vec2 historyPixel = previousUV * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(historyPixel));
    vec2 fraction = fract(historyPixel);
    vec3 historyColor = vec3(0.0);
    vec2 historyMoments = vec2(0.0);
    float historyLength = 0.0, historyWeight = 0.0;
    if (frameParams.x >= 0.5 && previousClip.w > 0.0 &&
        all(greaterThanEqual(previousUV, vec2(0.0))) && all(lessThan(previousUV, vec2(1.0))))
    {
        // 先验证各 tap 的世界表面，再插值颜色；禁止插值打包的法线/材质。
        for (int y = 0; y <= 1; ++y)
        for (int x = 0; x <= 1; ++x)
        {
            ivec2 coord = base + ivec2(x, y);
            if (any(lessThan(coord, ivec2(0))) || any(greaterThanEqual(coord, size))) continue;
            if (!SSGI_HistorySurfaceMatches(texelFetch(inputHistorySurface, coord, 0),
                position, geometricNormal, normal, material, footprint)) continue;
            vec2 bilinear = mix(1.0 - fraction, fraction, vec2(x, y));
            float weight = bilinear.x * bilinear.y;
            vec4 history = texelFetch(inputHistoryGI, coord, 0);
            historyColor += history.rgb * weight;
            // Alpha 只表示历史帧数，与当前 confidence 无关。
            historyLength += round(clamp(history.a * 255.0, 0.0, 255.0)) * weight;
            historyMoments += texelFetch(inputHistoryMoments, coord, 0).xy * weight;
            historyWeight += weight;
        }
    }
    bool valid = historyWeight > 0.2;
    if (valid)
    {
        historyColor /= historyWeight;
        historyLength /= historyWeight;
        historyMoments /= historyWeight;
    }
    float confidence = clamp(tileGI[center].a, 0.0, 1.0);
    float motionPenalty = clamp(length(motion * screenSize.xy) / 8.0, 0.0, 1.0);
    float blend = valid ? max(1.0 / (historyLength + 1.0),
        mix(0.06, 0.04, confidence) + motionPenalty * 0.06) : 1.0;
    // Moments 来自尚未时域积累的输入，避免对降噪输出再估计一次方差。
    float luminance = min(Luminance(max(tileGI[center].rgb, vec3(0.0))), 255.0);
    vec2 moments = vec2(luminance, luminance * luminance);
    if (valid) moments = mix(historyMoments, moments, blend);
    // Raw 来自低采样缓存，同一亮块的邻域不是独立样本。按当前邻域裁剪
    // 历史会把偶发高亮写入整块历史，产生偏亮的马赛克。表面验证通过后
    // 使用原有权重累计；显露/材质变化由历史验证拒绝，灯光突变由帧重置处理。
    vec3 accumulated = valid ? mix(historyColor, mean, blend) : mean;
    float newLength = valid ? min(historyLength + 1.0, 255.0) : 1.0;
    imageStore(outputAccumulatedGI, id, vec4(accumulated, newLength / 255.0));
    imageStore(outputMoments, id, vec4(moments.x, max(moments.y, moments.x * moments.x), 0.0, 0.0));
    imageStore(outputSurface, id, SSGI_EncodeSurface(position.xyz, normal, material));
}
