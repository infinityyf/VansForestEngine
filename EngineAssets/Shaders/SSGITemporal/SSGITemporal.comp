#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/Common.glsl"
#include "../Common/CameraData.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D inputDepth;
layout(set = 1, binding = 1) uniform sampler2D inputMotionVector;
layout(set = 1, binding = 2) uniform sampler2D inputHistoryGI;
layout(set = 1, binding = 3, rgba32f) readonly uniform image2D inputCurrentGI;
layout(set = 1, binding = 4, rgba32f) writeonly uniform image2D outputAccumulatedGI;

layout(set = 1, binding = 5) uniform ssgiTemporalInfo
{
    vec4 screenSize;  // xy = resolution, zw = 1 / resolution
    vec4 frameParams; // x = temporal frame index, 0 means reset history
};
layout(set = 1, binding = 6) uniform sampler2D inputHistoryMoments;
layout(set = 1, binding = 7, rgba32f) writeonly uniform image2D outputMoments;
layout(set = 1, binding = 8) uniform sampler2D inputHistorySurface;
layout(set = 1, binding = 9) uniform sampler2D inputNormal;
layout(set = 1, binding = 10) uniform sampler2D inputMaterial;
layout(set = 1, binding = 11, rgba32f) writeonly uniform image2D outputSurface;

vec2 EncodeNormalOctahedron(vec3 n)
{
    n /= max(abs(n.x) + abs(n.y) + abs(n.z), 1e-6);
    vec2 encoded = n.xz;
    if (n.y < 0.0)
        encoded = (1.0 - abs(encoded.yx)) * sign(encoded);
    return encoded * 0.5 + 0.5;
}

vec3 DecodeNormalOctahedron(vec2 encoded)
{
    vec2 f = encoded * 2.0 - 1.0;
    vec3 n = vec3(f.x, 1.0 - abs(f.x) - abs(f.y), f.y);
    if (n.y < 0.0)
        n.xz = (1.0 - abs(n.zx)) * sign(n.xz);
    return normalize(n);
}

float FetchLinearDepth(ivec2 coord, ivec2 imgSize)
{
    float rawDepth = texelFetch(inputDepth, clamp(coord, ivec2(0), imgSize - 1), 0).r;
    return (rawDepth >= 0.9999) ? FarPlane : LinearizeDepth(rawDepth, NearPlane, FarPlane);
}

float SampleLinearDepth(vec2 uv)
{
    float rawDepth = texture(inputDepth, uv).r;
    return (rawDepth >= 0.9999) ? FarPlane : LinearizeDepth(rawDepth, NearPlane, FarPlane);
}

void ComputeNeighborhoodBoundsAndFilter(
    ivec2 coord,
    ivec2 imgSize,
    out vec4 boundsMin,
    out vec4 boundsMax,
    out vec4 filteredColor)
{
    float centerDepth = FetchLinearDepth(coord, imgSize);
    float edgeThreshold = max(centerDepth * 0.015, 0.08);

    vec4 m1 = vec4(0.0);
    vec4 m2 = vec4(0.0);
    vec4 weightedSum = vec4(0.0);
    float totalWeight = 0.0;
    float statWeight = 0.0;

    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            ivec2 tap = clamp(coord + ivec2(x, y), ivec2(0), imgSize - 1);
            vec4 sampleGI = imageLoad(inputCurrentGI, tap);

            // 深度先线性化到视空间米制距离，再做边界过滤。
            // 这样可避免 raw depth 的非线性分布让远处和斜边跨表面混色。
            float tapDepth = FetchLinearDepth(tap, imgSize);
            float depthDiff = abs(centerDepth - tapDepth);
            if (depthDiff > edgeThreshold)
                continue;

            float w = exp(-depthDiff / max(centerDepth * 0.008, 0.04));
            m1 += sampleGI * w;
            m2 += sampleGI * sampleGI * w;
            weightedSum += sampleGI * w;
            totalWeight += w;
            statWeight += w;
        }
    }

    m1 = (statWeight > 1e-5) ? (m1 / statWeight) : imageLoad(inputCurrentGI, coord);
    m2 = (statWeight > 1e-5) ? (m2 / statWeight) : (m1 * m1);
    vec4 sigma = sqrt(max(m2 - m1 * m1, vec4(0.0)));

    // 只用同一深度面的样本生成 AABB，避免门框、墙角另一侧颜色进入 history clamp 范围。
    boundsMin = m1 - sigma * 1.25;
    boundsMax = m1 + sigma * 1.25;
    filteredColor = (totalWeight > 1e-5) ? (weightedSum / totalWeight) : m1;
}

void main()
{
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outputAccumulatedGI);
    if (id.x >= imgSize.x || id.y >= imgSize.y)
        return;

    vec2 invImgSize = 1.0 / vec2(imgSize);
    vec2 uv = (vec2(id) + 0.5) * invImgSize;

    float currentRawDepth = texture(inputDepth, uv).r;
    float currentDepth = (currentRawDepth >= 0.9999) ? FarPlane : LinearizeDepth(currentRawDepth, NearPlane, FarPlane);

    vec2 motionVector = texture(inputMotionVector, uv).xy;
    vec2 prevUV = uv - motionVector;
    float velocityLen = length(motionVector * screenSize.xy);

    bool valid = all(greaterThan(prevUV, vec2(0.001))) &&
                 all(lessThan(prevUV, vec2(0.999))) &&
                 currentRawDepth < 0.9999;

    if (valid)
    {
        // True previous-frame surface data, rather than sampling the current
        // depth buffer at prevUV. This rejects disocclusions and moving
        // silhouette crossings that current-frame depth cannot represent.
        vec4 previousSurface = texture(inputHistorySurface, prevUV);
        float prevDepth = previousSurface.x;
        float depthDiff = abs(currentDepth - prevDepth);
        valid = depthDiff < max(currentDepth * 0.02, 0.12);
        vec3 currentNormal = normalize(texture(inputNormal, uv).xyz);
        vec3 previousNormal = DecodeNormalOctahedron(previousSurface.yz);
        valid = valid && dot(currentNormal, previousNormal) >= 0.82;
        float currentMaterialID = texture(inputMaterial, uv).z;
        valid = valid && abs(currentMaterialID - previousSurface.w) < 0.25;
    }

    vec4 boundsMin;
    vec4 boundsMax;
    vec4 spatialFilteredGI;
    ComputeNeighborhoodBoundsAndFilter(id, imgSize, boundsMin, boundsMax, spatialFilteredGI);

    vec4 currentGI = imageLoad(inputCurrentGI, id);
    vec4 historyGI = valid ? texture(inputHistoryGI, prevUV) : spatialFilteredGI;
    if (valid)
        historyGI = clamp(historyGI, boundsMin, boundsMax);

    // 主光或 GI 配置变化时 CPU 会把 frameParams.x 置为 0。
    // reset 帧直接采用当前 GI，避免旧亮度在 SSGI temporal history 里继续残留。
    bool resetHistory = frameParams.x < 0.5;
    float historyLength = clamp(historyGI.a * 255.0, 0.0, 255.0);
    vec4 historyMoments = valid ? texture(inputHistoryMoments, prevUV) : vec4(0.0);
    float historyMeanLum = max(historyMoments.x, 0.0);
    float historyVariance = max(historyMoments.y - historyMeanLum * historyMeanLum, 0.0);
    float neighborhoodVariance = Luminance(sqrt(max(boundsMax.rgb - boundsMin.rgb, vec3(0.0))));
    float luminanceVariance = max(sqrt(historyVariance), neighborhoodVariance);
    float screenConfidence = clamp(currentGI.a, 0.0, 1.0);
    float motionPenalty = clamp(velocityLen / 8.0, 0.0, 1.0);
    float variancePenalty = clamp(luminanceVariance / max(Luminance(spatialFilteredGI.rgb), 0.05), 0.0, 1.0);
    float baseBlend = 1.0 / max(historyLength + 1.0, 1.0);
    float blendFactor = clamp(max(baseBlend, 0.04 + motionPenalty * 0.35 + variancePenalty * 0.30 +
        (1.0 - screenConfidence) * 0.12), 0.04, 1.0);
    if (!valid || resetHistory)
        blendFactor = 1.0;

    vec3 accumulated = mix(historyGI.rgb, spatialFilteredGI.rgb, blendFactor);
    float newHistoryLength = (valid && !resetHistory)
        ? min(historyLength + 1.0, 255.0)
        : 1.0;
    imageStore(outputAccumulatedGI, id, vec4(accumulated, newHistoryLength / 255.0));

    float luminance = Luminance(accumulated);
    float momentBlend = clamp(blendFactor, 0.04, 1.0);
    float meanLum = (valid && !resetHistory)
        ? mix(historyMeanLum, luminance, momentBlend)
        : luminance;
    float meanLumSq = (valid && !resetHistory)
        ? mix(max(historyMoments.y, 0.0), luminance * luminance, momentBlend)
        : luminance * luminance;
    imageStore(outputMoments, id, vec4(meanLum, max(meanLumSq, meanLum * meanLum),
        newHistoryLength / 255.0, screenConfidence));

    vec3 currentNormal = normalize(texture(inputNormal, uv).xyz);
    float currentMaterialID = texture(inputMaterial, uv).z;
    imageStore(outputSurface, id, vec4(currentDepth,
        EncodeNormalOctahedron(currentNormal), currentMaterialID));
}
