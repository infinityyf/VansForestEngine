#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/Common.glsl"
#include "../GI/GIProbeCommon.glsl"
#include "../Lights/LightsData.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 1, binding = 0, std430) buffer hitPositionBuffer
{
    f16vec4 hitPosition[];
} hitPositionInfoBuffer;

layout(set = 1, binding = 1, std430) buffer hitNormalBuffer
{
    f16vec4 hitNormal[];
} hitNormalInfoBuffer;

layout(set = 1, binding = 2, std430) buffer directLightResult
{
    f16vec4 directLight[];
} directLightBuffer;

layout(set = 1, binding = 4) uniform samplerCube environmentMap;
layout(set = 1, binding = 5) uniform sampler3D SHRCoeff;
layout(set = 1, binding = 6) uniform sampler3D SHGCoeff;
layout(set = 1, binding = 7) uniform sampler3D SHBCoeff;
layout(set = 1, binding = 8) uniform sampler2D shadowMap;
layout(set = 1, binding = 9) uniform sampler2D punctualShadowMap;
layout(set = 1, binding = 11) uniform sampler2D giVisibilityAtlas;

layout(set = 1, binding = 10, std430) buffer pbrDataBuffer
{
    f16vec4 albedoRoughness[];
} pbrInfo;

layout(push_constant) uniform PushConstants
{
    vec4 gridParams;     // xyz = probe spacing, w = max ray distance
    vec4 cameraDir;
    vec4 cameraUp;
    vec4 cameraRight;
    vec4 dispatchParams; // xyz = probe counts, w = rays per probe
    vec4 frameParams;    // x = frame index, y = spatial update divisor, z = direction update slices
    vec4 regionParams;   // xyz = volume center, w = normal bias
    vec4 lightingParams; // x = sky intensity, y = max indirect radiance, z = max SH L0
} pushConstants;

vec3 EvaluateGIMissSkyRadiance(vec3 rayDirection)
{
    vec3 sunVector = uDirectionLight.direction.xyz;
    if (dot(sunVector, sunVector) <= 1e-6)
        return vec3(0.0);

    vec3 sunDirection = normalize(sunVector);
    vec3 sunRadiance = max(uDirectionLight.color.rgb * uDirectionLight.intensity, vec3(0.0));
    float sunEnergy = max(max(sunRadiance.r, sunRadiance.g), sunRadiance.b);
    if (sunEnergy <= 1e-5)
        return vec3(0.0);

    float sunHeight = sunDirection.y;
    float dayVisibility = smoothstep(-0.04, 0.28, sunHeight);
    float lowSun = (1.0 - smoothstep(0.12, 0.55, sunHeight)) * dayVisibility;
    float horizon = pow(1.0 - abs(clamp(rayDirection.y, -1.0, 1.0)), 2.0);
    float forwardScatter = pow(max(dot(rayDirection, sunDirection), 0.0), 8.0);
    float sunDisk = pow(max(dot(rayDirection, sunDirection), 0.0), 512.0);

    vec3 baseSky = texture(environmentMap, rayDirection).rgb *
        pushConstants.lightingParams.x *
        mix(0.015, 1.0, dayVisibility);

    vec3 sunsetTint = vec3(1.0, 0.46, 0.18);
    vec3 scatterColor = mix(sunRadiance, sunRadiance * sunsetTint, lowSun * horizon);

    // miss ray 需要方向 radiance。当前绑定的 environmentMap 是静态 diffuse 预卷积结果，
    // 必须按太阳高度衰减，否则夜晚或背向太阳时 probe 仍会从旧天空拿到过亮能量。
    vec3 analyticSky = scatterColor * dayVisibility *
        (0.015 * horizon + 0.045 * lowSun * horizon + 0.035 * forwardScatter);
    vec3 analyticSun = sunRadiance * dayVisibility * sunDisk * 0.12;
    return baseSky + analyticSky + analyticSun;
}

void main()
{
    ivec3 originCount = ivec3(pushConstants.dispatchParams.xyz);
    vec3 originStride = pushConstants.gridParams.xyz;
    int sampleCount = max(int(pushConstants.dispatchParams.w), 1);

    int updateDivisor = max(int(pushConstants.frameParams.y), 1);
    int spatialPhaseCount = updateDivisor * updateDivisor * updateDivisor;
    int spatialPhase = int(pushConstants.frameParams.x) % spatialPhaseCount;
    ivec3 spatialOffset = ivec3(
        spatialPhase % updateDivisor,
        (spatialPhase / updateDivisor) % updateDivisor,
        spatialPhase / (updateDivisor * updateDivisor));

    ivec3 probeIndex = ivec3(gl_GlobalInvocationID) * updateDivisor + spatialOffset;
    if (any(greaterThanEqual(probeIndex, originCount)))
        return;

    vec3 originSize = vec3(originCount) * originStride;
    vec3 volumeMin = pushConstants.regionParams.xyz - originSize * 0.5;

    int bufferIndex = probeIndex.z * (originCount.x * originCount.y) + probeIndex.y * originCount.x + probeIndex.x;
    int bufferOffset = bufferIndex * sampleCount;

    float solidAngle = FOUR_PI / float(sampleCount);
    vec3 probeWorld = volumeMin + vec3(originStride * 0.5) + vec3(probeIndex) * originStride;

    int directionSlices = max(int(pushConstants.frameParams.z), 1);
    int dirSliceIndex = (int(pushConstants.frameParams.x) / spatialPhaseCount) % directionSlices;
    int startSample = (sampleCount * dirSliceIndex) / directionSlices;
    int endSample = (sampleCount * (dirSliceIndex + 1)) / directionSlices;

    for (int hitIndex = startSample; hitIndex < endSample; ++hitIndex)
    {
        vec3 rayDirection = SampleSphere(hitIndex, sampleCount);
        int resultIndex = bufferOffset + hitIndex;

        vec4 hitPos = hitPositionInfoBuffer.hitPosition[resultIndex];
        vec4 hitNrm = hitNormalInfoBuffer.hitNormal[resultIndex];

        if (hitPos.w < 0.5)
        {
            directLightBuffer.directLight[resultIndex] = f16vec4(EvaluateGIMissSkyRadiance(rayDirection), 1.0);
            continue;
        }

        vec3 hitNormal = normalize(hitNrm.xyz);
        vec4 albedoRoughness = pbrInfo.albedoRoughness[resultIndex];
        vec3 hitAlbedo = clamp(albedoRoughness.rgb, vec3(0.0), vec3(1.0));

        float hitDistance = length(hitPos.xyz - probeWorld);
        float radius = hitDistance * solidAngle;

        vec3 directDiffuse = vec3(0.0);
        CalculateDirectDiffuse(
            hitPos.xyz,
            hitNormal,
            shadowMap,
            punctualShadowMap,
            radius,
            albedoRoughness,
            directDiffuse);

        vec3 indirectDiffuse = GI_SampleProbeDiffuseLightingL1Visible(
            SHRCoeff,
            SHGCoeff,
            SHBCoeff,
            giVisibilityAtlas,
            hitPos.xyz,
            hitNormal,
            volumeMin,
            originSize,
            pushConstants.regionParams.w,
            min(min(originStride.x, originStride.y), originStride.z) * 2.0);

        // 多次反弹反馈读取的是命中点接收到的 diffuse lighting。
        // 命中点向外反射时需要乘本表面 albedo，避免暗材质反弹过多能量。
        indirectDiffuse = min(indirectDiffuse * hitAlbedo, vec3(pushConstants.lightingParams.y));

        directLightBuffer.directLight[resultIndex] = f16vec4(directDiffuse + indirectDiffuse, 1.0);
    }
}
