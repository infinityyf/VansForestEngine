#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/Common.glsl"
#include "../GI/GIProbeStateData.glsl"
#include "../GI/GIProbeUpdateCommon.glsl"
#define PUNCTUAL_SHADOW_CONSUMER_GI 1
#include "../Lights/LightsData.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(set = 1, binding = 0, std430) buffer hitPositionBuffer { f16vec4 hitPosition[]; } hitPositionInfoBuffer;
layout(set = 1, binding = 1, std430) buffer hitNormalBuffer { f16vec4 hitNormal[]; } hitNormalInfoBuffer;
layout(set = 1, binding = 2, std430) buffer rayRadianceBuffer { f16vec4 radiance[]; } rayRadiance;
layout(set = 1, binding = 3, std430) readonly buffer hitEmissionBuffer { f16vec4 emission[]; } hitEmission;
layout(set = 1, binding = 4) uniform samplerCube environmentMap;
layout(set = 1, binding = 8) uniform sampler2D shadowMap;
layout(set = 1, binding = 9) uniform sampler2DArrayShadow punctualShadowMap;
layout(set = 1, binding = 10, std430) buffer pbrDataBuffer { f16vec4 albedoRoughness[]; } pbrInfo;
layout(set = 1, binding = 11) uniform sampler2D giVisibilityAtlas;
layout(set = 1, binding = 12) uniform sampler2D giIrradianceAtlas;
layout(set = 1, binding = 13, std430) readonly buffer ProbeStateBuffer
{
    GIProbeState states[];
} giProbeStates;

#define GI_LOAD_PROBE_STATE(regionIndex, probeLinearIndex) giProbeStates.states[probeLinearIndex]
#include "../GI/GIProbeCommon.glsl"

layout(push_constant) uniform PushConstants
{
    vec4 gridParams;
    vec4 dispatchParams;
    vec4 frameParams;
    vec4 regionParams;
    vec4 lightingParams;
    vec4 temporalParams;
} pushConstants;

vec3 EvaluateGIMissSkyRadiance(vec3 rayDirection)
{
    vec3 sunVector = uDirectionLight.direction.xyz;
    vec3 sunRadiance = max(uDirectionLight.color.rgb * uDirectionLight.intensity, vec3(0.0));
    float sunLength = length(sunVector);
    vec3 sunDirection = sunLength > 1e-6 ? sunVector / sunLength : vec3(0.0, 1.0, 0.0);
    float dayVisibility = smoothstep(-0.04, 0.28, sunDirection.y);
    float horizon = pow(1.0 - abs(clamp(rayDirection.y, -1.0, 1.0)), 2.0);
    float forwardScatter = pow(max(dot(rayDirection, sunDirection), 0.0), 8.0);
    float sunDisk = pow(max(dot(rayDirection, sunDirection), 0.0), 512.0);
    vec3 baseSky = texture(environmentMap, rayDirection).rgb * pushConstants.lightingParams.x;
    // The preconvolved diffuse cubemap is the scene's sky irradiance.  It
    // must not be attenuated by the sun elevation: dusk/night still has sky
    // ambient, and independently dimming it made indoor DemoHall probes
    // collapse to black despite a configured environment intensity.
    return baseSky +
        sunRadiance * dayVisibility * (0.015 * horizon + 0.035 * forwardScatter + 0.12 * sunDisk);
}

void main()
{
    ivec3 probeCounts = ivec3(pushConstants.dispatchParams.xyz);
    uint spatialDivisor = max(uint(pushConstants.frameParams.y), 1u);
    uint directionSlices = max(uint(pushConstants.frameParams.z), 1u);
    uint raysPerSlice = uint((int(pushConstants.dispatchParams.w) + int(directionSlices) - 1) / int(directionSlices));
    ivec3 activeProbe = ivec3(gl_GlobalInvocationID);
    ivec3 probeIndex = activeProbe * ivec3(GI_UpdateSpatialDivisors(uvec3(probeCounts), spatialDivisor)) +
        ivec3(GI_UpdateSpatialOffset(uint(pushConstants.frameParams.x), uvec3(probeCounts), spatialDivisor));
    if (any(greaterThanEqual(probeIndex, probeCounts)))
        return;

    uvec3 activeDimensions = GI_UpdateDispatchDimensions(uvec3(probeCounts), spatialDivisor,
        uint(pushConstants.frameParams.x));
    uint activeLinear = uint(activeProbe.z) * activeDimensions.x * activeDimensions.y +
        uint(activeProbe.y) * activeDimensions.x + uint(activeProbe.x);
    uint bufferOffset = activeLinear * raysPerSlice;
    vec3 volumeSize = vec3(probeCounts) * pushConstants.gridParams.xyz;
    vec3 volumeMin = pushConstants.regionParams.xyz - volumeSize * 0.5;

    for (uint localRay = 0u; localRay < raysPerSlice; ++localRay)
    {
        bool fixedClassificationRay;
        vec3 rayDirection = GI_ProbeRayDirection(
            probeIndex, probeCounts, uint(pushConstants.dispatchParams.w), localRay, raysPerSlice,
            GI_UpdateDirectionSlice(uint(pushConstants.frameParams.x), uvec3(probeCounts), spatialDivisor, directionSlices),
            directionSlices,
            GI_UpdateCycleIndex(uint(pushConstants.frameParams.x), uvec3(probeCounts), spatialDivisor, directionSlices),
            fixedClassificationRay);
        uint resultIndex = bufferOffset + localRay;
        vec4 hitPos = vec4(hitPositionInfoBuffer.hitPosition[resultIndex]);
        vec3 newRadiance;
        if (hitPos.w < 0.5)
        {
            newRadiance = EvaluateGIMissSkyRadiance(rayDirection);
        }
        else
        {
            vec3 hitNormal = normalize(vec3(hitNormalInfoBuffer.hitNormal[resultIndex]));
            vec4 albedoRoughness = vec4(pbrInfo.albedoRoughness[resultIndex]);
			vec3 emittedRadiance = max(vec3(hitEmission.emission[resultIndex]), vec3(0.0));
            vec3 directDiffuse = vec3(0.0);
            // Hit geometry is transient: direct lighting must be evaluated for
            // this ray, not recovered from a prior frame's unrelated surface.
            CalculateDirectDiffuse(hitPos.xyz, hitNormal, shadowMap, punctualShadowMap,
                albedoRoughness, directDiffuse);
            vec3 indirectDiffuse = GI_SampleProbeIrradianceAtlasVisible(
                0u, ivec3(pushConstants.dispatchParams.xyz), giIrradianceAtlas, giVisibilityAtlas,
                hitPos.xyz, hitNormal, volumeMin, volumeSize, pushConstants.regionParams.w,
                min(min(pushConstants.gridParams.x, pushConstants.gridParams.y), pushConstants.gridParams.z) * 2.0);
			newRadiance = emittedRadiance + directDiffuse + min(indirectDiffuse * clamp(albedoRoughness.rgb, 0.0, 1.0),
                vec3(pushConstants.lightingParams.y));
        }

		// A single extreme emissive/sky/direct sample must never contaminate a
		// probe tile for its entire temporal history.
		newRadiance = min(max(newRadiance, vec3(0.0)), vec3(pushConstants.lightingParams.z));
		rayRadiance.radiance[resultIndex] = f16vec4(newRadiance, 1.0);
    }
}
