#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/Common.glsl"
#include "../Common/CubemapDirection.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform samplerCube inputCubemap;
layout(set = 0, binding = 1, rgba32f) uniform writeonly imageCube diffuseCubemap;
layout(set = 0, binding = 3) uniform EnvironmentFilterInfo
{
    uvec4 filterInfo; // x=resolution, y=mipCount, z=diffuse samples, w=specular samples
};
layout(set = 0, std430, binding = 4) buffer SHCoefficientsBuffer
{
    float shCoefficients[27];
};

vec2 EnvironmentHammersley(uint index, uint sampleCount)
{
    return vec2(float(index) / float(max(sampleCount, 1u)),
        RadicalInverse_VdC(index));
}

vec3 CosineSampleHemisphere(vec2 xi)
{
    float radius = sqrt(xi.x);
    float phi = 2.0 * PI * xi.y;
    return vec3(radius * cos(phi), radius * sin(phi),
        sqrt(max(1.0 - xi.x, 0.0)));
}

vec3 EvaluateDiffuseIrradiance(vec3 normal)
{
    vec3 up = abs(normal.z) < 0.999
        ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    uint sampleCount = max(filterInfo.z, 1u);
    vec3 sum = vec3(0.0);
    for (uint sampleIndex = 0u; sampleIndex < sampleCount; ++sampleIndex)
    {
        vec3 local = CosineSampleHemisphere(
            EnvironmentHammersley(sampleIndex, sampleCount));
        vec3 sampleDirection = normalize(
            tangent * local.x + bitangent * local.y + normal * local.z);
        sum += textureLod(inputCubemap, sampleDirection, 0.0).rgb;
    }
    return PI * sum / float(sampleCount);
}

void UpdateSHCoefficients()
{
    float weight = FOUR_PI / float(SH_SAMPLE_COUNT);
    for (int coefficient = 0; coefficient < 27; ++coefficient)
        shCoefficients[coefficient] = 0.0;
    for (int sampleIndex = 0; sampleIndex < SH_SAMPLE_COUNT; ++sampleIndex)
    {
        vec3 direction = SampleSphere(sampleIndex, SH_SAMPLE_COUNT);
        vec3 color = textureLod(inputCubemap, direction, 0.0).rgb;
        for (int basisIndex = 0; basisIndex < 9; ++basisIndex)
        {
            float weightedBasis = SHBasis(basisIndex, direction) * weight;
            shCoefficients[basisIndex * 3 + 0] += color.r * weightedBasis;
            shCoefficients[basisIndex * 3 + 1] += color.g * weightedBasis;
            shCoefficients[basisIndex * 3 + 2] += color.b * weightedBasis;
        }
    }
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    uint face = gl_GlobalInvocationID.z;
    uint resolution = max(filterInfo.x, 1u);
    if (face >= 6u || any(greaterThanEqual(pixel, ivec2(resolution))))
        return;

    vec3 normal = CubemapDirectionFromPixel(pixel, face, resolution);
    imageStore(diffuseCubemap, ivec3(pixel, int(face)),
        vec4(max(EvaluateDiffuseIrradiance(normal), vec3(0.0)), 1.0));
    if (all(equal(gl_GlobalInvocationID, uvec3(0u))))
        UpdateSHCoefficients();
}
