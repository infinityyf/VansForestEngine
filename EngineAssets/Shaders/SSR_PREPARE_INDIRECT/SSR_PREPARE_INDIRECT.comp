#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 1, binding = 7, std430) buffer SSRTraceControlBuffer
{
    uint rayCount;
    uint dispatchX;
    uint dispatchY;
    uint dispatchZ;
};

void main()
{
    // One indirect workgroup traces one compacted 8x8 screen tile.
    dispatchX = rayCount;
    dispatchY = 1u;
    dispatchZ = 1u;
}
