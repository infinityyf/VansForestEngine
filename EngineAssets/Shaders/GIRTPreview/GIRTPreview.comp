#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_GOOGLE_include_directive : require

#include "../GI/GIProbeCommon.glsl"
#include "../GI/GIProbeUpdateCommon.glsl"
#define GI_WORK_SET 0
#define GI_WORK_BINDING 9
#include "../GI/GIProbeWorkData.glsl"
#define GI_LAYOUT_SET 0
#define GI_LAYOUT_BINDING 10
#include "../GI/GIProbeLayoutData.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer HitPositionBuffer
{
    float values[];
} hitPositionBuffer;

layout(set = 0, binding = 1, std430) readonly buffer HitNormalBuffer
{
    f16vec4 values[];
} hitNormalBuffer;

layout(set = 0, binding = 2, std430) readonly buffer HitPBRBuffer
{
    f16vec4 values[];
} hitPBRBuffer;

layout(set = 0, binding = 3, std430) readonly buffer DirectLightBuffer
{
    f16vec4 values[];
} directLightBuffer;

layout(set = 0, binding = 4, rgba16f) readonly uniform image3D raySummaryImage;
layout(set = 0, binding = 5) uniform sampler2D irradianceAtlas;
layout(set = 0, binding = 6) uniform sampler2D visibilityAtlas;
#include "../GI/GIProbeStateData.glsl"
layout(set = 0, binding = 7, std430) readonly buffer ProbeStateBuffer
{
    GIProbeState states[];
} probeStates;
layout(set = 0, binding = 8, rgba32f) writeonly uniform image2D outputImage;

layout(push_constant) uniform PreviewConstants
{
    vec4 gridParams;       // xyz = grid dimensions, w = rays per probe
    vec4 selectionParams;  // x = mode, y = z slice, z = ray index, w = exposure
    vec4 displayParams;    // x = signed world-position scale
	vec4 updateParams;     // x = update frame, yz = reserved, w = rays per complete probe
} preview;

vec3 TonemapPositive(vec3 value, float exposure)
{
    value = max(value * exposure, vec3(0.0));
    return value / (vec3(1.0) + value);
}

vec3 EncodeSigned(vec3 value)
{
    return vec3(0.5) + 0.5 * value / (vec3(1.0) + abs(value));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec3 grid = max(ivec3(preview.gridParams.xyz), ivec3(1));
    if (pixel.x >= grid.x || pixel.y >= grid.y)
        return;

    int raysPerProbe = max(int(preview.gridParams.w), 1);
    int zSlice = clamp(int(preview.selectionParams.y), 0, grid.z - 1);
    int raysPerActiveProbe = max(int(giProbeWork.header.y), 1);
    int rayIndex = clamp(int(preview.selectionParams.z), 0, raysPerActiveProbe - 1);
    int mode = int(preview.selectionParams.x);
    float exposure = max(preview.selectionParams.w, 0.001);
    ivec3 probeCoord = ivec3(pixel, zSlice);
    int probeIndex = zSlice * grid.x * grid.y + pixel.y * grid.x + pixel.x;
    if (GI_LayoutIsSparse() && uint(probeIndex) >= GI_LayoutProbeCount(0u))
    { imageStore(outputImage, pixel, vec4(0.0)); return; }
    uint activeLinear = GI_FindWorkEntry(uint(probeIndex));
    bool activeProbe = activeLinear != 0xffffffffu;
    if (!activeProbe) activeLinear = 0u;
    rayIndex = min(rayIndex, raysPerActiveProbe - 1);
    uint sampleIndex = GI_WorkRayOffset(activeLinear) + uint(rayIndex);

    // Raw ray-tracing buffers exist only for the current work list.  A
    // black cell therefore means "not updated this frame", never a synthetic
    // zero normal/position that could be mistaken for valid data.
    if (!activeProbe && mode <= 6)
    {
        imageStore(outputImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    float hitT = activeProbe ? hitPositionBuffer.values[sampleIndex] : -1.0;
    vec4 hitPosition = vec4(0.0);
    if (activeProbe)
    {
        uvec4 work = giProbeWork.entries[activeLinear];
        GIProbeRayDirectionContext context = GI_BuildProbeRayDirectionContext(probeCoord, grid, uint(raysPerProbe), work.z);
        bool fixedRay;
        vec3 direction = GI_ProbeRayDirectionPrepared(context, uint(rayIndex), fixedRay);
        vec3 origin = GI_LayoutIsSparse() ? GI_LayoutPosition(giProbeWork.header.z, work.x).xyz :
            GI_LayoutRegionMin(giProbeWork.header.z).xyz + (vec3(probeCoord) + 0.5) *
            GI_LayoutRegionSize(giProbeWork.header.z).xyz / vec3(grid);
        origin += probeStates.states[probeIndex].traceOffsetAndBackface.xyz;
        hitPosition = vec4(hitT >= 0.0 ? origin + direction * hitT : direction, hitT >= 0.0 ? 1.0 : 0.0);
    }
    vec4 hitNormal = activeProbe ? vec4(hitNormalBuffer.values[sampleIndex]) : vec4(0.0);
    vec4 hitPBR = activeProbe ? vec4(hitPBRBuffer.values[sampleIndex]) : vec4(0.0);
    vec4 directLight = activeProbe ? vec4(directLightBuffer.values[sampleIndex]) : vec4(0.0);
    ivec2 irradianceSize = textureSize(irradianceAtlas, 0);
    ivec2 visibilitySize = textureSize(visibilityAtlas, 0);
    vec3 debugDirection = vec3(0.0, 1.0, 0.0);
    vec4 probeIrradiance = textureLod(irradianceAtlas,
        GI_IrradianceAtlasUV(probeCoord, debugDirection, grid, irradianceSize), 0.0);
    vec2 probeDistanceMoments = textureLod(visibilityAtlas,
        GI_VisibilityAtlasUV(probeCoord, debugDirection, grid, visibilitySize), 0.0).rg;
    GIProbeState probeState = probeStates.states[probeIndex];

    vec3 color = vec3(0.0);
    if (mode == 0)
    {
        // 当前活动 Probe 的完整 ray batch 命中率。不能读取
        // raySummaryImage 的最后写入值：那只代表某一条未定义顺序的射线，
        // 会把单射线结果误标为 Probe 统计。
        float hitCount = 0.0;
        for (int localRay = 0; localRay < raysPerActiveProbe; ++localRay)
        {
            uint batchIndex = GI_WorkRayOffset(activeLinear) + uint(localRay);
            hitCount += (hitPositionBuffer.values[batchIndex] >= 0.0 ? 1.0 : 0.0);
        }
        color = vec3(1.0 - hitCount / float(raysPerActiveProbe));
    }
    else if (mode == 1)
    {
        color = vec3(clamp(hitPosition.w, 0.0, 1.0));
    }
    else if (mode == 2)
    {
        color = EncodeSigned(hitPosition.xyz * max(preview.displayParams.x, 0.0001));
    }
    else if (mode == 3)
    {
        color = clamp(hitNormal.xyz * 0.5 + 0.5, 0.0, 1.0);
    }
    else if (mode == 4)
    {
        color = clamp(hitPBR.rgb, 0.0, 1.0);
    }
    else if (mode == 5)
    {
        color = vec3(clamp(hitPBR.a, 0.0, 1.0));
    }
    else if (mode == 6)
    {
        color = TonemapPositive(directLight.rgb, exposure);
    }
    else if (mode == 7)
    {
		color = TonemapPositive(probeIrradiance.rgb, exposure);
    }
    else if (mode == 8)
    {
		color = vec3(clamp(probeDistanceMoments.x / max(preview.displayParams.z, 1e-4), 0.0, 1.0));
    }
    else if (mode == 9)
    {
		float variance = max(probeDistanceMoments.y - probeDistanceMoments.x * probeDistanceMoments.x, 0.0);
		color = vec3(clamp(sqrt(variance) / max(preview.displayParams.z, 1e-4), 0.0, 1.0));
    }
    else if (mode == 10)
    {
		color = vec3(clamp(probeState.relocationAndConfidence.w, 0.0, 1.0));
    }
    else
    {
		color = probeState.metadata.x == 1u ? vec3(0.15, 0.95, 0.2) : vec3(0.95, 0.75, 0.1);
    }

    imageStore(outputImage, pixel, vec4(color, 1.0));
}
