#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require

#include "../Common/Common.glsl"
#include "../Common/CameraData.glsl"
#include "../SSGI/SSGISurface.glsl"
#include "../GI/GIReceiverOrigin.glsl"
#include "../BRDF/ReflectionProbeData.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D inputNormal;
layout(set = 1, binding = 1) uniform sampler2D inputDepth;
layout(set = 1, binding = 2) uniform sampler2D inputPosition;
layout(set = 1, binding = 3) uniform sampler2D inputMaterial;
layout(set = 1, binding = 4) uniform samplerCube inputSkyDiffuse;
layout(set = 1, binding = 5, rgba16f) writeonly uniform image2D outputRadiance;
layout(set = 1, binding = 6, rgba16f) writeonly uniform image2D outputSurface;

struct SSGIRegionParams
{
    vec4 volumeMin;
    vec4 volumeSizeAndBias;
    vec4 traceParams;
    vec4 gridDimensionsAndPriority;
};

layout(set = 1, binding = 7) uniform SSGIProbeCacheInfo
{
    vec4 screenSize;
    vec4 regionInfo;
    SSGIRegionParams regions[8];
    vec4 deferredProbeDebug;
};

layout(set = 1, binding = 8) uniform sampler2D irradianceAtlas[8];
layout(set = 1, binding = 9) uniform sampler2D visibilityAtlas[8];

#include "../GI/GIProbeStateData.glsl"
layout(set = 1, binding = 10, std430) readonly buffer ProbeStateBuffer
{
    GIProbeState states[];
} probeStateBuffers[8];

// 屏幕辐亮度和当前 Hi-Z 输入。
layout(set = 1, binding = 18) uniform sampler2D inputColor;
layout(set = 1, binding = 19) uniform sampler2D hizDepth;
layout(set = 1, binding = 21) uniform sampler2D inputHistorySurface;
layout(set = 1, binding = 22) uniform sampler2D inputMotionVector;
layout(set = 1, binding = 23) uniform SSGIHistoryInfo
{
    vec4 historyScreenSize;
    vec4 historyFrameParams; // 与 Temporal 共用帧号及 previous-current jitter UV
};

GIProbeState LoadScreenCacheProbeState(uint regionIndex, uint probeLinearIndex)
{
    return probeStateBuffers[nonuniformEXT(regionIndex)].states[probeLinearIndex];
}

#define GI_LOAD_PROBE_STATE(regionIndex, probeLinearIndex) \
    LoadScreenCacheProbeState(regionIndex, probeLinearIndex)
#define GI_LAYOUT_SET 1
#define GI_LAYOUT_BINDING 20
#include "../GI/GIProbeLayoutData.glsl"
#define GI_RECEIVER_BINDING 24
#define GI_RECEIVER_BIAS_BINDING 30
#include "../GIReceiverBias/GIReceiverBiasCommon.glsl"
#include "../GI/GIReceiverVisibilityRead.glsl"
#include "../GI/GIProbeCommon.glsl"

const int SSGI_PROBE_CACHE_TILE_SIZE = 4;
const int SSGI_PROBE_CACHE_TILE_SHIFT = 2;
const float SSGI_TRACE_MAX_DISTANCE = 32.0;
const float SSGI_TRACE_BASE_PIXEL_STEP = 1.5;
const int SSGI_TRACE_ITERATION_BUDGET = 128;
const float SSGI_STABLE_WORLD_SEED_SCALE = 16.0;
// 四分之一分辨率缓存每个 texel 使用 4 条射线。相对于全分辨率仍只有
// 0.25 ray / pixel，但可显著降低单个 4x4 screen probe 的块状方差。
const uint SSGI_PROBE_RAY_COUNT = 4u;
// 每帧前进四个方向，在完整 512 点序列上积累，避免每四帧重复同一组 16 条射线。

vec3 CosineWeightedDirection(vec2 u, mat3 TBN)
{
    float phi = TWO_PI * u.x;
    float r = sqrt(u.y);
    float x = r * cos(phi);
    float y = r * sin(phi);
    // TBN 的列依次为切线、副切线、法线，余弦半球必须朝向局部 +Z。
    float z = sqrt(max(0.0, 1.0 - x * x - y * y));
    return TBN * vec3(x, y, z);
}

uint StableScreenProbeSeed(vec3 worldPosition, vec3 normal)
{
    // Screen Probe 不能像高 spp 路径一样每帧完全随机换方向，否则一个
    // 高亮命中会被放大成随镜头移动闪烁的 4x4 亮块。按世界空间量化位置
    // 和几何法线生成固定基准种子，时域在完整低差异序列中前进。
    ivec3 positionCell = ivec3(floor(
        worldPosition * SSGI_STABLE_WORLD_SEED_SCALE));
    ivec3 normalCell = ivec3(round(clamp(normal, vec3(-1.0), vec3(1.0)) * 31.0));
    uvec3 p = uvec3(positionCell);
    uvec3 n = uvec3(normalCell + ivec3(32));
    uint seed = p.x * 0x8da6b343u;
    seed ^= p.y * 0xd8163841u;
    seed ^= p.z * 0xcb1ab31fu;
    seed ^= n.x * 0x165667b1u;
    seed ^= n.y * 0xa24baed5u;
    seed ^= n.z * 0x9fb21c65u;
    seed ^= seed >> 16u;
    seed *= 0x7feb352du;
    seed ^= seed >> 15u;
    return seed;
}

vec3 ComputeCacheGeometricNormal(
    ivec2 pixelCoord,
    ivec2 imageSize,
    vec3 centerPosition,
    vec3 shadingNormal,
    out float footprint)
{
    vec3 fallback = dot(shadingNormal, shadingNormal) > 1e-6
        ? normalize(shadingNormal)
        : vec3(0.0, 1.0, 0.0);
    ivec2 leftCoord = ivec2(max(pixelCoord.x - 1, 0), pixelCoord.y);
    ivec2 rightCoord = ivec2(min(pixelCoord.x + 1, imageSize.x - 1), pixelCoord.y);
    ivec2 downCoord = ivec2(pixelCoord.x, max(pixelCoord.y - 1, 0));
    ivec2 upCoord = ivec2(pixelCoord.x, min(pixelCoord.y + 1, imageSize.y - 1));
    vec4 center = vec4(centerPosition, 1.0);
    vec3 dx = SSGI_SurfaceDerivative(center, texelFetch(inputPosition, leftCoord, 0), texelFetch(inputPosition, rightCoord, 0));
    vec3 dy = SSGI_SurfaceDerivative(center, texelFetch(inputPosition, downCoord, 0), texelFetch(inputPosition, upCoord, 0));
    footprint = max(length(dx), length(dy));
    return SSGI_NormalFromDerivatives(dx, dy, fallback);
}

vec4 SampleRegionDDGI(uint regionIndex, vec3 worldPosition, vec3 normal, float normalBiasScale)
{
    SSGIRegionParams region = regions[regionIndex];
    GIProbeLighting value = GI_SampleProbeIrradianceAtlas(regionIndex, ivec3(region.gridDimensionsAndPriority.xyz),
        irradianceAtlas[nonuniformEXT(regionIndex)], visibilityAtlas[nonuniformEXT(regionIndex)],
        worldPosition, normal, region.volumeMin.xyz, region.volumeSizeAndBias.xyz,
        region.volumeSizeAndBias.w * normalBiasScale, 1.0,
        int(round(region.volumeMin.w)), int(round(region.traceParams.w)));
    return vec4(value.irradiance, value.published);
}
#define GI_SAMPLE_REGION SampleRegionDDGI
#define GI_SAMPLE_SKY(N) SampleSkyDiffuseCube(inputSkyDiffuse, N)
#include "../GI/GIRegionBlend.glsl"
#undef GI_SAMPLE_REGION
#undef GI_SAMPLE_SKY

vec3 EvaluateCachedFallback(vec3 worldPosition, vec3 normal, float vegetationTranslucency)
{
    vec3 front = GI_BlendRegionLighting(worldPosition, normal, 1.0);
    if (vegetationTranslucency <= 0.001) return front;
    vec3 back = GI_BlendRegionLighting(worldPosition, -normal, 1.0);
    return mix(front, max(front, back), clamp(vegetationTranslucency * 0.7, 0.0, 0.7));
}

void main()
{
    ivec2 cacheCoord = ivec2(gl_GlobalInvocationID.xy);
    // The CPU allocates the cache from this same immutable render extent.
    // Reconstructing both extents removes imageSize/textureSize from every
    // cache invocation while preserving the exact ceil(fullSize / 4) rule.
    ivec2 fullSize = max(ivec2(screenSize.xy), ivec2(1));
    ivec2 cacheSize =
        (fullSize + ivec2(SSGI_PROBE_CACHE_TILE_SIZE - 1)) >>
        ivec2(SSGI_PROBE_CACHE_TILE_SHIFT);
    if (any(greaterThanEqual(cacheCoord, cacheSize)))
        return;

    ivec2 anchorCoord = min(
        cacheCoord * SSGI_PROBE_CACHE_TILE_SIZE +
            ivec2(SSGI_PROBE_CACHE_TILE_SIZE / 2),
        fullSize - 1);
    float rawDepth = texelFetch(inputDepth, anchorCoord, 0).r;
    if (rawDepth >= 0.9999)
    {
        imageStore(outputRadiance, cacheCoord, vec4(0.0));
        imageStore(outputSurface, cacheCoord, vec4(0.0, 1.0, 0.0, FarPlane));
        return;
    }

    vec4 normalData = texelFetch(inputNormal, anchorCoord, 0);
    vec4 positionData = texelFetch(inputPosition, anchorCoord, 0);
    vec3 worldPosition = positionData.xyz;
    float anchorFootprint;
    vec3 geometricNormal = ComputeCacheGeometricNormal(
        anchorCoord, fullSize, worldPosition, normalData.xyz, anchorFootprint);
    int materialId = int(round(texelFetch(inputMaterial, anchorCoord, 0).z));
    bool vegetationMaterial = materialId == MATERIAL_ID_TREE;
    float vegetationTranslucency = vegetationMaterial
        ? clamp(normalData.w, 0.0, 1.0)
        : 0.0;
    GI_SetReceiverVisibility(anchorCoord, positionData, geometricNormal, float(materialId), anchorFootprint);
    vec3 fallbackIrradiance = EvaluateCachedFallback(
        worldPosition, geometricNormal, vegetationTranslucency);
    vec3 accumulatedIrradiance = vec3(0.0);
    float screenHitConfidence = 0.0;

    // Lumen 风格的屏幕查询缓存：昂贵的 Hi-Z trace 只在每个 4x4 screen
    // probe 的代表像素执行一次；全分辨率阶段仅做法线/深度引导重建。
    vec3 shadingNormal = normalize(normalData.xyz);
    vec3 startPosition = worldPosition + shadingNormal * GI_ReceiverScreenBias();
    vec3 tangent;
    vec3 bitangent;
    BuildTBN(shadingNormal, tangent, bitangent);
    mat3 TBN = mat3(tangent, bitangent, shadingNormal);
    uint rseed = StableScreenProbeSeed(worldPosition, geometricNormal);
    uint sequenceBase = (uint(FrameIndex) * SSGI_PROBE_RAY_COUNT) & 511u;
    float maxTraceDistance = clamp(
        regionInfo.y, 1.0, min(FarPlane, SSGI_TRACE_MAX_DISTANCE));
    float fadeStartRatio = clamp(regionInfo.z, 0.05, 0.99);
    for (uint rayIndex = 0u; rayIndex < SSGI_PROBE_RAY_COUNT; ++rayIndex)
    {
        // 连续 R2 序列点在余弦加权半球上分布良好；种子依然是表面稳定的，
        // 所以增加采样数不会重新引入镜头移动时的随机闪烁。
        vec2 noise = R2Sequence(int(
            (rseed + sequenceBase + rayIndex) & 511u));
        vec3 direction = CosineWeightedDirection(noise, TBN);
        vec3 rayIrradiance = fallbackIrradiance;
        float rayScreenConfidence = 0.0;
        HiZTraceResult traceResult = TraceHiZ_UV_Bounded(
            hizDepth,
            ViewMatrix,
            ProjectionMatrix,
            startPosition,
            direction,
            maxTraceDistance,
            SSGI_TRACE_BASE_PIXEL_STEP,
            0.02,
            SSGI_TRACE_ITERATION_BUDGET);

        if (traceResult.hit && historyFrameParams.x >= 0.5)
        {
            vec2 hitUV = traceResult.uv;
            ivec2 hitCoord = clamp(ivec2(hitUV * vec2(fullSize)), ivec2(0), fullSize - 1);
            vec3 hitNormal = normalize(texelFetch(inputNormal, hitCoord, 0).xyz);
            if (dot(hitNormal, -direction) > 0.0)
            {
                vec4 hitPosition = texelFetch(inputPosition, hitCoord, 0);
                vec3 hitWorldPosition = hitPosition.xyz;
                float hitFootprint;
                vec3 hitGeometry = ComputeCacheGeometricNormal(hitCoord, fullSize, hitWorldPosition, hitNormal, hitFootprint);
                float hitMaterial = texelFetch(inputMaterial, hitCoord, 0).z;
                vec2 hitMotion = texelFetch(inputMotionVector, hitCoord, 0).xy;
                vec2 lastColorUV = (vec2(hitCoord) + 0.5) / vec2(fullSize) - hitMotion + historyFrameParams.yz;
                ivec2 historyCoord = ivec2(floor(lastColorUV * vec2(fullSize)));
                vec4 lastClip = LastVPMatrix * vec4(hitWorldPosition, 1.0);
                bool colorValid = lastClip.w > 0.0 && hitPosition.w > 0.0 &&
                    all(greaterThanEqual(lastColorUV, vec2(0.0))) && all(lessThan(lastColorUV, vec2(1.0)));
                if (colorValid)
                    colorValid = SSGI_HistorySurfaceMatches(texelFetch(inputHistorySurface, historyCoord, 0),
                        hitPosition, hitGeometry, hitNormal, hitMaterial, hitFootprint);
                if (colorValid)
                {
                    // 已通过表面、运动和历史验证；有效命中的能量不能由 DDGI 亮度重新裁定。
                    vec3 screenIrradiance = max(texelFetch(inputColor, historyCoord, 0).rgb, vec3(0.0));
                    float hitDistance = length(hitWorldPosition - startPosition);
                    float screenTraceWeight = 1.0 - smoothstep(
                        maxTraceDistance * fadeStartRatio,
                        maxTraceDistance,
                        hitDistance);
                    rayIrradiance = mix(
                        fallbackIrradiance, screenIrradiance, screenTraceWeight);
                    rayScreenConfidence = screenTraceWeight;
                }
            }
        }

        accumulatedIrradiance += rayIrradiance;
        screenHitConfidence += rayScreenConfidence;
    }

    vec3 irradiance = accumulatedIrradiance / float(SSGI_PROBE_RAY_COUNT);
    screenHitConfidence /= float(SSGI_PROBE_RAY_COUNT);

    // Keep the cache surface depth identical to the full-resolution consumer:
    // all deferred GBuffer writers already publish positive linear depth in w.
    float linearDepth = max(positionData.w, NearPlane);
    // 0 means invalid cache texel.  Valid entries encode 1 + screen confidence
    // so reconstruction can preserve both validity and temporal confidence in
    // the existing RGBA16F resource without allocating another texture.
    imageStore(outputRadiance, cacheCoord,
        vec4(max(irradiance, vec3(0.0)), 1.0 + screenHitConfidence));
    imageStore(outputSurface, cacheCoord,
        vec4(geometricNormal, linearDepth));
}
