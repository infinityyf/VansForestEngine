#version 450
#extension GL_GOOGLE_include_directive : require

// ==========================================================================
// CloudRayMarch.comp — 1/4 分辨率体积云光线步进
//
// 输出:
//   cloudResult (RGBA16F)  RGB = 云区间内散射，A = 平均透射率（诊断）
//   cloudOpticalDepth (RGBA16F) RGB = 云区间 RGB 光学深度
//   cloudDepth (RG32F) RG = 云区间入口/出口距离
//
// 渲染规格:
//   - 分辨率: ScreenWidth/4 × ScreenHeight/4（由 CPU dispatch 计算，向上取整）
//   - WorkGroup: 8×8×1
//   - 光照: 读取全局 LightsData（太阳方向/颜色）+ CloudParams UBO（云层参数）
//
// 噪声说明:
//   使用 EngineAssets/Textures/VolumeCloud 中的预计算 Perlin-Worley 3D 噪声切片。
// ==========================================================================

#include "../Common/CameraData.glsl"
#include "../Atmosphere/AtmosphereCommon.glsl"
#include "../Atmosphere/AtmosphereViewCommon.glsl"
#include "../Atmosphere/NearMediaDepthCommon.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// --------------------------------------------------------------------------
// Set 1, binding 0: 云层结果输出（1/4 分辨率，RGBA16F）
// --------------------------------------------------------------------------
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D cloudResult;
layout(set = 1, binding = 1, rg32f) uniform writeonly image2D cloudDepth;

// --------------------------------------------------------------------------
// Set 1, binding 1: 云层参数 UBO
// --------------------------------------------------------------------------
layout(set = 1, binding = 2) uniform CloudParamsUBO
{
    float planetBottomRadius; // 唯一来源为 Environment.Planet.bottomRadiusMeters
    float cloudMinHeight; // 云底高度，相对海平面（米）
    float cloudMaxHeight; // 云顶高度，相对海平面（米）
    float density;        // 云基础密度系数
    float coverage;       // 云覆盖度 [0, 1]
    float sunBrightness;  // 太阳光强度倍率
    float atmosphereShadowStrength;
    float mainTileMeters;
    float detailTileMeters;
    float mainHeightScale;
    float detailHeightScale;
    float thresholdLowCoverage;
    float thresholdHighCoverage;
    float densityRemapLow;
    float densityRemapHigh;
    float mainErosionStrength;
    float detailErosionStrength;
    float edgeErosionStrength;
    float verticalShapePower;
    float detailErosionLow;
    float detailErosionHigh;
    float detailEdgeStrength;
    float _opticalPadding;
    float sigmaTRef;
    float viewAbsorption;
    float lightAbsorption;
    float singleScatteringAlbedo;
    float forwardEccentricity;
    float backwardEccentricity;
    float msAttenuation;
    float msContribution;
    float msEccentricity;
    float scatteringTintR;
    float scatteringTintG;
    float scatteringTintB;
    float scatterSourceODScale;
    float scatterSourceCurvePow;
    float aoUpwardScale;
    float ambientBottomStrength;
    float ambientTopStrength;
    float ambientDuskWarmth;
    float boundaryConfidence;
    float boundaryWrap;
    float phiFwdIntensity;
    float phiFwdDepthPow;
    float phiFwdDepthBias;
    float phiFwdMSBuildScale;
    float phiFwdCompress;
    float phiFwdMaxDistance;
    float phiFwdConeRatio;
    float phiFwdMinStep;
    float lightStepCount;
    float boundaryGradientStep;
    float boundaryGradientStrength;
    float shadingDebugMode;
    float _cloudPadding;
    vec4 shadowClipmapParameters;
	vec4 shadowRayMarchParameters;
} uCloud;

// --------------------------------------------------------------------------
// Set 1, binding 2/3: 预计算 3D 噪声纹理
// --------------------------------------------------------------------------
layout(set = 1, binding = 3) uniform sampler3D cloudMainNoise;
layout(set = 1, binding = 4) uniform sampler3D cloudDetailNoise;
layout(set = 1, binding = 6, rgba16f) uniform writeonly image2D cloudOpticalDepth;
layout(set = 1, binding = 7) uniform sampler3D localMediaInjection;
layout(set = 1, binding = 8) uniform sampler2D cloudSceneDepth;

#include "../Common/CloudCommon.glsl"
#include "../Common/CloudLightingHP.glsl"

// --------------------------------------------------------------------------
// 光线步进参数常量
//
// 改为自适应步数：最大步长 80m，保证垂直方向采样分辨率不随厚度下降。
// 原始固定 64 步导致：增大云层厚度时 stepSize 等比增大，采样稀疏，
// 视觉上云厚度不随参数增大而变厚（tRange 增加但密度积分被稀释）。
// --------------------------------------------------------------------------
const float MARCH_MAX_STEP_M = 80.0;   // 单步最大路径长度（米），控制采样分辨率
const int   MARCH_STEPS_MIN  = 32;     // 最少步数（防止极薄云欠采样）
const int   MARCH_STEPS_MAX  = 128;    // 最多步数（性能上限，对应 128 × 80m = 10240m）
const float TRANSMIT_CUTOFF  = 0.01;   // 透射率低于此值时提前终止
const float OPAQUE_OPTICAL_DEPTH = 13.815510558;

float CloudSurfaceTerminalDistance(vec2 uv)
{
    ivec2 depthExtent = textureSize(cloudSceneDepth, 0);
    ivec2 depthPixel = clamp(ivec2(uv * vec2(depthExtent)),
        ivec2(0), depthExtent - 1);
    float deviceDepth = texelFetch(cloudSceneDepth, depthPixel, 0).r;
    if (!AtmosphereHasSurfaceDepth(deviceDepth))
        return uAtmosphereFrame.cameraWorldMetersAndMaxDistance.w;
    vec2 depthUv = (vec2(depthPixel) + 0.5) / vec2(depthExtent);
    vec3 worldPosition = AtmosphereWorldPositionFromDeviceDepth(
        depthUv, deviceDepth);
    return length(worldPosition - cameraPosition.xyz);
}

// --------------------------------------------------------------------------
// 主函数
// --------------------------------------------------------------------------
void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(cloudResult);

    // 越界保护
    if (pixelCoord.x >= outputSize.x || pixelCoord.y >= outputSize.y)
        return;

    // 计算屏幕 UV（像素中心）
    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(outputSize);

    // 重建世界空间视线方向
    vec3 rayDir = AtmosphereWorldDirectionFromUv(uv);

    // 大气空间相机位置（加入地球半径 + 海拔偏移）
    vec3 rayOrigin = -uAtmosphereFrame.planetCenterRelativeToCameraMeters.xyz;

    // 球壳相交：找云层 [tStart, tEnd]
    CloudShellResult shell = IntersectCloudShell(
        rayOrigin, rayDir,
        uCloud.planetBottomRadius,
        uCloud.cloudMinHeight,
        uCloud.cloudMaxHeight
    );

    if (!shell.hit)
    {
        // 无交叉：透射率 = 1（无云遮挡），内散射 = 0
        imageStore(cloudResult, pixelCoord, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(cloudDepth, pixelCoord, vec4(0.0));
		imageStore(cloudOpticalDepth, pixelCoord, vec4(0.0));
        return;
    }

    // 云属于参与介质，必须在最近不透明表面处终止，不能只在最终天空分支
    // 作为覆盖层处理。Forward Opaque 已在本 pass 之前写入主深度。
    float terminalDistance = CloudSurfaceTerminalDistance(uv);
    shell.tEnd = min(shell.tEnd, terminalDistance);
    if (shell.tEnd <= shell.tStart)
    {
        imageStore(cloudResult, pixelCoord, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(cloudDepth, pixelCoord, vec4(0.0));
		imageStore(cloudOpticalDepth, pixelCoord, vec4(0.0));
        return;
    }

    CloudLightingEnv lightingEnv = EvaluateCloudLightingEnv(rayDir);

    // 自适应步数：基于最大步长计算，使增大厚度时采样数同步增加，避免云体被稀释
    float tRange   = shell.tEnd - shell.tStart;
    int   marchSteps = clamp(int(ceil(tRange / MARCH_MAX_STEP_M)), MARCH_STEPS_MIN, MARCH_STEPS_MAX);
    float stepSize   = tRange / float(marchSteps);

	vec3 inscatter = vec3(0.0);
	vec3 opticalDepth = vec3(0.0);
	float cloudOnlyOpticalDepth = 0.0;
	float intervalStart = 0.0;
	float intervalEnd = 0.0;
	vec3 storedInscatter = vec3(0.0);
	vec3 storedOpticalDepth = vec3(0.0);
	float storedCloudOnlyOpticalDepth = 0.0;
	bool intervalStarted = false;
	bool terminatedByCloudOpacity = false;

    for (int i = 0; i < marchSteps; i++)
    {
        // 采样点（步进中点偏移，减少采样位置偏差）
        float t   = shell.tStart + (float(i) + 0.5) * stepSize;
        vec3  pos = rayOrigin + rayDir * t;

		CloudSampleProps cloudMedium = EvaluateCloudSampleProps(pos);
		// Empty samples before the first cloud cell and after the last cloud cell
		// are not part of the cloud replacement interval.  Integrating the whole
		// geometric shell as soon as one cloud sample existed made the result jump
		// from an empty interval to kilometres of separately sampled atmosphere at
		// the silhouette, which appeared as a cyan contour.
		bool cloudPresent = cloudMedium.sigmaTView * stepSize > 1.0e-5;
		if (!intervalStarted && !cloudPresent)
			continue;
		if (!intervalStarted)
		{
			intervalStarted = true;
			intervalStart = max(t - 0.5 * stepSize, shell.tStart);
		}
		vec3 positionRelativeToCamera = pos +
			uAtmosphereFrame.planetCenterRelativeToCameraMeters.xyz;
		float segmentStart = max(t - 0.5 * stepSize, shell.tStart);
		float segmentEnd = min(t + 0.5 * stepSize, shell.tEnd);
		// 云占用区间必须和同一区间内的物理大气、近地高度雾共同积分；
		// composite 随后只替换该区间，不能截断云后的介质。
		AtmosphereMedium atmosphereMedium = EvaluateNearMediaSegmentMedium(
			positionRelativeToCamera, rayDir, segmentStart, segmentEnd);
		float cloudSunOpticalDepth = 0.0;
		vec3 cloudSourceRadiance = EvaluateHPCloudSourceRadiance(
			pos, stepSize, lightingEnv, cloudMedium, cloudSunOpticalDepth);
		float cloudSunTransmittance =
			exp(-min(cloudSunOpticalDepth, 80.0));
		ParticipatingMediaSample medium = EmptyParticipatingMediaSample();
		AddParticipatingMediaSample(medium,
			EvaluateAtmosphereScatteringSourceWithPrimaryCloudTransmittance(
				positionRelativeToCamera, rayDir, atmosphereMedium,
				vec3(cloudSunTransmittance)),
			atmosphereMedium.extinction);
		if (cloudMedium.sigmaTView > 0.0)
		{
			AddParticipatingMediaSample(medium,
				cloudSourceRadiance * cloudMedium.sigmaTView,
				vec3(cloudMedium.sigmaTView));
		}
		float localNear = uLocalMedia.nearMediaDepthRangeAndGrid.x;
		float localFar = uLocalMedia.nearMediaDepthRangeAndGrid.y;
		float localViewDepth = NearMediaViewDepthFromRayDistance(rayDir, t);
		if (localViewDepth >= localNear && localViewDepth <= localFar)
		{
			vec4 localFroxel = SampleParticipatingMediaFroxel(
				localMediaInjection, uv, localViewDepth,
				vec4(0.0, 0.0, localNear, localFar),
				vec4(uLocalMedia.nearMediaDepthRangeAndGrid.zw,
					uLocalMedia.nearMediaSliceHistoryAndVolumeCount.x, 0.0));
			AddParticipatingMediaSample(medium,
				localFroxel.rgb, vec3(localFroxel.a));
		}
		IntegrateParticipatingMediaStep(medium, stepSize,
			inscatter, opticalDepth);
		cloudOnlyOpticalDepth += cloudMedium.sigmaTView * stepSize;

		// Snapshot only at a cloud-bearing sample.  Atmosphere inside gaps between
		// cloud cells remains correctly integrated, while atmosphere in a trailing
		// empty part of the shell is discarded by retaining the last snapshot.
		if (cloudPresent)
		{
			intervalEnd = min(t + 0.5 * stepSize, shell.tEnd);
			storedInscatter = inscatter;
			storedOpticalDepth = opticalDepth;
			storedCloudOnlyOpticalDepth = cloudOnlyOpticalDepth;
		}

		// 这里只能由云自身的不透明度触发提前终止。若省略后续云段，最终
		// 输出也必须把背景透射率闭合；否则 1% 的残留足以泄漏高动态范围
		// 的太阳附近 Mie 散射，并在低分辨率重建后形成亮带。
		float cloudTransmittance =
			exp(-min(cloudOnlyOpticalDepth, 80.0));
		if (cloudTransmittance < TRANSMIT_CUTOFF)
		{
			terminatedByCloudOpacity = true;
			break;
		}
    }

	if (!intervalStarted || intervalEnd <= intervalStart ||
		storedCloudOnlyOpticalDepth <= 0.0)
	{
		imageStore(cloudResult, pixelCoord, vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(cloudDepth, pixelCoord, vec4(0.0));
		imageStore(cloudOpticalDepth, pixelCoord, vec4(0.0));
		return;
	}
	if (terminatedByCloudOpacity)
	{
		float missingCloudOpticalDepth = max(
			OPAQUE_OPTICAL_DEPTH - storedCloudOnlyOpticalDepth, 0.0);
		storedOpticalDepth += vec3(missingCloudOpticalDepth);
		storedCloudOnlyOpticalDepth = max(
			storedCloudOnlyOpticalDepth, OPAQUE_OPTICAL_DEPTH);
	}
	vec3 transmittance = exp(-min(storedOpticalDepth, vec3(80.0)));
	imageStore(cloudResult, pixelCoord,
		vec4(storedInscatter, dot(transmittance, vec3(1.0 / 3.0))));
	imageStore(cloudDepth, pixelCoord, vec4(intervalStart, intervalEnd, 0.0, 0.0));
	// RGB 是物理大气 + Height Fog + Local Fog + Cloud 的联合区间。Alpha
	// is the cloud-only optical depth used as interval validity and for the
	// independently authored celestial-disk occlusion strength.
	imageStore(cloudOpticalDepth, pixelCoord,
		vec4(min(storedOpticalDepth, vec3(80.0)),
			min(storedCloudOnlyOpticalDepth, 80.0)));
}
