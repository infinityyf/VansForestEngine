#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/CameraData.glsl"
#include "../Common/Common.glsl"
#include "../Lights/LightsData.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D normalInput;
layout(set = 1, binding = 1) uniform sampler2D gbuffer2Input;
layout(set = 1, binding = 2) uniform sampler2D hizDepth;
layout(set = 1, binding = 3, r16f) uniform image2D outShadow;

layout(std140, set = 1, binding = 4) uniform ScreenSpaceShadowParamsUBO
{
    vec4 screenSize;
    vec4 punctualRayParams;
    vec4 directionalRayParams;
    vec4 fadeParams;
} uSSS;

layout(set = 1, binding = 5) uniform sampler2DArray cascadeDepth;
layout(set = 1, binding = 6) uniform sampler2DArrayShadow cascadeCompare;
// Four cascades are packed horizontally. Mip zero stores min/max for each
// 4x4 D32 block; every following mip conservatively reduces another 2x2.
layout(set = 1, binding = 7) uniform sampler2D cascadeMinMax;

vec2 QueryCascadeMinMax(vec2 uv, int cascadeIdx, float radiusTexels, ivec2 shadowSize)
{
	int generatedLodCount = 1 + int(floor(log2(float(max(min(shadowSize.x, shadowSize.y) / 4, 1)))));
	int maxLod = min(max(textureQueryLevels(cascadeMinMax) - 1, 0), generatedLodCount - 1);
    float footprintDiameter = max(radiusTexels * 2.0, 2.0);
	int lod = clamp(int(ceil(log2(footprintDiameter * 0.25))), 0, maxLod);
    ivec2 atlasSize = textureSize(cascadeMinMax, lod);
    ivec2 tileSize = ivec2(atlasSize.x / CASCADE_COUNT, atlasSize.y);

    vec2 uvRadius = vec2(radiusTexels) / vec2(shadowSize);
    ivec2 rangeMin = clamp(ivec2(floor(clamp(uv - uvRadius, vec2(0.0), vec2(1.0)) * vec2(tileSize))),
                               ivec2(0), tileSize - ivec2(1));
    ivec2 rangeMax = clamp(ivec2(floor(clamp(uv + uvRadius, vec2(0.0), vec2(1.0)) * vec2(tileSize))),
                               ivec2(0), tileSize - ivec2(1));

    vec2 depthRange = vec2(1.0, 0.0);
    for (int y = 0; y < 3; ++y)
    for (int x = 0; x < 3; ++x)
    {
        ivec2 local = rangeMin + ivec2(x, y);
        if (any(greaterThan(local, rangeMax)))
            continue;
        ivec2 atlasPixel = local + ivec2(cascadeIdx * tileSize.x, 0);
        vec2 sampleRange = texelFetch(cascadeMinMax, atlasPixel, lod).rg;
        depthRange.x = min(depthRange.x, sampleRange.x);
        depthRange.y = max(depthRange.y, sampleRange.y);
    }
    return depthRange;
}

float SampleResolvedCascadeMap(
    vec3 positionWS, vec3 normalWS, int cascadeIdx, out float projectionValid)
{
    CascadeProjection p = ProjectCascade(positionWS, cascadeIdx);
    projectionValid = p.valid;
    if (p.valid <= 0.0)
        return 1.0;

    ivec2 size = textureSize(cascadeDepth, 0).xy;
    float receiverDepth = p.depth - ComputeCascadeReceiverBias(normalWS, cascadeIdx);
    float maxRadiusTexels = max(uDirectionLight.cascadeFilterRadius[cascadeIdx], 2.0);
    float depthRange = 1.0 / max(uDirectionLight.cascadeDepthScale[cascadeIdx], 1e-6);
    float worldUnitsPerTexel = max(uDirectionLight.cascadeTexelSize[cascadeIdx], 1e-6);
    float tanAngularRadius = tan(CascadeSunAngularRadius());
    float receiverDistanceFromNear = max(p.depth, 0.0) * depthRange;
    float searchRadiusTexels = clamp(
        receiverDistanceFromNear * tanAngularRadius / worldUnitsPerTexel,
        2.0, maxRadiusTexels);

    projectionValid *= CascadeFootprintConfidence(p.uv, size, searchRadiusTexels);
    if (projectionValid <= 0.0)
        return 1.0;

    // The queried footprint includes the maximum possible PCSS kernel plus a
    // comparison-filter texel. Uniform min/max means no blocker/PCF samples are
    // required and the classification is conservative.
    vec2 classifiedRange = QueryCascadeMinMax(
        p.uv, cascadeIdx, maxRadiusTexels + 1.0, size);
    if (receiverDepth <= classifiedRange.x)
        return 1.0;
    if (receiverDepth > classifiedRange.y)
        return 0.0;

    float blockerCount = 0.0;
    float averageBlockerDepth = FindCascadeAverageBlockerDepth(
        cascadeDepth, p, cascadeIdx, receiverDepth, searchRadiusTexels, blockerCount);
    if (blockerCount <= 0.0)
        return 1.0;

    float blockerSeparationWorld = max(p.depth - averageBlockerDepth, 0.0) * depthRange;
    float filterRadiusTexels = clamp(
        blockerSeparationWorld * tanAngularRadius / worldUnitsPerTexel,
        0.75, maxRadiusTexels);
    projectionValid *= CascadeFootprintConfidence(p.uv, size, filterRadiusTexels);
    return FilterCascadePCFComparison(
        cascadeCompare, p, cascadeIdx, receiverDepth, filterRadiusTexels, size);
}

float ResolveCascadeShadow(vec3 positionWS, vec3 normalWS, float viewDepth)
{
    int cascadeIdx = SelectCascade(viewDepth);
    float currentValid = 0.0;
    float shadow = SampleResolvedCascadeMap(positionWS, normalWS, cascadeIdx, currentValid);
    float lastSplit = uDirectionLight.cascadeSplits[CASCADE_COUNT - 1];
    float lastCascadeFade = 1.0 - smoothstep(lastSplit * 0.85, lastSplit, viewDepth);

    if (currentValid <= 0.0)
    {
        int farCascade = cascadeIdx + 1;
        if (farCascade < CASCADE_COUNT)
        {
            float valid = 0.0;
            float fallbackShadow = SampleResolvedCascadeMap(positionWS, normalWS, farCascade, valid);
            if (valid > 0.0)
                return mix(1.0, fallbackShadow, lastCascadeFade);
        }
        int nearCascade = cascadeIdx - 1;
        if (nearCascade >= 0)
        {
            float valid = 0.0;
            float fallbackShadow = SampleResolvedCascadeMap(positionWS, normalWS, nearCascade, valid);
            if (valid > 0.0)
                return mix(1.0, fallbackShadow, lastCascadeFade);
        }
        return 1.0;
    }

    if (currentValid < 0.95)
    {
        int fallbackCascade = cascadeIdx < CASCADE_COUNT - 1 ? cascadeIdx + 1 : cascadeIdx - 1;
        if (fallbackCascade >= 0 && fallbackCascade < CASCADE_COUNT)
        {
            float valid = 0.0;
            float fallbackShadow = SampleResolvedCascadeMap(positionWS, normalWS, fallbackCascade, valid);
            if (valid > currentValid)
            {
                shadow = mix(fallbackShadow, shadow, currentValid);
                currentValid = valid;
            }
        }
    }

    if (cascadeIdx > 0)
    {
        float prevSplit = uDirectionLight.cascadeSplits[cascadeIdx - 1];
        float currentSplit = uDirectionLight.cascadeSplits[cascadeIdx];
        float prevPrevSplit = cascadeIdx > 1 ? uDirectionLight.cascadeSplits[cascadeIdx - 2] : 0.0;
        float cascadeSpan = max(currentSplit - prevPrevSplit, 1.0);
        float band = clamp(cascadeSpan * 0.08, 1.0, 25.0);
        float blendFromPrev = 1.0 - smoothstep(prevSplit - band, prevSplit + band, viewDepth);
        if (blendFromPrev > 0.0)
        {
            float prevValid = 0.0;
            float prevShadow = SampleResolvedCascadeMap(positionWS, normalWS, cascadeIdx - 1, prevValid);
            if (prevValid > 0.0)
                shadow = mix(shadow, prevShadow, blendFromPrev);
        }
    }
    if (cascadeIdx < CASCADE_COUNT - 1)
    {
        float blendFactor = ComputeCascadeBlendFactor(viewDepth, cascadeIdx);
        if (blendFactor > 0.0)
        {
            float nextValid = 0.0;
            float nextShadow = SampleResolvedCascadeMap(positionWS, normalWS, cascadeIdx + 1, nextValid);
            if (nextValid > 0.0)
                shadow = mix(shadow, nextShadow, blendFactor);
        }
    }
    return mix(1.0, shadow, lastCascadeFade);
}

float EdgeFade(vec2 uv)
{
    vec2 p = uv * uSSS.screenSize.xy;
    vec2 d = min(p, uSSS.screenSize.xy - p);
    return clamp(min(d.x, d.y) / max(uSSS.fadeParams.x, 1.0), 0.0, 1.0);
}

float TraceDirectionalScreenShadow(vec3 originWS, vec3 normalWS, float receiverDepth)
{
    vec3 lightDirWS = normalize(uDirectionLight.direction.xyz);
    float ndotl = dot(normalWS, lightDirWS);
    float normalFade = smoothstep(-0.08, 0.18, ndotl);

    float maxDistance = uSSS.directionalRayParams.x;
    float thickness = uSSS.directionalRayParams.y;
    float normalBias = uSSS.directionalRayParams.z;
    int maxSteps = max(int(uSSS.directionalRayParams.w), 1);

    vec3 rayOrigin = originWS + normalWS * normalBias;
    vec3 rayEnd = rayOrigin + lightDirWS * maxDistance;
    vec3 startSS;
    vec3 endSS;
    if (!HiZ_ProjectToScreenChecked(ViewMatrix, ProjectionMatrix, rayOrigin, startSS))
    {
        return 1.0;
    }
    vec2 startUV = startSS.xy;

    if (any(lessThan(startUV, vec2(0.0))) || any(greaterThan(startUV, vec2(1.0))))
        return 1.0;

    bool hasEndProjection = HiZ_ProjectToScreenChecked(ViewMatrix, ProjectionMatrix, rayEnd, endSS);
    float pixelSpan = hasEndProjection ? length((endSS.xy - startUV) * uSSS.screenSize.xy) : float(maxSteps);
    int steps = clamp(int(pixelSpan * 0.75), 6, maxSteps);

    float shadow = 1.0;
    float minTravel = max(normalBias * 1.5, 0.02);
    // This pass has no dedicated temporal accumulation.  A frame-varying seed
    // turns the ray-march error into visible shimmer at the CSM edge, so use a
    // stable spatial seed instead.
    float jitter = RandomInterLeaved(startUV * uSSS.screenSize.xy);
    for (int i = 1; i <= steps; ++i)
    {
        float t = (float(i) + jitter) / float(steps);
        t = clamp(t, 0.0, 1.0);
        float travel = t * maxDistance;

        vec3 rayWS = mix(rayOrigin, rayEnd, t);
        vec3 raySS;
        if (!HiZ_ProjectToScreenChecked(ViewMatrix, ProjectionMatrix, rayWS, raySS))
            break;

        vec2 uv = raySS.xy;
        if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
            break;

        float rayDepth = raySS.z;
        if (travel < minTravel)
            continue;

        ivec2 hizSize = textureSize(hizDepth, 0);
        ivec2 hizTexel = clamp(ivec2(uv * vec2(hizSize)), ivec2(0), hizSize - ivec2(1));
        float sceneDepth = texelFetch(hizDepth, hizTexel, 0).r;
        if (sceneDepth <= 0.0 || sceneDepth >= 99999.0)
            continue;

        float dz = rayDepth - sceneDepth;
        float depthBias = max(0.004, normalBias * 0.2);
        float localThickness = thickness * (1.0 + rayDepth * 0.01) * mix(1.0, 1.8, t);
        float receiverSeparation = abs(sceneDepth - receiverDepth);
        bool hit = dz > depthBias && dz < localThickness && receiverSeparation > normalBias * 0.2;
        if (hit)
        {
            float hitWeight = 1.0 - smoothstep(depthBias, localThickness, dz);
            float distanceFade = 1.0 - smoothstep(0.65, 1.0, t);
            shadow = min(shadow, 1.0 - hitWeight * distanceFade);
            break;
        }
    }

    float fade = EdgeFade(startUV);
    fade *= 1.0 - smoothstep(uSSS.fadeParams.y * 0.8, uSSS.fadeParams.y, receiverDepth);
    float strength = clamp(uSSS.fadeParams.z, 0.0, 1.0);
    return mix(1.0, shadow, fade * strength * normalFade);
}

void main()
{
    ivec2 outSize = imageSize(outShadow);
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pix, outSize)))
        return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(outSize);
    vec4 posData = texture(gbuffer2Input, uv);
    float receiverDepth = posData.w;
    if (receiverDepth <= 0.0)
    {
        imageStore(outShadow, pix, vec4(1.0));
        return;
    }

    vec3 normalWS = texture(normalInput, uv).xyz;
    if (length(normalWS) < 0.5)
    {
        imageStore(outShadow, pix, vec4(1.0));
        return;
    }
    normalWS = normalize(normalWS);

	float cascadeVisibility = ResolveCascadeShadow(posData.xyz, normalWS, receiverDepth);
    float screenVisibility = TraceDirectionalScreenShadow(posData.xyz, normalWS, receiverDepth);
	imageStore(outShadow, pix, vec4(min(cascadeVisibility, screenVisibility), 0.0, 0.0, 0.0));
}
