#version 450
#extension GL_GOOGLE_include_directive : require
#include "../Common/Common.glsl"
#include "../Common/CameraData.glsl"
#include "../Common/SSRRay.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout( set = 1, binding = 0 ) uniform sampler2D inputNormal;
layout( set = 1, binding = 1 ) uniform sampler2D inputRoughness;
layout( set = 1, binding = 2 ) uniform sampler2D inputPosition;
layout( set = 1, binding = 3 ) uniform sampler2D inputHIZ;
layout( set = 1, binding = 4, rgba32f ) uniform image2D traceHit;
layout( set = 1, binding = 5, r32f ) uniform image2D tracePDF;

layout(set = 1, binding = 6, std430) readonly buffer SSRTileListBuffer
{
    uint tileList[];
};

layout(set = 1, binding = 7, std430) readonly buffer SSRTraceControlBuffer
{
    uint rayCount;
    uint dispatchX;
    uint dispatchY;
    uint dispatchZ;
};

void main() 
{
    ivec2 screenSize = ivec2(ScreenParams.xy);

    uint compactTileIndex = gl_WorkGroupID.x;
    if (compactTileIndex >= rayCount)
        return;

    uint tileGridWidth = (uint(screenSize.x) + 7u) / 8u;
    uint recordOffset = compactTileIndex * SSR_TILE_RECORD_WORDS;
    uint linearTile = tileList[recordOffset];
    uint lane = gl_LocalInvocationIndex;
    uint activeMask = tileList[recordOffset + (lane < 32u ? 1u : 2u)];
    // Classification has already initialized rejected pixels (including edge
    // lanes and back-facing rays). Only active lanes need GBuffer/Hi-Z work.
    if ((activeMask & (1u << (lane & 31u))) == 0u)
        return;
    ivec2 tileCoord = ivec2(
        int(linearTile % tileGridWidth),
        int(linearTile / tileGridWidth));
    ivec2 pixelCoord = tileCoord * 8 + ivec2(gl_LocalInvocationID.xy);

    vec3 normal = texelFetch(inputNormal, pixelCoord, 0).xyz;
    vec3 position = texelFetch(inputPosition, pixelCoord, 0).xyz;
    float roughness = texelFetch(inputRoughness, pixelCoord, 0).a;

    vec4 traceHitInfo = vec4(0.0);
    float tracePDFValue;

    vec3 traceDirection;
    SSRPrepareRay(pixelCoord, normal, position, roughness,
                  traceDirection, tracePDFValue);

    // ─── HiZ 加速屏幕空间追踪 ───
    // 使用 TraceHiZ_UV，HIZ 存储线性深度（单位米），与射线线性深度直接比较
    // thicknessThreshold 为线性深度厚度阈值（米），决定视为透明穿透还是实体命中
    vec3 rayOrigin = position + normal * SSR_START_BIAS;

    // SSR HIZ 和 GBuffer 均来自当前帧，追踪投影也必须使用当前帧矩阵。
    // 只有 resolve 阶段采样上一帧 scene color 时才做 hit position → last-frame UV 重投影。
    HiZTraceResult traceResult = TraceHiZ_UV(
        inputHIZ,
        ViewMatrix,
        ProjectionMatrix,
        rayOrigin,
        traceDirection,
        FarPlane, // maxDistWorld: 尽量追踪到远裁剪面 / 屏幕边缘，避免固定距离导致远景反射范围缩小
        1.0,     // traceStride: 初始步长（像素）
        1.0      // thicknessThreshold: 1.0m 厚度阈值（线性深度）
    );

    if (traceResult.hit)
    {
        traceHitInfo     = vec4(traceResult.uv, traceResult.depth, 1.0);
    }
    else
    {
        // Sky misses are resolved by deferred IBL, not by the SSR resolve pass.
        traceHitInfo.w = 0.5;
    }

    imageStore(traceHit, pixelCoord, traceHitInfo);
    imageStore(tracePDF, pixelCoord, vec4(tracePDFValue, 0.0, 0.0, 0.0));
}
