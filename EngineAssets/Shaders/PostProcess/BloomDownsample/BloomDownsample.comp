#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../Common/Common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D srcColor;
layout(set = 1, binding = 1, rgba16f) uniform image2D dstColor;

vec3 SampleClamped(sampler2D sourceTexture, vec2 uv, vec2 texel)
{
    vec2 clampedUV = clamp(uv, texel * 0.5, vec2(1.0) - texel * 0.5);
    return texture(sourceTexture, clampedUV).rgb;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(dstColor);

    if (coord.x >= outSize.x || coord.y >= outSize.y)
        return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(outSize);
    vec2 texel = 1.0 / vec2(textureSize(srcColor, 0));

    vec3 a = SampleClamped(srcColor, uv + texel * vec2(-1.0, -1.0), texel);
    vec3 b = SampleClamped(srcColor, uv + texel * vec2( 0.0, -1.0), texel);
    vec3 c = SampleClamped(srcColor, uv + texel * vec2( 1.0, -1.0), texel);
    vec3 d = SampleClamped(srcColor, uv + texel * vec2(-0.5, -0.5), texel);
    vec3 e = SampleClamped(srcColor, uv + texel * vec2( 0.5, -0.5), texel);
    vec3 f = SampleClamped(srcColor, uv + texel * vec2(-1.0,  0.0), texel);
    vec3 g = SampleClamped(srcColor, uv, texel);
    vec3 h = SampleClamped(srcColor, uv + texel * vec2( 1.0,  0.0), texel);
    vec3 i = SampleClamped(srcColor, uv + texel * vec2(-0.5,  0.5), texel);
    vec3 j = SampleClamped(srcColor, uv + texel * vec2( 0.5,  0.5), texel);
    vec3 k = SampleClamped(srcColor, uv + texel * vec2(-1.0,  1.0), texel);
    vec3 l = SampleClamped(srcColor, uv + texel * vec2( 0.0,  1.0), texel);
    vec3 m = SampleClamped(srcColor, uv + texel * vec2( 1.0,  1.0), texel);

    vec3 result = (d + e + i + j) * 0.5
                + (a + b + g + f) * 0.125
                + (b + c + g + h) * 0.125
                + (f + g + k + l) * 0.125
                + (g + h + l + m) * 0.125;
    result *= 0.25;

    if (any(isnan(result)) || any(isinf(result)))
        result = vec3(0.0);

    imageStore(dstColor, coord, vec4(max(result, vec3(0.0)), 1.0));
}
