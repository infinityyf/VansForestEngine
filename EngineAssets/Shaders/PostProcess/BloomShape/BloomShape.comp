#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../Common/Common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D srcBloom;
layout(set = 1, binding = 1, rgba16f) uniform image2D dstBloom;
layout(set = 1, binding = 2) uniform BloomShapeParams
{
    int   mode;
    float shapeIntensity;
    float shapeBlend;
    float shapeAngleRadians;

    float anamorphicStretch;
    float streakLength;
    float streakAttenuation;
    int   streakCount;
} uShape;

vec3 SafeColor(vec3 color)
{
    if (any(isnan(color)) || any(isinf(color)))
        return vec3(0.0);
    return max(color, vec3(0.0));
}

vec2 DirectionFromAngle(float angle)
{
    return vec2(cos(angle), sin(angle));
}

vec3 SampleBloom(vec2 uv, vec2 texel)
{
    vec2 clampedUV = clamp(uv, texel * 0.5, vec2(1.0) - texel * 0.5);
    return SafeColor(texture(srcBloom, clampedUV).rgb);
}

vec3 DirectionalStreak(vec2 uv, vec2 texel, vec2 dir, float lengthPixels, float attenuation)
{
    const int tapCount = 8;
    float totalWeight = 1.0;
    float weight = 1.0;
    vec3 sum = SampleBloom(uv, texel);

    float stepPixels = clamp(lengthPixels, 0.0, 128.0) / float(tapCount);
    float falloff = clamp(attenuation, 0.0, 0.98);
    for (int i = 1; i <= tapCount; ++i)
    {
        weight *= falloff;
        vec2 offset = dir * texel * (stepPixels * float(i));
        sum += SampleBloom(uv + offset, texel) * weight;
        sum += SampleBloom(uv - offset, texel) * weight;
        totalWeight += weight * 2.0;
    }

    return sum / max(totalWeight, 1.0e-5);
}

vec3 AnamorphicBloom(vec2 uv, vec2 texel)
{
    vec2 dir = DirectionFromAngle(uShape.shapeAngleRadians);
    float lengthPixels = clamp(
        max(uShape.streakLength, 1.0) * (1.0 + max(uShape.anamorphicStretch, 0.0)),
        0.0,
        128.0);
    return DirectionalStreak(uv, texel, dir, lengthPixels, uShape.streakAttenuation);
}

vec3 StarBloom(vec2 uv, vec2 texel)
{
    int arms = clamp(uShape.streakCount, 2, 8);
    float angleStep = 3.14159265358979323846 / float(arms);
    vec3 sum = vec3(0.0);
    float total = 0.0;

    for (int i = 0; i < 8; ++i)
    {
        if (i >= arms)
            break;
        vec2 dir = DirectionFromAngle(uShape.shapeAngleRadians + angleStep * float(i));
        float armWeight = 1.0 / (1.0 + float(i) * 0.08);
        sum += DirectionalStreak(uv, texel, dir, max(uShape.streakLength, 0.0), uShape.streakAttenuation) * armWeight;
        total += armWeight;
    }

    return sum / max(total, 1.0e-5);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(dstBloom);
    if (coord.x >= outSize.x || coord.y >= outSize.y)
        return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(outSize);
    vec2 texel = 1.0 / vec2(textureSize(srcBloom, 0));
    vec3 base = SampleBloom(uv, texel);

    vec3 shaped = base;
    if (uShape.mode == 1)
        shaped = AnamorphicBloom(uv, texel);
    else if (uShape.mode == 2)
        shaped = StarBloom(uv, texel);

    float amount = clamp(uShape.shapeIntensity, 0.0, 4.0);
    vec3 boosted = base + max(shaped - base, vec3(0.0)) * amount;
    vec3 result = mix(base, boosted, clamp(uShape.shapeBlend, 0.0, 1.0));
    imageStore(dstBloom, coord, vec4(SafeColor(result), 1.0));
}
