#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../Common/Common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D srcLo;
layout(set = 1, binding = 1) uniform sampler2D srcHi;
layout(set = 1, binding = 2, rgba16f) uniform image2D dstColor;
layout(set = 1, binding = 3) uniform BloomParams
{
    float threshold;
    float knee;
    float scatter;
    float _pad0;

    float clampValue;
    float tintR;
    float tintG;
    float tintB;
} uBloom;

vec3 SampleClamped(sampler2D sourceTexture, vec2 uv, vec2 texel)
{
    vec2 clampedUV = clamp(uv, texel * 0.5, vec2(1.0) - texel * 0.5);
    return texture(sourceTexture, clampedUV).rgb;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(dstColor);
    if (coord.x >= outSize.x || coord.y >= outSize.y)
        return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(outSize);
    vec2 loTexel = 1.0 / vec2(textureSize(srcLo, 0));
    vec2 hiTexel = 1.0 / vec2(textureSize(srcHi, 0));

    vec3 lo = vec3(0.0);
    lo += SampleClamped(srcLo, uv + loTexel * vec2(-1.0, -1.0), loTexel) * (1.0 / 16.0);
    lo += SampleClamped(srcLo, uv + loTexel * vec2( 0.0, -1.0), loTexel) * (2.0 / 16.0);
    lo += SampleClamped(srcLo, uv + loTexel * vec2( 1.0, -1.0), loTexel) * (1.0 / 16.0);
    lo += SampleClamped(srcLo, uv + loTexel * vec2(-1.0,  0.0), loTexel) * (2.0 / 16.0);
    lo += SampleClamped(srcLo, uv, loTexel) * (4.0 / 16.0);
    lo += SampleClamped(srcLo, uv + loTexel * vec2( 1.0,  0.0), loTexel) * (2.0 / 16.0);
    lo += SampleClamped(srcLo, uv + loTexel * vec2(-1.0,  1.0), loTexel) * (1.0 / 16.0);
    lo += SampleClamped(srcLo, uv + loTexel * vec2( 0.0,  1.0), loTexel) * (2.0 / 16.0);
    lo += SampleClamped(srcLo, uv + loTexel * vec2( 1.0,  1.0), loTexel) * (1.0 / 16.0);

    vec3 hi = SampleClamped(srcHi, uv, hiTexel);
    vec3 result = mix(hi, hi + lo, clamp(uBloom.scatter, 0.0, 1.0));

    if (any(isnan(result)) || any(isinf(result)))
        result = vec3(0.0);

    imageStore(dstColor, coord, vec4(max(result, vec3(0.0)), 1.0));
}
