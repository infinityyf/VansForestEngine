#version 450

// Reduces the logarithmic luminance buffer and advances the persistent EV state.
// The state image remains in GENERAL layout because it is both read and written here
// and sampled by the final composite pass.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D lumIn;
layout(set = 1, binding = 1, r16f) uniform image2D exposureState;
layout(set = 1, binding = 3, r32f) uniform image2D fsrExposureMultiplier;
layout(set = 1, binding = 2) uniform ExposureAdaptParams
{
    float minEV;
    float maxEV;
    float adaptSpeedUp;
    float adaptSpeedDown;
    float deltaTime;
    float exposureCompensation;
    int   enableAutoExposure;
    float _pad1;
} uAdapt;

void main()
{
    if (uAdapt.enableAutoExposure == 0)
    {
        imageStore(exposureState, ivec2(0), vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(fsrExposureMultiplier, ivec2(0),
			vec4(exp2(uAdapt.exposureCompensation), 0.0, 0.0, 1.0));
        return;
    }

    ivec2 luminanceSize = textureSize(lumIn, 0);
    float logLuminanceSum = 0.0;
    int validSampleCount = 0;
    for (int y = 0; y < luminanceSize.y; ++y)
    {
        for (int x = 0; x < luminanceSize.x; ++x)
        {
            float sampleValue = texelFetch(lumIn, ivec2(x, y), 0).r;
            if (!isnan(sampleValue) && !isinf(sampleValue))
            {
                logLuminanceSum += sampleValue;
                ++validSampleCount;
            }
        }
    }

    float averageLuminance = 0.18;
    if (validSampleCount > 0)
        averageLuminance = exp(logLuminanceSum / float(validSampleCount));

    // The final composite multiplies HDR by exp2(EV), so the middle-grey target
    // is key / measured luminance (not measured luminance / key).
    float targetEV = log2(0.18 / max(averageLuminance, 1e-6));
    targetEV = clamp(targetEV, uAdapt.minEV, uAdapt.maxEV);

    float currentEV = imageLoad(exposureState, ivec2(0)).r;
    if (isnan(currentEV) || isinf(currentEV)
        || currentEV < uAdapt.minEV || currentEV > uAdapt.maxEV)
    {
        currentEV = 0.0;
    }

    float speed = targetEV > currentEV ? uAdapt.adaptSpeedUp : uAdapt.adaptSpeedDown;
    float blend = 1.0 - exp(-max(speed, 0.0) * clamp(uAdapt.deltaTime, 0.0, 0.25));
    float nextEV = mix(currentEV, targetEV, clamp(blend, 0.0, 1.0));
    imageStore(exposureState, ivec2(0), vec4(nextEV, 0.0, 0.0, 1.0));
	imageStore(fsrExposureMultiplier, ivec2(0),
		vec4(exp2(nextEV + uAdapt.exposureCompensation), 0.0, 0.0, 1.0));
}
