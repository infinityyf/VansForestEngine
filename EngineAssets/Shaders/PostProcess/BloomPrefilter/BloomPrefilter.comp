#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../Common/Common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D srcColor;
layout(set = 1, binding = 1, rgba16f) uniform image2D dstColor;
layout(set = 1, binding = 2) uniform BloomParams
{
    float threshold;
    float knee;
    float scatter;
    float _pad0;

    float clampValue;
    float tintR;
    float tintG;
    float tintB;
} uBloom;

vec3 SanitizeHDR(vec3 color)
{
    if (any(isnan(color)) || any(isinf(color)))
        return vec3(0.0);
    return max(color, vec3(0.0));
}

vec3 QuadraticThreshold(vec3 color, float threshold, float knee)
{
    float lum = Luminance(color);
    float softKnee = max(knee, 1.0e-4);
    float rq = clamp(lum - threshold + softKnee, 0.0, 2.0 * softKnee);
    rq = (rq * rq) / (4.0 * softKnee);
    float weight = max(rq, lum - threshold) / max(lum, 1.0e-6);
    return color * clamp(weight, 0.0, 1.0);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(dstColor);
    if (coord.x >= outSize.x || coord.y >= outSize.y)
        return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(outSize);
    vec3 hdr = SanitizeHDR(texture(srcColor, uv).rgb);
    hdr = min(hdr, vec3(max(uBloom.clampValue, 0.0)));

    vec3 bloom = QuadraticThreshold(hdr, max(uBloom.threshold, 0.0), clamp(uBloom.knee, 0.0, 1.0));
    bloom *= vec3(max(uBloom.tintR, 0.0), max(uBloom.tintG, 0.0), max(uBloom.tintB, 0.0));

    imageStore(dstColor, coord, vec4(bloom, 1.0));
}
