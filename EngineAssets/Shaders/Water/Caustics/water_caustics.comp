#version 450
#extension GL_GOOGLE_include_directive : require

#include "../water_screen_common.glsl"

// Stable forward screen-space caustics.  The local water-surface ray bundle
// is refracted along the sun direction and projected by the current thickness.
// It does not search a view-refracted receiver, so camera motion cannot switch
// between discrete receiver candidates.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D waterGBufNormal;
layout(set = 0, binding = 1) uniform sampler2D waterGBufPosDepth;
layout(set = 0, binding = 2) uniform sampler2D thicknessMap;

layout(set = 0, binding = 3) uniform WaterCausticsParams
{
    vec4  sunDirection;
    vec4  mainLightColor;
    vec4  extinctionCoeff;
    float causticsIntensity;
    float causticsScale;
    float shoreFadeStart;
    float maxDepth;
    vec4  opticalParams;
} params;

layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D causticsOut;

bool LoadPosition(ivec2 pixel, ivec2 size, out vec3 position)
{
    if (any(lessThan(pixel, ivec2(0))) || any(greaterThanEqual(pixel, size)))
        return false;
    vec4 nc = texelFetch(waterGBufNormal, pixel, 0);
    vec4 pd = texelFetch(waterGBufPosDepth, pixel, 0);
    if (!WaterSurfaceValid(nc, pd))
        return false;
    position = pd.xyz;
    return true;
}

bool LoadSurface(ivec2 pixel, ivec2 size,
                 out vec3 position, out vec3 normal,
                 out float normalizedThickness)
{
    if (any(lessThan(pixel, ivec2(0))) || any(greaterThanEqual(pixel, size)))
        return false;
    vec4 nc = texelFetch(waterGBufNormal, pixel, 0);
    vec4 pd = texelFetch(waterGBufPosDepth, pixel, 0);
    if (!WaterSurfaceValid(nc, pd))
        return false;

    position = pd.xyz;
    normalizedThickness = clamp(texelFetch(thicknessMap, pixel, 0).r, 0.0, 1.0);

    // Ray-bundle differentials use a geometric normal reconstructed from the
    // water positions, excluding high-frequency BRDF/refraction micro slopes.
    vec3 leftP, rightP, upP, downP;
    if (LoadPosition(pixel + ivec2(-1, 0), size, leftP) &&
        LoadPosition(pixel + ivec2( 1, 0), size, rightP) &&
        LoadPosition(pixel + ivec2( 0,-1), size, upP) &&
        LoadPosition(pixel + ivec2( 0, 1), size, downP))
    {
        vec3 geometric = cross(downP - upP, rightP - leftP);
        if (dot(geometric, geometric) > 1e-10)
        {
            normal = normalize(geometric);
            if (normal.y < 0.0)
                normal = -normal;
            return true;
        }
    }

    normal = normalize(nc.xyz);
    return true;
}

vec3 SunRayInWater(vec3 normal)
{
    vec3 ray = refract(-normalize(params.sunDirection.xyz), normal,
                       1.0 / max(params.opticalParams.x, 1.0001));
    if (dot(ray, ray) < 1e-8)
        ray = -normalize(params.sunDirection.xyz);
    return normalize(ray);
}

vec2 ReceiverXZ(vec3 waterPosition, vec3 normal, float opticalDepth)
{
    vec3 ray = SunRayInWater(normal);
    float travel = opticalDepth / max(-ray.y, 0.08);
    return waterPosition.xz + ray.xz * travel;
}

float Cross2D(vec2 a, vec2 b)
{
    return a.x * b.y - a.y * b.x;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(causticsOut);
    if (any(greaterThanEqual(pixel, size)))
        return;

    vec3 W, N;
    float thickness;
    if (params.causticsIntensity <= 0.0 ||
        !LoadSurface(pixel, size, W, N, thickness))
    {
        imageStore(causticsOut, pixel, vec4(0.0));
        return;
    }

    vec3 Wx, Nx, Wy, Ny;
    float thicknessX, thicknessY;
    if (!LoadSurface(pixel + ivec2(1, 0), size, Wx, Nx, thicknessX) ||
        !LoadSurface(pixel + ivec2(0, 1), size, Wy, Ny, thicknessY))
    {
        imageStore(causticsOut, pixel, vec4(0.0));
        return;
    }

    float depth = thickness * params.maxDepth;
    float depthX = thicknessX * params.maxDepth;
    float depthY = thicknessY * params.maxDepth;
    vec2 Q = ReceiverXZ(W, N, depth);
    vec2 Qx = ReceiverXZ(Wx, Nx, depthX);
    vec2 Qy = ReceiverXZ(Wy, Ny, depthY);

    vec2 sourceX = Wx.xz - W.xz;
    vec2 sourceY = Wy.xz - W.xz;
    float sourceArea = abs(Cross2D(sourceX, sourceY));
    float receiverArea = abs(Cross2D(Qx - Q, Qy - Q));
    if (sourceArea < 1e-8)
    {
        imageStore(causticsOut, pixel, vec4(0.0));
        return;
    }

    float concentration = sourceArea / max(receiverArea, sourceArea * 0.15);
    float focusing = clamp((concentration - 1.0) * params.causticsScale, 0.0, 1.5);
    float shoreFade = smoothstep(params.shoreFadeStart,
                                 params.shoreFadeStart * 8.0, thickness);
    float deepFade = 1.0 - smoothstep(0.65, 1.0, thickness);
    float incidence = max(dot(N, normalize(params.sunDirection.xyz)), 0.0);
    vec3 attenuation = exp(-max(params.extinctionCoeff.rgb, vec3(0.0)) * depth);

    float gain = clamp(focusing * shoreFade * deepFade * incidence
        * params.causticsIntensity, 0.0, 1.0);
    vec3 coloredGain = params.mainLightColor.rgb * params.mainLightColor.a
        * attenuation * gain;
    imageStore(causticsOut, pixel, vec4(coloredGain, gain));
}
