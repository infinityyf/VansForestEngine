#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform FFTParams
{
    vec4 windDirection_Time;
    vec4 spectrumParams;
    vec4 dampingParams;
    vec4 spectrumMeta;
    vec4 domainCoverage;
    vec4 minWavelength;
    vec4 maxWavelength;
    vec4 spectralOptions;
} params;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2DArray h0Spectrum;

const float PI = 3.14159265358979323846;
const float G = 9.81;

uint Hash(uint v)
{
    v = v * 747796405u + 2891336453u;
    uint shift = (v >> 28u) + 4u;
    v = ((v >> shift) ^ v) * 277803737u;
    return (v >> 22u) ^ v;
}

vec2 Gaussian(uint seed)
{
    float u1 = max(float(Hash(seed)) / 4294967295.0, 1e-7);
    float u2 = float(Hash(seed ^ 0x9e3779b9u)) / 4294967295.0;
    float radius = sqrt(-2.0 * log(u1));
    return radius * vec2(cos(2.0 * PI * u2), sin(2.0 * PI * u2));
}

float BandWindow(float wavelength, float lower, float upper)
{
    float feather = 0.12;
    float low = smoothstep(lower * (1.0 - feather), lower * (1.0 + feather), wavelength);
    float high = 1.0 - smoothstep(upper * (1.0 - feather), upper * (1.0 + feather), wavelength);
    return clamp(low * high, 0.0, 1.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    int cascade = int(gl_WorkGroupID.z);
    int N = int(params.spectrumMeta.y + 0.5);
    int cascadeCount = int(params.spectrumMeta.z + 0.5);
    if (any(greaterThanEqual(pixel, ivec2(N))) || cascade >= cascadeCount)
        return;

    float coverage = params.domainCoverage[cascade];
    vec2 kIndex = vec2(pixel - ivec2(N / 2));
    vec2 k = 2.0 * PI * kIndex / coverage;
    float kLength = length(k);
    if (kLength < 1e-6)
    {
        imageStore(h0Spectrum, ivec3(pixel, cascade), vec4(0.0));
        return;
    }

    float wavelength = 2.0 * PI / kLength;
    float band = BandWindow(
        wavelength,
        params.minWavelength[cascade],
        params.maxWavelength[cascade]);

    vec2 wind = normalize(params.windDirection_Time.xy);
    float windSpeed = max(params.windDirection_Time.w, 0.01);
    float Lw = windSpeed * windSpeed / G;
    vec2 kDirection = k / kLength;
    float alignment = dot(kDirection, wind);
    float directional = alignment * alignment;
    if (alignment < 0.0)
        directional *= clamp(params.dampingParams.y, 0.0, 1.0);

    float k2 = kLength * kLength;
    // Phillips' short-wave damping length is a fraction of the wind length,
    // never of the arbitrary periodic FFT domain size.  This keeps the same
    // physical spectrum when decorrelated domains use different coverages.
    float dampingLength = max(params.dampingParams.x, 0.0) * Lw;
    float phillips = max(params.spectrumParams.x, 0.0)
        * exp(-1.0 / max(k2 * Lw * Lw, 1e-8))
        * directional
        * exp(-k2 * dampingLength * dampingLength)
        / max(k2 * k2, 1e-8);

    uint seed = uint(params.spectrumMeta.x) ^ uint(pixel.x * 73856093) ^ uint(pixel.y * 19349663)
        ^ uint(cascade * 83492791);
    float deltaK = 2.0 * PI / coverage;
    vec2 h0 = Gaussian(seed) * sqrt(max(phillips * band, 0.0) * 0.5) * deltaK;
    imageStore(h0Spectrum, ivec3(pixel, cascade), vec4(h0, 0.0, 0.0));
}
