#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform FFTParams
{
    vec4 windDirection_Time;
    vec4 spectrumParams;
    vec4 dampingParams;
    vec4 spectrumMeta;
    vec4 domainCoverage;
    vec4 minWavelength;
    vec4 maxWavelength;
    vec4 spectralOptions;
} params;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2DArray h0Spectrum;
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2DArray outFields;

const float PI = 3.14159265358979323846;
const float G = 9.81;
const int FIELD_HEIGHT = 0;
const int FIELD_DISP_X = 1;
const int FIELD_DISP_Z = 2;
const int FIELD_SLOPE_X = 3;
const int FIELD_SLOPE_Z = 4;
const int FIELD_COUNT = 5;

vec2 Multiply(vec2 a, vec2 b) { return vec2(a.x*b.x-a.y*b.y, a.x*b.y+a.y*b.x); }
vec2 UnitComplex(float phase) { return vec2(cos(phase), sin(phase)); }
void Store(ivec2 p, int cascade, int field, vec2 value)
{
    int fieldCount = params.spectrumMeta.w > 0.5 ? 2 : FIELD_COUNT;
    imageStore(outFields, ivec3(p, cascade * fieldCount + field), vec4(value, 0.0, 0.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    int cascade = int(gl_WorkGroupID.z);
    int N = int(params.spectrumMeta.y + 0.5);
    int cascadeCount = int(params.spectrumMeta.z + 0.5);
    if (any(greaterThanEqual(pixel, ivec2(N))) || cascade >= cascadeCount)
        return;

    float coverage = params.domainCoverage[cascade];
    vec2 k = 2.0 * PI * vec2(pixel - ivec2(N / 2)) / coverage;
    float kLength = length(k);
    ivec2 negativePixel = ivec2((N - pixel.x) & (N - 1), (N - pixel.y) & (N - 1));
    vec2 h0 = imageLoad(h0Spectrum, ivec3(pixel, cascade)).xy;
    vec2 h0Negative = imageLoad(h0Spectrum, ivec3(negativePixel, cascade)).xy;
    h0Negative.y = -h0Negative.y;

    float depthTerm = params.dampingParams.z < 9999.0
        ? tanh(kLength * params.dampingParams.z) : 1.0;
    float omega = kLength > 1e-6
        ? sqrt((G * kLength + params.spectralOptions.x * kLength * kLength * kLength) * depthTerm)
        : 0.0;
    if (params.dampingParams.w > 0.0)
    {
        float fundamental = 2.0 * PI / params.dampingParams.w;
        omega = round(omega / fundamental) * fundamental;
    }
    vec2 height = Multiply(h0, UnitComplex(omega * params.windDirection_Time.z))
                + Multiply(h0Negative, UnitComplex(-omega * params.windDirection_Time.z));
    vec2 iHeight = vec2(-height.y, height.x);
    if (kLength > 1e-6)
    {
        if (params.spectrumMeta.w > 0.5)
        {
            // Exact spectral height gradient.  The inverse FFT directly
            // produces dh/dx and dh/dz; no finite-difference normal map pass.
            Store(pixel, cascade, 0, iHeight * k.x);
            Store(pixel, cascade, 1, iHeight * k.y);
        }
        else
        {
            Store(pixel, cascade, FIELD_HEIGHT, height);
            // 当前逆 DFT 使用正指数，正 choppiness 需要 +i*k/|k|*h，
            // 才会压缩波峰并拓宽波谷，与 Gerstner/Wave Particle 的语义一致。
            Store(pixel, cascade, FIELD_DISP_X, iHeight * (k.x / kLength) * params.spectrumParams.y);
            Store(pixel, cascade, FIELD_DISP_Z, iHeight * (k.y / kLength) * params.spectrumParams.y);
            Store(pixel, cascade, FIELD_SLOPE_X, iHeight * k.x);
            Store(pixel, cascade, FIELD_SLOPE_Z, iHeight * k.y);
        }
    }
    else
    {
        if (params.spectrumMeta.w > 0.5)
        {
            Store(pixel, cascade, 0, vec2(0.0));
            Store(pixel, cascade, 1, vec2(0.0));
        }
        else
        {
            Store(pixel, cascade, FIELD_HEIGHT, height);
            Store(pixel, cascade, FIELD_DISP_X, vec2(0.0));
            Store(pixel, cascade, FIELD_DISP_Z, vec2(0.0));
            Store(pixel, cascade, FIELD_SLOPE_X, vec2(0.0));
            Store(pixel, cascade, FIELD_SLOPE_Z, vec2(0.0));
        }
    }
}
