#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform FFTParams
{
    vec4 windDirection_Time;
    vec4 spectrumParams;
    vec4 dampingParams;
    vec4 spectrumMeta;
    vec4 domainCoverage;
    vec4 minWavelength;
    vec4 maxWavelength;
    vec4 spectralOptions;
} params;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2DArray spatialFields;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2DArray outDisplacement;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2DArray outDerivative;

const int FIELD_HEIGHT = 0;
const int FIELD_DISP_X = 1;
const int FIELD_DISP_Z = 2;
const int FIELD_COUNT = 3;

float Spatial(ivec2 pixel, int cascade, int field, int N)
{
    ivec2 wrapped = ivec2((pixel.x + N) & (N - 1), (pixel.y + N) & (N - 1));
    float value = imageLoad(spatialFields, ivec3(wrapped, cascade * FIELD_COUNT + field)).x;
    return (((wrapped.x + wrapped.y) & 1) == 0) ? value : -value;
}

vec3 DisplacementAt(ivec2 pixel, int cascade, int N)
{
    return vec3(Spatial(pixel, cascade, FIELD_DISP_X, N),
                Spatial(pixel, cascade, FIELD_HEIGHT, N),
                Spatial(pixel, cascade, FIELD_DISP_Z, N));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    int cascade = int(gl_WorkGroupID.z);
    int N = int(params.spectrumMeta.y + 0.5);
    int cascadeCount = int(params.spectrumMeta.z + 0.5);
    if (any(greaterThanEqual(pixel, ivec2(N))) || cascade >= cascadeCount)
        return;

    float coverage = params.domainCoverage[cascade];
    float texelWorld = coverage / float(N);
    vec3 displacement = DisplacementAt(pixel, cascade, N);
    vec3 derivativeX = (DisplacementAt(pixel + ivec2(1, 0), cascade, N)
                      - DisplacementAt(pixel - ivec2(1, 0), cascade, N)) / (2.0 * texelWorld);
    vec3 derivativeZ = (DisplacementAt(pixel + ivec2(0, 1), cascade, N)
                      - DisplacementAt(pixel - ivec2(0, 1), cascade, N)) / (2.0 * texelWorld);
    vec3 dPdx = vec3(1.0, 0.0, 0.0) + derivativeX;
    vec3 dPdz = vec3(0.0, 0.0, 1.0) + derivativeZ;
    float jacobian = dPdx.x * dPdz.z - dPdx.z * dPdz.x;
    float foldDiagnostic = clamp(1.0 - jacobian, 0.0, 1.0);

    imageStore(outDisplacement, ivec3(pixel, cascade), vec4(displacement, foldDiagnostic));
    imageStore(outDerivative, ivec3(pixel, cascade * 2), vec4(dPdx, foldDiagnostic));
    imageStore(outDerivative, ivec3(pixel, cascade * 2 + 1), vec4(dPdz, jacobian));
}
