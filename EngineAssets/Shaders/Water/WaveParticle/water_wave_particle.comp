#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform WaterSurfaceParams
{
    mat4 VPMatrix;
    mat4 ViewMatrix;
    vec4 cameraPosition;
    ivec4 geometryParams;
    vec4 geometryScale;
    vec4 spectrumScale;
    vec4 windAndChop;
    ivec4 simulationParams;
    vec4 waveParticleParams0;
    vec4 waveParticleParams1;
    vec4 waveParticleParams2;
    vec4 waveParticleParams3;
    vec4 flowMapWorld;
    vec4 flowMapParams;
    vec4 flowMapFallback;
} params;

layout(set = 0, binding = 1, rgba16f) uniform image2DArray outDisplacement;

struct WaveParticle
{
    vec4 positionRadius;
    vec4 directionPhase;
    vec4 lifetimeSeed;
};
layout(set = 0, binding = 2, std430) readonly buffer ParticleBuffer { WaveParticle particles[]; } particleSSBO;
layout(set = 0, binding = 3, rgba16f) uniform image2DArray outDerivative;

const float PI = 3.14159265358979323846;

vec2 EnvelopeAndDerivative(float x, float sharpness, float profile)
{
    if (profile < 0.5)
    {
        float e = exp(-x * x * sharpness);
        return vec2(e, -2.0 * sharpness * x * e);
    }

    if (profile < 1.5)
    {
        if (x >= 1.0)
            return vec2(0.0);
        float e = 0.5 + 0.5 * cos(PI * x);
        float de = -0.5 * PI * sin(PI * x);
        return vec2(e, de);
    }

    if (x >= 1.0)
        return vec2(0.0);
    float y = max(1.0 - x, 0.0);
    float e = pow(y, sharpness);
    float de = -sharpness * pow(max(y, 1e-4), sharpness - 1.0);
    return vec2(e, de);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    int cascade = int(gl_WorkGroupID.z);
    ivec3 size = imageSize(outDisplacement);
    int cascadeCount = params.geometryParams.z;
    if (any(greaterThanEqual(pixel, size.xy)) || cascade >= cascadeCount)
        return;

    float coverage = params.spectrumScale.x * pow(params.spectrumScale.y, float(cascade));
    float lowerWavelength = cascade == 0 ? 2.0 * coverage / float(size.x) : coverage / params.spectrumScale.y;
    float upperWavelength = coverage;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size.xy);
    vec2 worldXZ = uv * coverage;

    vec3 displacement = vec3(0.0);
    vec3 dPdx = vec3(1.0, 0.0, 0.0);
    vec3 dPdz = vec3(0.0, 0.0, 1.0);
    float maxSlope = 0.0;

    int particleCount = clamp(params.simulationParams.y, 0, particleSSBO.particles.length());
    int octaveCount = clamp(params.simulationParams.z, 1, 8);
    float domainSize = max(params.waveParticleParams0.x, 1.0);
    float globalAmplitude = params.waveParticleParams0.y;
    float phaseVelocity = params.waveParticleParams1.x;
    float damping = params.waveParticleParams1.y;
    float profile = params.waveParticleParams1.w;
    float lacunarity = max(params.waveParticleParams2.x, 1.01);
    float persistence = clamp(params.waveParticleParams2.y, 0.0, 1.0);
    float radiusFalloff = clamp(params.waveParticleParams2.z, 0.1, 1.0);
    float sharpness = max(params.waveParticleParams2.w, 0.25);
    float lifetime = max(params.waveParticleParams3.z, 0.1);
    float coverageScale = coverage / domainSize;

    for (int i = 0; i < particleCount; ++i)
    {
        WaveParticle particle = particleSSBO.particles[i];
        vec2 direction = particle.directionPhase.xy;
        if (dot(direction, direction) < 1e-5)
            continue;
        direction = normalize(direction);

        float age = fract((params.spectrumScale.z + particle.lifetimeSeed.y) / max(particle.lifetimeSeed.x, lifetime));
        float fade = pow(max(sin(PI * age), 0.0), 0.5);
        vec2 particleCenter = fract(
            particle.positionRadius.xy + direction * (params.spectrumScale.z * particle.directionPhase.w / max(coverage, 1.0)))
            * coverage;
        vec2 rel = worldXZ - particleCenter;
        rel -= coverage * round(rel / coverage);
        float dist = length(rel);
        vec2 radialDir = dist > 1e-5 ? rel / dist : vec2(0.0);

        float octaveRadius = particle.positionRadius.z * coverageScale;
        float octaveAmplitude = particle.positionRadius.w * globalAmplitude * sqrt(max(coverageScale, 0.125));
        float octaveFrequencyScale = 1.0;
        for (int octave = 0; octave < octaveCount; ++octave)
        {
            float radius = max(octaveRadius, 0.05);
            float wavelength = 2.0 * radius;
            if (wavelength >= lowerWavelength && wavelength < upperWavelength)
            {
                float x = dist / radius;
                vec2 env = EnvelopeAndDerivative(x, sharpness, profile);
                if (env.x > 0.0)
                {
                    float frequency = PI * octaveFrequencyScale / radius;
                    float phase = dot(rel, direction) * frequency
                        - params.spectrumScale.z * particle.directionPhase.w * phaseVelocity * frequency
                        + particle.directionPhase.z + float(octave) * 1.61803398875;
                    float s = sin(phase);
                    float c = cos(phase);
                    float dampedAmplitude = octaveAmplitude * fade * exp(-damping * x);
                    float height = dampedAmplitude * env.x * s;
                    vec2 gradient = dampedAmplitude * (
                        env.y * s * radialDir / radius
                        + env.x * c * frequency * direction);
                    vec2 horizontal = direction * height * params.windAndChop.w;

                    displacement += vec3(horizontal.x, height, horizontal.y);
                    dPdx += vec3(direction.x * params.windAndChop.w * gradient.x,
                                  gradient.x,
                                  direction.y * params.windAndChop.w * gradient.x);
                    dPdz += vec3(direction.x * params.windAndChop.w * gradient.y,
                                  gradient.y,
                                  direction.y * params.windAndChop.w * gradient.y);
                    maxSlope = max(maxSlope, length(gradient));
                }
            }

            octaveRadius *= radiusFalloff;
            octaveAmplitude *= persistence;
            octaveFrequencyScale *= lacunarity;
        }
    }

    float jacobian = dPdx.x * dPdz.z - dPdx.z * dPdz.x;
    float foamSlope = smoothstep(
        params.waveParticleParams3.x,
        params.waveParticleParams3.x + params.waveParticleParams3.y,
        maxSlope);
    float foldDiagnostic = max(foamSlope, clamp(1.0 - jacobian, 0.0, 1.0));
    imageStore(outDisplacement, ivec3(pixel, cascade), vec4(displacement, foldDiagnostic));
    imageStore(outDerivative, ivec3(pixel, cascade * 2), vec4(dPdx, foldDiagnostic));
    imageStore(outDerivative, ivec3(pixel, cascade * 2 + 1), vec4(dPdz, jacobian));
}
