#version 450
#extension GL_GOOGLE_include_directive : require

#include "../water_screen_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D waterGBufPosDepth;
layout(set = 0, binding = 1) uniform sampler2D rawColor;
layout(set = 0, binding = 2) uniform sampler2D rawTransmittance;
layout(set = 0, binding = 3) uniform sampler2D rawDepth;

#define PBR_WATER_PARAMS_SET 0
#define PBR_WATER_PARAMS_BINDING 4
#define PBR_WATER_PARAMS_INSTANCE params
#include "../PBRWater/pbr_water_params.glsl"

layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D colorOut;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D transmittanceOut;
layout(set = 0, binding = 7, r16f) uniform writeonly image2D depthOut;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(colorOut);
    if (any(greaterThanEqual(pixel, size)))
        return;

    vec2 uv = WaterPixelUV(pixel, size);
    float centerDepth = textureLod(rawDepth, uv, 0.0).r;
    if (centerDepth >= WATER_INVALID_DEPTH)
    {
        imageStore(colorOut, pixel, vec4(0.0));
        imageStore(transmittanceOut, pixel, vec4(1.0));
        imageStore(depthOut, pixel, vec4(WATER_INVALID_DEPTH));
        return;
    }

    int radius = clamp(int(params.filterParams.y), 0, 4);
    float depthSensitivity = max(params.filterParams.x, 0.001);
    vec3 colorSum = vec3(0.0);
    vec3 transSum = vec3(0.0);
    float weightSum = 0.0;
    for (int y = -radius; y <= radius; ++y)
    {
        for (int x = -radius; x <= radius; ++x)
        {
            ivec2 p = clamp(pixel + ivec2(x, y), ivec2(0), size - ivec2(1));
            vec2 suv = WaterPixelUV(p, size);
            float d = textureLod(rawDepth, suv, 0.0).r;
            float w = exp(-abs(d - centerDepth) * depthSensitivity);
            colorSum += textureLod(rawColor, suv, 0.0).rgb * w;
            transSum += textureLod(rawTransmittance, suv, 0.0).rgb * w;
            weightSum += w;
        }
    }

    vec3 color = colorSum / max(weightSum, 1e-5);
    vec3 trans = transSum / max(weightSum, 1e-5);
    imageStore(colorOut, pixel, vec4(max(color, vec3(0.0)), 1.0));
    imageStore(transmittanceOut, pixel, vec4(clamp(trans, vec3(0.0), vec3(1.0)), 1.0));
    imageStore(depthOut, pixel, vec4(centerDepth));
}
