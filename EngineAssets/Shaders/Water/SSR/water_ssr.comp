#version 450
#extension GL_GOOGLE_include_directive : require

// ============================================================
// water_ssr.comp — HZB Ray March 水面屏幕空间反射（W-12）
//
// 参考 SSR_TRACE.comp 的标准 tracing 流程，适配水面 GBuffer 格式。
//
// 输入：
//   WaterGBufPosDepth (RGBA16F): RGB=worldPos, A=linearDepth
//   WaterGBufNormal   (RGBA16F): RGB=worldNormal
//   Scene HZB / Scene GBuf2 / SceneColor（来自场景渲染）
//
// 输出：
//   reflectionOut (RGBA16F): RGB=SSR颜色, A=命中标志(1=hit, 0=miss)
// ============================================================

#include "../../Common/Common.glsl"
#include "../water_screen_common.glsl"
#include "../PBRWater/pbr_water_common.glsl"
// NOTE: CameraData.glsl NOT included — set=0 binding=0 is used by waterGBufNormal

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ── 输入 ────────────────────────────────────────────────────
layout(set = 0, binding = 0) uniform sampler2D waterGBufNormal;     // RGB = worldNormal
layout(set = 0, binding = 1) uniform sampler2D waterGBufPosDepth;   // RGB = worldPos, A = linearDepth
layout(set = 0, binding = 2) uniform sampler2D sceneHZB;            // 场景 HZB depth mip chain
layout(set = 0, binding = 3) uniform sampler2D sceneGBuf2;          // scene worldPos.xyz + linearDepth.w
layout(set = 0, binding = 4) uniform sampler2D waterBackgroundPyramid;

layout(set = 0, binding = 5) uniform WaterSSRParams
{
    vec4 cameraPosition;
    mat4 projection;
    mat4 inverseProjection;
    mat4 view;
    vec4 traceParams;
    vec4 screenParams;
    vec4 colorMipParams;
    vec4 roughnessParams;
    vec4 edgeParams;
} params;

// ── 输出 ────────────────────────────────────────────────────
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D reflectionOut;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(reflectionOut);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = WaterPixelUV(pixel, size);

    // ── 读取 Water GBuffer（修复后的格式）──────────────────
    vec4 normalCoverage = texelFetch(waterGBufNormal, pixel, 0);
    vec4 posDepth    = texelFetch(waterGBufPosDepth, pixel, 0);
    float waterDepth = posDepth.a;
    vec3  worldPos   = posDepth.rgb;

    // 无水面的像素跳过
    if (!WaterSurfaceValid(normalCoverage, posDepth))
    {
        imageStore(reflectionOut, pixel, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }

    // 场景遮挡：场景在水面之前则无水面可见
    float sceneDepth = texelFetch(sceneGBuf2, pixel, 0).w;
    if (SceneOccludesWater(sceneDepth, waterDepth))
    {
        imageStore(reflectionOut, pixel, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }

    // 世界空间法线（直接读取 RGB，非 oct 解码）
    vec3 normal = normalize(normalCoverage.rgb);
    float effectiveRoughness = clamp(normalCoverage.a, 0.002, 1.0);
    float roughnessValidity = 1.0 - smoothstep(
        params.roughnessParams.x,
        max(params.roughnessParams.y, params.roughnessParams.x + 1e-4),
        effectiveRoughness);
    if (roughnessValidity <= 0.0)
    {
        imageStore(reflectionOut, pixel, vec4(0.0));
        return;
    }

    // 视线方向
    vec3 viewDir = normalize(params.cameraPosition.xyz - worldPos);

    // 反射方向
    vec3 reflectDir = reflect(-viewDir, normal);

    // 反射方向朝向背面 → 无效
    if (dot(reflectDir, normal) < 0.0)
    {
        imageStore(reflectionOut, pixel, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }

    // ── HZB ray march（使用标准 TraceHiZ_UV）─────────────────
    vec3 rayOrigin = worldPos + normal * SSR_START_BIAS;

    HiZTraceResult traceResult = TraceHiZ_UV_Bounded(
        sceneHZB,
        params.view,
        params.projection,
        rayOrigin,
        reflectDir,
        params.traceParams.x,
        1.0,    // traceStride: 初始步长（像素）
        max(params.traceParams.z, 0.01),
        max(int(params.traceParams.y + 0.5), 1)
    );

    vec3 reflectionColor;
    float hitFlag;

    if (traceResult.hit)
    {
        vec2 hitUV = traceResult.uv;
        ivec2 hitPixel = WaterUVToPixel(hitUV, textureSize(sceneGBuf2, 0));
        vec4 hitSurface = texelFetch(sceneGBuf2, hitPixel, 0);
        bool hitValid = SceneDepthValid(hitSurface.w) &&
            hitSurface.w > 0.0 && dot(hitSurface.xyz - worldPos, hitSurface.xyz - worldPos) > 1e-6;
        if (!hitValid)
        {
            imageStore(reflectionOut, pixel, vec4(0.0));
            return;
        }

        float rayLength = length(hitSurface.xyz - worldPos);
        float hitViewDepth = max(abs((params.view * vec4(hitSurface.xyz, 1.0)).z), 1e-3);
        float pixelsPerMeter = 0.5 * params.screenParams.y *
            abs(params.projection[1][1]) / hitViewDepth;
        float coneRadiusWorld = rayLength * effectiveRoughness * effectiveRoughness *
            params.colorMipParams.x;
        float footprintPixels = max(coneRadiusWorld * pixelsPerMeter, 1.0);
        float colorLod = clamp(
            log2(footprintPixels) + params.colorMipParams.y,
            0.0,
            params.screenParams.z);

        vec2 edgePixels = min(hitUV, vec2(1.0) - hitUV) * params.screenParams.xy;
        float nearestEdgePixels = min(edgePixels.x, edgePixels.y);
        float requiredEdgePixels = params.edgeParams.x +
            footprintPixels * max(params.edgeParams.y, 0.0);
        float edgeValidity = smoothstep(
            requiredEdgePixels,
            max(requiredEdgePixels * 2.0, requiredEdgePixels + 1.0),
            nearestEdgePixels);
        float minScreenExtent = min(params.screenParams.x, params.screenParams.y);
        float footprintValidity = 1.0 - smoothstep(
            minScreenExtent * 0.15,
            minScreenExtent * 0.35,
            footprintPixels * max(params.colorMipParams.z, 0.0));

        reflectionColor = textureLod(
            waterBackgroundPyramid, hitUV, colorLod).rgb;
        hitFlag = clamp(
            roughnessValidity * edgeValidity * footprintValidity,
            0.0,
            1.0);
    }
    else
    {
        // 未命中 → 黑色（后续 Composite 用天空渐变回退）
        reflectionColor = vec3(0.0);
        hitFlag = 0.0;
    }

    imageStore(reflectionOut, pixel, vec4(reflectionColor, hitFlag));
}
