#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform WaterSurfaceParams
{
    mat4 VPMatrix;
    mat4 ViewMatrix;
    vec4 cameraPosition;
    ivec4 geometryParams;
    vec4 geometryScale;
    vec4 spectrumScale;
    vec4 windAndChop;
    ivec4 simulationParams;
    vec4 waveParticleParams0;
    vec4 waveParticleParams1;
    vec4 waveParticleParams2;
    vec4 waveParticleParams3;
    vec4 flowMapWorld;
    vec4 flowMapParams;
    vec4 flowMapFallback;
} params;

layout(set = 0, binding = 1, rgba16f) uniform image2DArray outDisplacement;

struct GerstnerWave
{
    float amplitude;
    float wavelength;
    float directionX;
    float directionY;
    float phaseSpeed;
    float steepness;
    float pad0;
    float pad1;
};
layout(set = 0, binding = 2, std430) readonly buffer WaveBuffer { GerstnerWave waves[]; } waveSSBO;
layout(set = 0, binding = 3, rgba16f) uniform image2DArray outDerivative;

const float PI = 3.14159265358979323846;
const float G = 9.81;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    int cascade = int(gl_WorkGroupID.z);
    ivec3 size = imageSize(outDisplacement);
    int cascadeCount = params.geometryParams.z;
    if (any(greaterThanEqual(pixel, size.xy)) || cascade >= cascadeCount)
        return;

    float coverage = params.spectrumScale.x * pow(params.spectrumScale.y, float(cascade));
    float lowerWavelength = cascade == 0 ? 2.0 * coverage / float(size.x) : coverage / params.spectrumScale.y;
    float upperWavelength = coverage;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size.xy);
    vec2 worldXZ = uv * coverage;

    vec3 displacement = vec3(0.0);
    vec3 dPdx = vec3(1.0, 0.0, 0.0);
    vec3 dPdz = vec3(0.0, 0.0, 1.0);
    int activeCount = clamp(params.simulationParams.x, 0, waveSSBO.waves.length());
    for (int i = 0; i < activeCount; ++i)
    {
        GerstnerWave wave = waveSSBO.waves[i];
        if (wave.wavelength < lowerWavelength || wave.wavelength >= upperWavelength)
            continue;

        vec2 desiredDirection = normalize(vec2(wave.directionX, wave.directionY));
        float desiredK = 2.0 * PI / max(wave.wavelength, 0.05);
        float latticeStep = 2.0 * PI / coverage;
        vec2 lattice = round(desiredDirection * desiredK / latticeStep);
        if (dot(lattice, lattice) < 0.5)
            continue;
        vec2 k = lattice * latticeStep;
        float kLength = length(k);
        vec2 direction = k / kLength;
        float omega = kLength * wave.phaseSpeed;
        float phase = dot(k, worldXZ) + omega * params.spectrumScale.z;
        float sinePhase = sin(phase);
        float cosinePhase = cos(phase);
        float amplitude = wave.amplitude;
        float horizontalAmplitude = wave.steepness * params.windAndChop.w * amplitude;

        displacement += vec3(direction.x * horizontalAmplitude * cosinePhase,
                             amplitude * sinePhase,
                             direction.y * horizontalAmplitude * cosinePhase);
        vec3 phaseDerivative = vec3(-direction.x * horizontalAmplitude * sinePhase,
                                    amplitude * cosinePhase,
                                   -direction.y * horizontalAmplitude * sinePhase);
        dPdx += phaseDerivative * k.x;
        dPdz += phaseDerivative * k.y;
    }

    float jacobian = dPdx.x * dPdz.z - dPdx.z * dPdz.x;
    float foldDiagnostic = clamp(1.0 - jacobian, 0.0, 1.0);
    imageStore(outDisplacement, ivec3(pixel, cascade), vec4(displacement, foldDiagnostic));
    imageStore(outDerivative, ivec3(pixel, cascade * 2), vec4(dPdx, foldDiagnostic));
    imageStore(outDerivative, ivec3(pixel, cascade * 2 + 1), vec4(dPdz, jacobian));
}
