#version 450
#extension GL_GOOGLE_include_directive : require
#include "../water_screen_common.glsl"

// ============================================================
// water_thickness.comp — 水体厚度图（W-16）
//
// 设计文档：水面渲染模块落地方案 §9.1
//
// 输出 R16F 厚度图：
//   thickness = sceneDepth - waterDepth（clamped）
//
// 用于 Composite Pass 中的 SSS + Beer-Lambert 计算
// ============================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D waterGBufPosDepth;   // 水面线性深度
layout(set = 0, binding = 1) uniform sampler2D sceneGBuf2;       // 场景线性深度 (.w)

layout(set = 0, binding = 2) uniform WaterThicknessParams
{
    float maxThicknessDistance;  // 最大厚度值（m），超过此值 clamp
    float deepWaterFallback;
    float pad1;
    float pad2;
} params;

layout(set = 0, binding = 3, r16f) uniform writeonly image2D thicknessOut;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(thicknessOut);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec4 waterSurface = texelFetch(waterGBufPosDepth, pixel, 0);
    vec4 sceneReceiver = texelFetch(sceneGBuf2, pixel, 0);
    float waterDepth = waterSurface.a;
    float sceneDepth = sceneReceiver.w;

    float thickness = 0.0;
    if (waterDepth < WATER_INVALID_DEPTH && SceneDepthValid(sceneDepth) &&
        sceneDepth > waterDepth + WaterDepthEpsilon(waterDepth))
    {
        // Vertical world-space depth is stable under camera rotation.  The
        // previous linear view-depth delta grew at grazing angles and drove
        // large refraction changes even for a stationary surface/receiver.
        float verticalDepth = max(waterSurface.y - sceneReceiver.y, 0.0);
        thickness = verticalDepth / max(params.maxThicknessDistance, 1.0);
        thickness = clamp(thickness, 0.0, 1.0);
    }
    else if (waterDepth < WATER_INVALID_DEPTH && !SceneOccludesWater(sceneDepth, waterDepth))
    {
        // 水面存在但没有场景几何 → 深水（设为最大厚度的 80%）
        thickness = clamp(params.deepWaterFallback, 0.0, 1.0);
    }

    imageStore(thicknessOut, pixel, vec4(thickness, 0.0, 0.0, 0.0));
}
