#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/Common.glsl"
#include "../Common/CameraData.glsl"
#include "../Lights/LightsData.glsl"
#include "../BRDF/ReflectionProbeData.glsl"

// SSGI outputs diffuse lighting for the current surface, not albedo.
// Screen-space trace misses fall back to DDGI atlases and dynamic sky diffuse.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const int SSGI_PROBE_CACHE_TILE_SIZE = 4;
const int SSGI_PROBE_CACHE_TILE_SHIFT = 2;
const int SSGI_PROBE_CACHE_SHARED_DIM = 4;
const int SSGI_PROBE_CACHE_SHARED_TEXELS =
    SSGI_PROBE_CACHE_SHARED_DIM * SSGI_PROBE_CACHE_SHARED_DIM;
const int SSGI_SURFACE_SHARED_DIM = 10;
const int SSGI_SURFACE_SHARED_TEXELS =
    SSGI_SURFACE_SHARED_DIM * SSGI_SURFACE_SHARED_DIM;

shared vec4 sharedProbeCacheRadiance[SSGI_PROBE_CACHE_SHARED_TEXELS];
shared vec4 sharedProbeCacheSurface[SSGI_PROBE_CACHE_SHARED_TEXELS];
shared vec4 sharedSurfacePosition[SSGI_SURFACE_SHARED_TEXELS];

layout(set = 1, binding = 0) uniform sampler2D inputNormal;
layout(set = 1, binding = 1) uniform sampler2D inputDepth;
layout(set = 1, binding = 2) uniform sampler2D inputColor;
layout(set = 1, binding = 3) uniform sampler2D inputPosition;
layout(set = 1, binding = 4) uniform samplerCube inputSkydiffuse;

// 最终 Scene Color 本身是 RGBA16F；SSGI 中间辐射度保持同等精度即可，
// 避免全分辨率 Raw/Temporal/A-Trous 链路承担双倍带宽。
layout(set = 1, binding = 5, rgba16f) uniform image2D resultR;

struct SSGIRegionParams
{
    vec4 volumeMin;
    vec4 volumeSizeAndBias;
    vec4 traceParams;
    vec4 gridDimensionsAndPriority;
};

layout(set = 1, binding = 6) uniform ssgiInfo
{
    vec4 screenSize;
    vec4 regionInfo;
    SSGIRegionParams regions[8];
    vec4 deferredProbeDebug;
};

layout(set = 1, binding = 10) uniform sampler2D hizDepth;
layout(set = 1, binding = 11) uniform sampler2D inputMaterial;
layout(set = 1, binding = 23) uniform sampler2D probeCacheRadiance;
layout(set = 1, binding = 24) uniform sampler2D probeCacheSurface;

ivec2 GetSharedProbeCacheOrigin()
{
    // 一个 8x8 工作组覆盖 2x2 个四分之一分辨率缓存 texel；
    // 额外各扩一格即可覆盖双线性重建与严格 3x3 邻域搜索。
    return ivec2(gl_WorkGroupID.xy) * 2 - ivec2(1);
}

ivec2 GetSharedSurfaceOrigin()
{
    return ivec2(gl_WorkGroupID.xy) * ivec2(gl_WorkGroupSize.xy) - ivec2(1);
}

void PrefetchSSGISharedInputs(ivec2 cacheSize, ivec2 imageSize)
{
    uint localIndex = gl_LocalInvocationIndex;
    if (localIndex < uint(SSGI_PROBE_CACHE_SHARED_TEXELS))
    {
        ivec2 localCoord = ivec2(
            int(localIndex) % SSGI_PROBE_CACHE_SHARED_DIM,
            int(localIndex) / SSGI_PROBE_CACHE_SHARED_DIM);
        ivec2 cacheCoord = clamp(
            GetSharedProbeCacheOrigin() + localCoord,
            ivec2(0), cacheSize - 1);
        sharedProbeCacheRadiance[localIndex] =
            texelFetch(probeCacheRadiance, cacheCoord, 0);
        sharedProbeCacheSurface[localIndex] =
            texelFetch(probeCacheSurface, cacheCoord, 0);
    }

    // The 8x8 workgroup needs its own pixels plus a one-pixel halo to reproduce
    // the existing shortest left/right and up/down geometric derivatives.
    // Cooperative loading cuts GBuffer2 position reads from 5 per pixel
    // (320/workgroup) to 100/workgroup while keeping the exact neighborhood.
    for (uint sharedIndex = localIndex;
         sharedIndex < uint(SSGI_SURFACE_SHARED_TEXELS);
         sharedIndex += gl_WorkGroupSize.x * gl_WorkGroupSize.y)
    {
        ivec2 localCoord = ivec2(
            int(sharedIndex) % SSGI_SURFACE_SHARED_DIM,
            int(sharedIndex) / SSGI_SURFACE_SHARED_DIM);
        ivec2 surfaceCoord = clamp(
            GetSharedSurfaceOrigin() + localCoord,
            ivec2(0), imageSize - 1);
        sharedSurfacePosition[sharedIndex] =
            texelFetch(inputPosition, surfaceCoord, 0);
    }
    barrier();
}

vec4 LoadSharedSurfacePosition(ivec2 pixelCoord)
{
    ivec2 localCoord = pixelCoord - GetSharedSurfaceOrigin();
    int sharedIndex = localCoord.y * SSGI_SURFACE_SHARED_DIM + localCoord.x;
    return sharedSurfacePosition[sharedIndex];
}

int GetSharedProbeCacheIndex(ivec2 cacheCoord)
{
    ivec2 localCoord = cacheCoord - GetSharedProbeCacheOrigin();
    if (any(lessThan(localCoord, ivec2(0))) ||
        any(greaterThanEqual(localCoord, ivec2(SSGI_PROBE_CACHE_SHARED_DIM))))
    {
        return -1;
    }
    return localCoord.y * SSGI_PROBE_CACHE_SHARED_DIM + localCoord.x;
}

vec4 LoadProbeCacheRadiance(ivec2 cacheCoord)
{
    int sharedIndex = GetSharedProbeCacheIndex(cacheCoord);
    return sharedIndex >= 0
        ? sharedProbeCacheRadiance[sharedIndex]
        : texelFetch(probeCacheRadiance, cacheCoord, 0);
}

vec4 LoadProbeCacheSurface(ivec2 cacheCoord)
{
    int sharedIndex = GetSharedProbeCacheIndex(cacheCoord);
    return sharedIndex >= 0
        ? sharedProbeCacheSurface[sharedIndex]
        : texelFetch(probeCacheSurface, cacheCoord, 0);
}

float GetVegetationTranslucency(ivec2 pixelCoord, float normalAlpha)
{
    int materialId = int(round(texelFetch(inputMaterial, pixelCoord, 0).z));
    bool vegetationMaterial = materialId == MATERIAL_ID_GRASS || materialId == MATERIAL_ID_TREE;
    return vegetationMaterial ? clamp(normalAlpha, 0.0, 1.0) : 0.0;
}

vec3 ComputeSSGIGINormal(ivec2 pixelCoord, ivec2 imgSize, vec3 centerPosition, vec3 shadingNormal)
{
    // The caller normalizes the GBuffer normal once.  Keeping that unit-vector
    // contract avoids repeating normalize throughout the cache fallback chain.
    vec3 fallback = dot(shadingNormal, shadingNormal) > 1e-6
        ? shadingNormal
        : vec3(0.0, 1.0, 0.0);

    ivec2 leftCoord = ivec2(max(pixelCoord.x - 1, 0), pixelCoord.y);
    ivec2 rightCoord = ivec2(min(pixelCoord.x + 1, imgSize.x - 1), pixelCoord.y);
    ivec2 downCoord = ivec2(pixelCoord.x, max(pixelCoord.y - 1, 0));
    ivec2 upCoord = ivec2(pixelCoord.x, min(pixelCoord.y + 1, imgSize.y - 1));

    vec3 dxLeft = centerPosition - LoadSharedSurfacePosition(leftCoord).xyz;
    vec3 dxRight = LoadSharedSurfacePosition(rightCoord).xyz - centerPosition;
    vec3 dyDown = centerPosition - LoadSharedSurfacePosition(downCoord).xyz;
    vec3 dyUp = LoadSharedSurfacePosition(upCoord).xyz - centerPosition;

    vec3 dx = dot(dxRight, dxRight) < dot(dxLeft, dxLeft) ? dxRight : dxLeft;
    vec3 dy = dot(dyUp, dyUp) < dot(dyDown, dyDown) ? dyUp : dyDown;
    vec3 geometric = cross(dx, dy);
    if (dot(geometric, geometric) <= 1e-8)
        return fallback;

    geometric = normalize(geometric);
    return dot(geometric, fallback) < 0.0 ? -geometric : geometric;
}

vec3 EvaluateDynamicSkyDiffuse(vec3 direction)
{
    return SampleSkyDiffuseCube(inputSkydiffuse, direction);
}

vec3 EvaluateSSGICacheMissFallback(vec3 normal, float vegetationTranslucency)
{
    // ComputeSSGIGINormal always returns a unit vector.
    vec3 N = normal;
    vec3 frontIrradiance = EvaluateDynamicSkyDiffuse(N);
    if (vegetationTranslucency <= 0.001)
        return frontIrradiance;

    vec3 backN = -N;
    vec3 backIrradiance = EvaluateDynamicSkyDiffuse(backN);
    float backWeight = clamp(vegetationTranslucency * 0.7, 0.0, 0.7);
    return mix(frontIrradiance, max(frontIrradiance, backIrradiance), backWeight);
}

bool TrySampleProbeCache(
    ivec2 pixelCoord,
    ivec2 cacheSize,
    float surfaceLinearDepth,
    vec3 normal,
    out vec3 cachedIrradiance,
    out float cachedScreenHitConfidence)
{
    const float cacheTileSize = float(SSGI_PROBE_CACHE_TILE_SIZE);
    vec2 cachePosition = (vec2(pixelCoord) + 0.5) / cacheTileSize - 0.5;
    ivec2 base = ivec2(floor(cachePosition));
    vec2 fraction = clamp(fract(cachePosition), vec2(0.0), vec2(1.0));
    // ComputeSSGIGINormal always returns a unit vector.
    vec3 N = normal;
    // GBuffer2.w is authored as positive view-space linear depth by every
    // deferred material path. Reconstructing it again from the stored world
    // position costs a full matrix multiply in every full-resolution thread.
    float linearDepth = max(surfaceLinearDepth, NearPlane);
    float depthThreshold = max(linearDepth * 0.04, 0.25);

    vec3 weightedIrradiance = vec3(0.0);
    float weightedScreenHitConfidence = 0.0;
    float totalWeight = 0.0;

    // 每个 screen probe 只有一条 Hi-Z 射线；当它偶然命中比周围探针更亮的
    // 表面时，普通双线性重建会把单个 cache texel 扩散成随镜头移动的亮点。
    // 利用已经驻留在共享内存中的四个同表面候选建立稳健基线。仅剔除其中
    // 最大亮度可保留连续照明梯度，同时在下方重建时压低孤立 Monte-Carlo
    // 离群值，不增加纹理读取、射线或额外 pass。
    float candidateLuminanceSum = 0.0;
    float candidateLuminanceMax = 0.0;
    int candidateCount = 0;
    for (int y = 0; y <= 1; ++y)
    for (int x = 0; x <= 1; ++x)
    {
        ivec2 cacheCoord = clamp(base + ivec2(x, y), ivec2(0), cacheSize - 1);
        vec4 radiance = LoadProbeCacheRadiance(cacheCoord);
        if (radiance.a < 0.5)
            continue;

        vec4 surface = LoadProbeCacheSurface(cacheCoord);
        float normalAgreement = dot(N, surface.xyz);
        float depthDifference = abs(linearDepth - surface.w);
        if (normalAgreement < 0.85 || depthDifference > depthThreshold)
            continue;

        float candidateLuminance = Luminance(max(radiance.rgb, vec3(0.0)));
        candidateLuminanceSum += candidateLuminance;
        candidateLuminanceMax = max(candidateLuminanceMax, candidateLuminance);
        ++candidateCount;
    }

    float isolatedLuminanceLimit = 1e20;
    if (candidateCount >= 3)
    {
        float trimmedMean =
            (candidateLuminanceSum - candidateLuminanceMax) /
            float(candidateCount - 1);
        isolatedLuminanceLimit = trimmedMean * 1.75 + 0.08;
    }

    for (int y = 0; y <= 1; ++y)
    for (int x = 0; x <= 1; ++x)
    {
        ivec2 cacheCoord = clamp(base + ivec2(x, y), ivec2(0), cacheSize - 1);
        vec4 radiance = LoadProbeCacheRadiance(cacheCoord);
        if (radiance.a < 0.5)
            continue;

        vec4 surface = LoadProbeCacheSurface(cacheCoord);
        // Probe Cache 写入阶段已经保证几何法线为单位向量。这里直接点乘，
        // 避免四分之一分辨率重建在每个候选样本上重复执行 normalize。
        float normalAgreement = dot(N, surface.xyz);
        float depthDifference = abs(linearDepth - surface.w);
        if (normalAgreement < 0.85 || depthDifference > depthThreshold)
            continue;

        vec2 bilinear = mix(1.0 - fraction, fraction, vec2(x, y));
        float weight = bilinear.x * bilinear.y;
        weight *= smoothstep(0.85, 0.98, normalAgreement);
        weight *= 1.0 - smoothstep(depthThreshold * 0.25, depthThreshold, depthDifference);
        float radianceLuminance = Luminance(max(radiance.rgb, vec3(0.0)));
        float outlierScale = min(
            1.0,
            isolatedLuminanceLimit / max(radianceLuminance, 1e-5));
        weightedIrradiance += radiance.rgb * outlierScale * weight;
        // 被压低的 cache texel 不能继续保留完整 screen-hit confidence，
        // 否则 Temporal 会按可信屏幕命中继续保留该噪声样本。
        weightedScreenHitConfidence +=
            clamp(radiance.a - 1.0, 0.0, 1.0) * outlierScale * weight;
        totalWeight += weight;
    }

    if (totalWeight > 0.2)
    {
        cachedIrradiance = weightedIrradiance / totalWeight;
        cachedScreenHitConfidence = weightedScreenHitConfidence / totalWeight;
        return true;
    }

    // 2x2 重建在轮廓和薄几何处失败时，先寻找严格匹配的邻近缓存项，
    // 避免这些少量像素重新触发完整的 DDGI atlas 查询。
    weightedIrradiance = vec3(0.0);
    weightedScreenHitConfidence = 0.0;
    totalWeight = 0.0;
    ivec2 nearestCenter = ivec2(round(cachePosition));
    float strictDepthThreshold = depthThreshold * 0.5;
    for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x)
    {
        ivec2 cacheCoord = nearestCenter + ivec2(x, y);
        if (any(lessThan(cacheCoord, ivec2(0))) || any(greaterThanEqual(cacheCoord, cacheSize)))
            continue;

        vec4 radiance = LoadProbeCacheRadiance(cacheCoord);
        if (radiance.a < 0.5)
            continue;

        vec4 surface = LoadProbeCacheSurface(cacheCoord);
        float normalAgreement = dot(N, surface.xyz);
        float depthDifference = abs(linearDepth - surface.w);
        if (normalAgreement < 0.92 || depthDifference > strictDepthThreshold)
            continue;

        vec2 delta = vec2(cacheCoord) - cachePosition;
        float spatialWeight = 1.0 / (1.0 + dot(delta, delta));
        float weight = spatialWeight * smoothstep(0.92, 0.99, normalAgreement);
        weight *= 1.0 - smoothstep(
            strictDepthThreshold * 0.25, strictDepthThreshold, depthDifference);
        weightedIrradiance += radiance.rgb * weight;
        weightedScreenHitConfidence += clamp(radiance.a - 1.0, 0.0, 1.0) * weight;
        totalWeight += weight;
    }

    // 这里已经通过更严格的法线和深度门槛；权重只用于候选间归一化，
    // 不再用其绝对值二次拒绝有效样本并触发完整的每像素 DDGI 查询。
    const bool hasStrictCacheMatch = totalWeight > 1e-4;
    cachedIrradiance = hasStrictCacheMatch
        ? weightedIrradiance / totalWeight
        : vec3(0.0);
    cachedScreenHitConfidence = hasStrictCacheMatch
        ? weightedScreenHitConfidence / totalWeight
        : 0.0;
    return hasStrictCacheMatch;
}

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    // The CPU creates the output, GBuffer and quarter-resolution cache from
    // this same render extent, and rebuilds the UBO together with all
    // resolution-dependent resources.  Avoid two image queries in every
    // full-resolution invocation while retaining the exact ceil(size / 4)
    // cache allocation rule.
    ivec2 imgSize = max(ivec2(screenSize.xy), ivec2(1));
    ivec2 probeCacheSize =
        (imgSize + ivec2(SSGI_PROBE_CACHE_TILE_SIZE - 1)) >>
        ivec2(SSGI_PROBE_CACHE_TILE_SHIFT);
    PrefetchSSGISharedInputs(probeCacheSize, imgSize);
    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y)
        return;

    // GBuffer2 is cleared to w=0 for sky and every deferred writer stores
    // positive view-space linear depth for geometry.  It is already resident
    // in the cooperative surface tile, so reuse it for the sky/far-plane test
    // instead of fetching the separate hardware depth image per pixel.
    vec4 surfaceData = LoadSharedSurfacePosition(pixelCoord);
    if (surfaceData.w <= 0.0 || surfaceData.w >= FarPlane)
    {
        imageStore(resultR, pixelCoord, vec4(0.0));
        return;
    }

    vec4 normalData = texelFetch(inputNormal, pixelCoord, 0);
    vec3 normal = normalize(normalData.xyz);
    vec3 surfacePosition = surfaceData.xyz;
    vec3 giNormal = ComputeSSGIGINormal(pixelCoord, imgSize, surfacePosition, normal);
    float vegetationTranslucency = GetVegetationTranslucency(
        pixelCoord, normalData.w);
    vec3 fallbackIrradiance;
    float screenHitConfidence = 0.0;
    if (!TrySampleProbeCache(
        pixelCoord, probeCacheSize, surfaceData.w, giNormal,
        fallbackIrradiance, screenHitConfidence))
        fallbackIrradiance = EvaluateSSGICacheMissFallback(
            giNormal, vegetationTranslucency);
    vec3 irradiance = fallbackIrradiance;

    // Alpha carries the screen-hit confidence into temporal accumulation.
    // Probe-only fallback remains valid lighting but starts with shorter
    // history so newly revealed regions converge without stale persistence.
    imageStore(resultR, pixelCoord, vec4(max(irradiance, vec3(0.0)), screenHitConfidence));
}
