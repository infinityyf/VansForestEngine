#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable

#include "../Common/Common.glsl"

layout(location = 0) rayPayloadEXT RayTracePayload hitResult;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;

layout(set = 0, binding = 1, rgba16f) uniform image3D resultImage;
layout(set = 0, binding = 2, std430) buffer hitPositionBuffer
{
    f16vec4 hitPosition[];
} hitPositionInfoBuffer;

layout(set = 0, binding = 6, std430) buffer hitNormalBuffer
{
    f16vec4 hitNormal[];
} hitNormalInfoBuffer;

layout(set = 0, binding = 8, std430) buffer hitAlbedoRoughnessBuffer
{
    f16vec4 albedoRoughness[];
} hitAlbedoRoughnessInfoBuffer;

layout(push_constant) uniform PushConstants
{
    vec4 gridParams;     // xyz = probe spacing, w = max ray distance
    vec4 cameraDir;
    vec4 cameraUp;
    vec4 cameraRight;
    vec4 dispatchParams; // xyz = probe counts, w = rays per probe
    vec4 frameParams;
    vec4 regionParams;
    vec4 lightingParams;
} pushConstants;

void main()
{
    ivec3 originCount = ivec3(pushConstants.dispatchParams.xyz);
    vec3 originStride = pushConstants.gridParams.xyz;
    int sampleCount = int(pushConstants.dispatchParams.w);

    vec3 originSize = vec3(originCount) * originStride;
    vec3 volumeMin = pushConstants.regionParams.xyz - originSize * 0.5;

    ivec3 probeIndex = ivec3(gl_LaunchIDEXT);
    vec3 probeWorld = volumeMin + (vec3(probeIndex) + 0.5) * originStride;

    float hitCount = 0.0;
    int bufferIndex = probeIndex.z * (originCount.x * originCount.y) + probeIndex.y * originCount.x + probeIndex.x;
    int bufferOffset = bufferIndex * sampleCount;

    for (int rayIndex = 0; rayIndex < sampleCount; ++rayIndex)
    {
        vec3 rayDirection = SampleSphere(rayIndex, sampleCount);

        traceRayEXT(
            tlas,
            gl_RayFlagsOpaqueEXT,
            0xFF,
            0, 0, 0,
            probeWorld,
            0.001,
            rayDirection,
            pushConstants.gridParams.w,
            0);

        hitCount += hitResult.positionHit.w;

        // 缓存每个 probe、每个方向的首次命中信息。
        // 后续 GIPointLight 在这些静态命中点上重新计算光照与 shadow。
        hitPositionInfoBuffer.hitPosition[bufferOffset + rayIndex] = f16vec4(hitResult.positionHit);
        hitNormalInfoBuffer.hitNormal[bufferOffset + rayIndex] = f16vec4(hitResult.normalHit);
        hitAlbedoRoughnessInfoBuffer.albedoRoughness[bufferOffset + rayIndex] = f16vec4(hitResult.albedoRoughness);
    }

    // resultImage.x 记录 miss ratio，可用于检查 probe 是否被几何包围。
    imageStore(resultImage, probeIndex, vec4(1.0 - hitCount / float(sampleCount), 0.0, 0.0, 0.0));
}
