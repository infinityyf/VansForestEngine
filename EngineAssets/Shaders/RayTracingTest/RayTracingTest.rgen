#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable

#include "../Common/Common.glsl"
#include "../GI/GIProbeUpdateCommon.glsl"
#define GI_WORK_SET 0
#define GI_WORK_BINDING 12
#define GI_LAYOUT_SET 0
#define GI_LAYOUT_BINDING 13
#include "../GI/GIProbeLayoutData.glsl"
#include "../GI/GIProbeWorkData.glsl"

layout(location = 0) rayPayloadEXT RayTracePayload hitResult;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba16f) uniform image3D resultImage;
layout(set = 0, binding = 2, std430) buffer hitPositionBuffer { float hitDistance[]; } hitPositionInfoBuffer;
layout(set = 0, binding = 6, std430) buffer hitNormalBuffer { f16vec4 hitNormal[]; } hitNormalInfoBuffer;
layout(set = 0, binding = 8, std430) buffer hitAlbedoRoughnessBuffer { f16vec4 albedoRoughness[]; } hitAlbedoRoughnessInfoBuffer;
layout(set = 0, binding = 11, std430) buffer hitEmissionBuffer { f16vec4 emission[]; } hitEmissionInfoBuffer;
#include "../GI/GIProbeStateData.glsl"
layout(set = 0, binding = 9, std430) readonly buffer ProbeStateBuffer { GIProbeState states[]; } probeStates;

layout(push_constant) uniform PushConstants
{
    vec4 gridParams;
    vec4 dispatchParams;
    vec4 frameParams;
    vec4 regionParams;
    vec4 lightingParams;
    vec4 temporalParams;
} pushConstants;

void main()
{
    ivec3 probeCounts = ivec3(pushConstants.dispatchParams.xyz);
    uint raysPerUpdate = giProbeWork.header.y;
    uint activeProbeLinear = gl_LaunchIDEXT.x / raysPerUpdate;
    if (activeProbeLinear >= giProbeWork.header.x) return;
    uint localRay = gl_LaunchIDEXT.x % raysPerUpdate;
    uvec4 work = giProbeWork.entries[activeProbeLinear];
    ivec3 probeIndex = GI_WorkProbeCoordinate(work.x, probeCounts);

    vec3 volumeMin = pushConstants.regionParams.xyz - vec3(probeCounts) * pushConstants.gridParams.xyz * 0.5;
    uint probeLinear = work.x;
    vec3 probeWorld = GI_LayoutProbePosition(giProbeWork.header.z, work.x, probeCounts, volumeMin, pushConstants.gridParams.xyz) +
        probeStates.states[probeLinear].relocationAndConfidence.xyz;
    GIProbeRayDirectionContext context = GI_BuildProbeRayDirectionContext(
        probeIndex, probeCounts, uint(pushConstants.dispatchParams.w), work.z);
    bool fixedGeometryRay;
    vec3 rayDirection = GI_ProbeRayDirectionPrepared(context, localRay, fixedGeometryRay);
    hitResult.geometryOnly = fixedGeometryRay ? 1u : 0u;
    // Alpha-tested surfaces use the program's any-hit stage.  Fully transparent
    // materials are excluded from the GI TLAS during scene construction.
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, probeWorld, 0.001,
        rayDirection, pushConstants.gridParams.w, 0);

    uint bufferIndex = GI_WorkRayOffset(activeProbeLinear) + localRay;
    hitPositionInfoBuffer.hitDistance[bufferIndex] = hitResult.hitDistance;
    hitNormalInfoBuffer.hitNormal[bufferIndex] = f16vec4(hitResult.normalHit);
    hitAlbedoRoughnessInfoBuffer.albedoRoughness[bufferIndex] = f16vec4(hitResult.albedoRoughness);
    hitEmissionInfoBuffer.emission[bufferIndex] = f16vec4(hitResult.emissiveRadiance);

    // 唯一写入者消除诊断图像的同址竞争；完整命中率由预览读取工作集计算。
    if (localRay == 0u)
        imageStore(resultImage, probeIndex, vec4(hitResult.hitDistance < 0.0 ? 1.0 : 0.0, 1.0, 0.0, 1.0));
}
