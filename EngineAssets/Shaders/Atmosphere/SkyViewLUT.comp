#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/CameraData.glsl"
#include "AtmosphereCommon.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2D skyViewOutput;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(skyViewOutput);
    if (any(greaterThanEqual(pixel, extent)))
        return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
    vec3 direction = AtmosphereSkyDirectionFromUv(uv);
    vec3 origin = vec3(0.0);

    float atmosphereEntry;
    float atmosphereExit;
    if (!AtmosphereRaySphere(origin, direction,
        uAtmosphereFrame.planetCenterRelativeToCameraMeters.xyz,
        AtmosphereTopRadius(), atmosphereEntry, atmosphereExit))
    {
        imageStore(skyViewOutput, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    float startDistance = atmosphereEntry;
    float endDistance = atmosphereExit;
    float groundDistance;
    bool hitsGround = AtmosphereRayHitsGround(origin, direction, groundDistance);
    if (hitsGround)
        endDistance = min(endDistance, groundDistance);
    float rayLength = max(endDistance - startDistance, 0.0);
    uint sampleCount = max(uAtmosphere.atmosphereLutSampleCounts.z, 1u);
    float stepMeters = rayLength / float(sampleCount);
    vec3 opticalDepth = vec3(0.0);
    vec3 luminance = vec3(0.0);
    for (uint sampleIndex = 0u; sampleIndex < sampleCount; ++sampleIndex)
    {
        float distance = startDistance + (float(sampleIndex) + 0.5) * stepMeters;
        vec3 position = origin + direction * distance;
        AtmosphereMedium medium = EvaluateAtmosphereMedium(AtmosphereAltitude(position));
        vec3 viewTransmittance = exp(-min(opticalDepth, vec3(80.0)));
        // SkyView is the stable clear-sky cache. Dynamic cloud shadows are a
        // high-frequency, view-dependent term and belong to the camera-space
        // aerial volume; baking them here creates large angular LUT blocks.
        vec3 scatteringSource = EvaluateAtmosphereClearSkyScatteringSource(
            position, direction, medium);
        luminance += viewTransmittance * AtmosphereIntegratedSegmentSource(
            scatteringSource, medium.extinction, stepMeters);
        opticalDepth += medium.extinction * stepMeters;
    }

    if (hitsGround && groundDistance <= atmosphereExit)
    {
        vec3 groundPosition = origin + direction * groundDistance;
        vec3 normal = normalize(groundPosition -
            uAtmosphereFrame.planetCenterRelativeToCameraMeters.xyz);
        vec3 groundAlbedo = uAtmosphere.ozoneHalfWidthAndGroundAlbedo.yzw;
        vec3 groundLighting = vec3(0.0);
        for (uint bodyIndex = 0u; bodyIndex < 2u; ++bodyIndex)
        {
            AtmosphereCelestialBody body = uAtmosphereFrame.atmosphereCelestialBodies[bodyIndex];
            if (body.directionAndValidity.w <= 0.5)
                continue;
            vec3 lightDirection = normalize(body.directionAndValidity.xyz);
            vec3 directTransmittance = SampleAtmosphereTransmittance(
                groundPosition, lightDirection);
            groundLighting += body.topOfAtmosphereIrradiance.rgb *
                directTransmittance *
                max(dot(normal, lightDirection), 0.0);
        }
        luminance += exp(-min(opticalDepth, vec3(80.0))) *
            groundAlbedo * groundLighting / ATM_PI;
    }
    imageStore(skyViewOutput, pixel, vec4(max(luminance, vec3(0.0)), 1.0));
}
