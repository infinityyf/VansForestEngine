#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/CameraData.glsl"
#include "AtmosphereCommon.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D transmittanceOutput;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(transmittanceOutput);
    if (any(greaterThanEqual(pixel, extent)))
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
    float radius;
    float zenithCosine;
    AtmosphereTransmittanceRMu(uv, radius, zenithCosine);
    float sine = sqrt(max(1.0 - zenithCosine * zenithCosine, 0.0));
    vec3 origin = uAtmosphereFrame.planetCenterRelativeToCameraMeters.xyz +
        vec3(0.0, radius, 0.0);
    vec3 direction = normalize(vec3(sine, zenithCosine, 0.0));
    float distanceMeters = AtmosphereDistanceToTop(origin, direction);
    uint sampleCount = max(uAtmosphere.atmosphereLutSampleCounts.x, 1u);
    float stepMeters = distanceMeters / float(sampleCount);
    vec3 opticalDepth = vec3(0.0);
    for (uint sampleIndex = 0u; sampleIndex < sampleCount; ++sampleIndex)
    {
        float distance = (float(sampleIndex) + 0.5) * stepMeters;
        float altitude = AtmosphereAltitude(origin + direction * distance);
        opticalDepth += EvaluatePhysicalAtmosphereMedium(altitude).extinction * stepMeters;
    }
    imageStore(transmittanceOutput, pixel,
        vec4(exp(-min(opticalDepth, vec3(80.0))), 1.0));
}
