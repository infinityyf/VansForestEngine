#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/CameraData.glsl"
#include "AtmosphereCommon.glsl"
#include "AtmosphereViewCommon.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 1, binding = 3, rgba16f) uniform writeonly image3D aerialScatteringOutput;
layout(set = 1, binding = 4, rgba16f) uniform writeonly image3D aerialOpticalDepthOutput;
layout(set = 1, binding = 10, rgba16f) uniform writeonly image3D aerialClearScatteringOutput;

void main()
{
    ivec2 froxel = ivec2(gl_GlobalInvocationID.xy);
    ivec3 extent = imageSize(aerialScatteringOutput);
    if (any(greaterThanEqual(froxel, extent.xy)))
        return;
    vec2 renderPixel = (vec2(froxel) + 0.5) *
        float(uAtmosphereFrame.atmosphereViewParameters.z);
    vec2 uv = clamp(renderPixel / vec2(uAtmosphereFrame.atmosphereViewParameters.xy),
        vec2(0.0), vec2(1.0));
    vec3 direction = AtmosphereWorldDirectionFromUv(uv);
    float maximumDistance = uAtmosphereFrame.cameraWorldMetersAndMaxDistance.w;
    uint samplesPerSlice = max(uAtmosphere.atmosphereLutSampleCounts.w, 1u);
    vec3 cumulativeLuminance = vec3(0.0);
    vec3 cumulativeClearLuminance = vec3(0.0);
    vec3 cumulativeOpticalDepth = vec3(0.0);
    float previousDistance = 0.0;
    for (int slice = 0; slice < extent.z; ++slice)
    {
		float normalizedEnd = float(slice) / float(max(extent.z - 1, 1));
        float endDistance = normalizedEnd * normalizedEnd * maximumDistance;
        float stepMeters = (endDistance - previousDistance) / float(samplesPerSlice);
        for (uint sampleIndex = 0u; sampleIndex < samplesPerSlice; ++sampleIndex)
        {
			float segmentStart = previousDistance + float(sampleIndex) * stepMeters;
			float segmentEnd = segmentStart + stepMeters;
			float distance = 0.5 * (segmentStart + segmentEnd);
            vec3 position = direction * distance;
			AtmosphereMedium atmosphere = EvaluatePhysicalAerialPerspectiveSegmentMedium(
				position, direction, segmentStart, segmentEnd);
			ParticipatingMediaSample shadowedMedium = EmptyParticipatingMediaSample();
			AddParticipatingMediaSample(shadowedMedium,
				EvaluateAtmosphereScatteringSource(position, direction, atmosphere),
				atmosphere.extinction);
			ParticipatingMediaSample clearMedium = EmptyParticipatingMediaSample();
			AddParticipatingMediaSample(clearMedium,
				EvaluateAtmosphereClearSkyScatteringSource(
					position, direction, atmosphere),
				atmosphere.extinction);
			vec3 clearOpticalDepth = cumulativeOpticalDepth;
			IntegrateParticipatingMediaStep(clearMedium, stepMeters,
				cumulativeClearLuminance, clearOpticalDepth);
			IntegrateParticipatingMediaStep(shadowedMedium, stepMeters,
				cumulativeLuminance, cumulativeOpticalDepth);
        }
        imageStore(aerialScatteringOutput, ivec3(froxel, slice),
            vec4(max(cumulativeLuminance, vec3(0.0)), 1.0));
        imageStore(aerialClearScatteringOutput, ivec3(froxel, slice),
            vec4(max(cumulativeClearLuminance, vec3(0.0)), 1.0));
        imageStore(aerialOpticalDepthOutput, ivec3(froxel, slice),
            vec4(min(cumulativeOpticalDepth, vec3(80.0)), endDistance));
        previousDistance = endDistance;
    }
}
