#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#include "../Common/Common.glsl"
#include "../GI/GIReceiverTransportData.glsl"
#include "../GIReceiverBias/GIReceiverBiasCommon.glsl"
#include "../GI/GIProbeStateData.glsl"
#define PUNCTUAL_SHADOW_CONSUMER_GI 1
#include "../Lights/LightsData.glsl"
layout(set=2,binding=0) uniform accelerationStructureEXT topLevelAS;
layout(set=1,binding=5,rgba16f) uniform image2D outputRadiance;
struct SSGIRegionParams { vec4 volumeMin; vec4 volumeSizeAndBias; vec4 traceParams; vec4 gridDimensionsAndPriority; };
layout(set=1,binding=7) uniform ReceiverInfo
{
    vec4 screenSize; vec4 regionInfo; SSGIRegionParams regions[8]; vec4 deferredProbeDebug;
};
layout(set=1,binding=8) uniform sampler2D irradianceAtlas[8];
layout(set=1,binding=9) uniform sampler2D visibilityAtlas[8];
layout(set=1,binding=10,std430) readonly buffer ReceiverStates { GIProbeState states[]; } probeStateBuffers[8];
#define GI_LOAD_PROBE_STATE(regionIndex,probeLinearIndex) probeStateBuffers[nonuniformEXT(regionIndex)].states[probeLinearIndex]
#define GI_LAYOUT_SET 1
#define GI_LAYOUT_BINDING 20
#include "../GI/GIProbeLayoutData.glsl"
#include "../GI/GIProbeCommon.glsl"
layout(set=1,binding=25,std430) readonly buffer ReceiverWork { uvec4 header; GIReceiverTransportJob jobs[]; } work;
layout(set=1,binding=26) uniform samplerCube environmentMap;
layout(set=1,binding=28) uniform sampler2D shadowMap;
layout(set=1,binding=29) uniform sampler2DShadow punctualShadowMap[PUNCTUAL_SHADOW_ATLAS_COUNT];
layout(push_constant) uniform ReceiverLimits { vec4 radianceLimits; } limits;
layout(location=0) rayPayloadEXT RayTracePayload prd;

float ReceiverHitNormalBias(vec3 position,vec3 normal,float requested)
{
    float epsilon=GI_ReceiverOriginEpsilon(position);
    if(requested<=epsilon) return requested;
    // 独立短射线仅取得最近距离；保存主命中的材质，不能被净空查询覆盖。
    RayTracePayload surfacePayload=prd;
    prd.geometryOnly=1u;
    traceRayEXT(topLevelAS,gl_RayFlagsNoneEXT,0xff,0,0,0,position+normal*epsilon,
        0.0,normal,requested*1.25-epsilon,0);
    float distance=prd.hitDistance<0.0?-1.0:prd.hitDistance+epsilon;
    prd=surfacePayload;
    return GI_ClampReceiverBias(requested,distance,epsilon);
}

vec3 ReceiverHitIrradiance(vec3 position,vec3 normal)
{
    uint selected=GI_INVALID_ADDRESS;
    float priority=-3.402823e38;
    for(uint i=0u;i<uint(regionInfo.x);++i)
    {
        SSGIRegionParams region=regions[i];
        if(any(lessThan(position,region.volumeMin.xyz)) || any(greaterThan(position,region.volumeMin.xyz+region.volumeSizeAndBias.xyz))) continue;
        if(region.gridDimensionsAndPriority.w>priority)
        { selected=i; priority=region.gridDimensionsAndPriority.w; }
    }
    if(selected==GI_INVALID_ADDRESS) return vec3(0.0);
    SSGIRegionParams region=regions[selected];
    float normalBias=region.volumeSizeAndBias.w;
    normalBias=ReceiverHitNormalBias(position,normal,normalBias); // 注释此行只关闭二次命中的偏移修正。
    return GI_SampleProbeIrradianceAtlasVisible(selected,ivec3(region.gridDimensionsAndPriority.xyz),
        irradianceAtlas[nonuniformEXT(selected)],visibilityAtlas[nonuniformEXT(selected)],position,normal,
        region.volumeMin.xyz,region.volumeSizeAndBias.xyz,normalBias,region.traceParams.z);
}
void main()
{
    uint index=gl_LaunchIDEXT.x;
    if(work.header.w==0u || index>=min(work.header.y,GI_RECEIVER_TRANSPORT_JOBS)) return;
    GIReceiverTransportJob job=work.jobs[index];
    vec3 irradiance=job.screenRadiance.rgb;
    for(uint ray=0u;ray<GI_RECEIVER_TRANSPORT_RAYS;++ray)
    {
        float missing=job.directions[ray].w;
        if(missing<=0.0) continue;
        vec3 direction=job.directions[ray].xyz;
        prd.geometryOnly=0u;
        // 使用完整世界 GI 距离；屏幕外和 Hi-Z 未命中本身都不能视为天空可见。
        traceRayEXT(topLevelAS,gl_RayFlagsNoneEXT,0xff,0,0,0,job.origin.xyz,0.0,direction,job.origin.w,0);
        vec3 radiance;
        if(prd.hitDistance<0.0) radiance=SampleSkyRadiance(environmentMap,direction);
        else
        {
            vec3 position=job.origin.xyz+direction*prd.hitDistance;
            vec3 normal=normalize(prd.normalHit.xyz);
            vec3 directDiffuse=vec3(0.0);
            CalculateDirectDiffuse(position,normal,shadowMap,punctualShadowMap,prd.albedoRoughness,directDiffuse);
            radiance=max(prd.emissiveRadiance.rgb,vec3(0.0))+directDiffuse+
                min(ReceiverHitIrradiance(position,normal)*clamp(prd.albedoRoughness.rgb,0.0,1.0),vec3(limits.radianceLimits.x));
        }
        irradiance+=clamp(radiance,vec3(0.0),vec3(limits.radianceLimits.y))*(missing/float(GI_RECEIVER_TRANSPORT_RAYS));
    }
    // 仅混合两个已计算的照明估计，不软化遮挡或将未知方向当作天空。
    float weight=clamp(uintBitsToFloat(job.destination.z),0.0,1.0);
    vec3 base=imageLoad(outputRadiance,ivec2(job.destination.xy)).rgb;
    irradiance=mix(base,irradiance,weight);
    // 每个缓存点只有一个写入者；替换缺失项，不叠加已有回退或屏幕命中。
    imageStore(outputRadiance,ivec2(job.destination.xy),vec4(irradiance,-1.0-job.screenRadiance.a));
}
