#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../Common/Common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D rawInput;
layout(set = 1, binding = 1) uniform sampler2D edgeInput;
layout(set = 1, binding = 2) uniform sampler2D normalInput;
layout(set = 1, binding = 3) uniform sampler2D materialInput;
layout(set = 1, binding = 4) uniform sampler2D positionInput;
layout(set = 1, binding = 5, rg16f) uniform writeonly image2D result;

const int filterRadius = 3;
const int tileSize = 8 + 2 * filterRadius;
const int tileCount = tileSize * tileSize;
shared vec2 aoTile[tileCount];
shared vec4 surfaceTile[tileCount];
shared vec4 edgeTile[tileCount];
shared uint grassTile[tileCount];

int Index(ivec2 p) { return p.y * tileSize + p.x; }
vec4 UnpackEdges(uint value)
{
    return vec4((value >> 6) & 3u, (value >> 4) & 3u, (value >> 2) & 3u, value & 3u) / 3.0;
}
float Connection(ivec2 a, ivec2 b)
{
    vec4 ea = edgeTile[Index(a)], eb = edgeTile[Index(b)];
    if (b.x < a.x) return ea.x * eb.y;
    if (b.x > a.x) return ea.y * eb.x;
    if (b.y < a.y) return ea.z * eb.w;
    return ea.w * eb.z;
}
void main()
{
    ivec2 size = imageSize(result);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy) * 8 - filterRadius;
    int thread = int(gl_LocalInvocationID.y) * 8 + int(gl_LocalInvocationID.x);
    for (int i = thread; i < tileCount; i += 64)
    {
        ivec2 p = clamp(tileOrigin + ivec2(i % tileSize, i / tileSize), ivec2(0), size - 1);
        vec3 n = texelFetch(normalInput, p, 0).xyz;
        surfaceTile[i] = vec4(n / max(length(n), 1e-6), texelFetch(positionInput, p, 0).w);
        aoTile[i] = texelFetch(rawInput, p, 0).rg;
        edgeTile[i] = UnpackEdges(uint(round(texelFetch(edgeInput, p, 0).r)));
        grassTile[i] = uint(int(round(texelFetch(materialInput, p, 0).z)) == MATERIAL_ID_GRASS);
    }
    barrier();
    if (any(greaterThanEqual(pixel, size))) return;
    ivec2 center = ivec2(gl_LocalInvocationID.xy) + filterRadius;
    int c = Index(center);
    if (surfaceTile[c].w <= 0.0)
    {
        imageStore(result, pixel, vec4(1.0));
        return;
    }
    vec2 sum = aoTile[c];
    float weightSum = 1.0;
    // 复用各象限上一行/列的连接权重，对所有最短路径取平均。
    // 扩大到 7x7，但不再为每个样本重新遍历两条完整路径。
    const float kernel[4] = float[](1.0, 0.88249690, 0.60653066, 0.32465247);
    for (int sy = -1; sy <= 1; sy += 2)
        for (int sx = -1; sx <= 1; sx += 2)
        {
            float previousRow[4];
            for (int y = 0; y <= filterRadius; ++y)
            {
                float previous = 0.0;
                for (int x = 0; x <= filterRadius; ++x)
                {
                    ivec2 samplePixel = center + ivec2(x * sx, y * sy);
                    float edgeWeight = 1.0;
                    if (x + y > 0)
                    {
                        float horizontal = x > 0 ? previous * Connection(samplePixel - ivec2(sx, 0), samplePixel) : 0.0;
                        float vertical = y > 0 ? previousRow[x] * Connection(samplePixel - ivec2(0, sy), samplePixel) : 0.0;
                        edgeWeight = (float(x) * horizontal + float(y) * vertical) / float(x + y);
                    }
                    previousRow[x] = previous = edgeWeight;
                    if ((x == 0 && y == 0) || (x == 0 && sx > 0) || (y == 0 && sy > 0)) continue;
                    int s = Index(samplePixel);
                    if (surfaceTile[s].w <= 0.0 || grassTile[c] != grassTile[s]) continue;
                    float normalWeight = pow(max(dot(surfaceTile[c].xyz, surfaceTile[s].xyz), 0.0), 8.0);
                    float weight = kernel[x] * kernel[y] * normalWeight * edgeWeight;
                    sum += aoTile[s] * weight;
                    weightSum += weight;
                }
            }
        }
    imageStore(result, pixel, vec4(clamp(sum / weightSum, 0.0, 1.0), 1.0, 1.0));
}
