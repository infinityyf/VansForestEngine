#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/Common.glsl"

// Occlusion HZB mip 0.
// Stores positive linear view-space depth in meters. Invalid sky pixels are
// written as a far sentinel so max-depth reduction remains conservative for
// object occlusion culling.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D inputPosition;
layout(set = 1, binding = 1, r32f) uniform image2D hizMip0;

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 hizSize = imageSize(hizMip0);
    if (pixelCoord.x >= hizSize.x || pixelCoord.y >= hizSize.y)
        return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(hizSize);
    float linearDepth = texture(inputPosition, uv).w;
    if (linearDepth <= 0.0)
        linearDepth = 1e5;

    imageStore(hizMip0, pixelCoord, vec4(linearDepth, 0.0, 0.0, 0.0));
}
