#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/CameraData.glsl"
#include "../Lights/LightsData.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct TreeInstanceGPU
{
    mat4 modelMatrix;
    vec4 boundsSphere;
    uint speciesIndex;
    uint regionIndex;
    uint randomSeed;
    uint padding;
};

struct TreeSpeciesCullInfo
{
    uint visibleOffset;
    uint maxCount;
    uint padding0;
    uint padding1;
};

layout(std430, set = 1, binding = 0) readonly buffer TreeInstances
{
    TreeInstanceGPU instances[];
};

layout(std430, set = 1, binding = 1) buffer TreeVisibleCounts
{
    uint visibleCounts[];
};

layout(std430, set = 1, binding = 2) writeonly buffer TreeVisibleIndices
{
    uint visibleIndices[];
};

layout(std430, set = 1, binding = 3) readonly buffer TreeSpeciesInfos
{
    TreeSpeciesCullInfo speciesInfos[];
};

layout(set = 1, binding = 4) uniform sampler2D hizDepth;

layout(std430, set = 1, binding = 5) buffer TreeLodState
{
    uint lodStates[];
};

layout(push_constant) uniform TreeCullPC
{
    float shadowDistance;
    uint instanceCount;
    uint lodCount;
    uint hizEnabled;
    float hizSampleBias;
    int hizMipCount;
    float lodMidDistance;
    float lodFarDistance;
    float hysteresis;
    uint cullingEnabled;
    uint shadowCascadeCount;
    uint shadowViewValid;
} pc;

#include "../Common/VegetationCulling.glsl"

void main()
{
    // VPMatrix 在同一 workgroup 内相同，6 个视锥面只需提取一次。
    if (gl_LocalInvocationIndex < 6u)
    {
        if (gl_LocalInvocationIndex == 0u) sharedFrustum[0] = extractPlane(UnjitteredVPMatrix, 0,  1.0);
        if (gl_LocalInvocationIndex == 1u) sharedFrustum[1] = extractPlane(UnjitteredVPMatrix, 0, -1.0);
        if (gl_LocalInvocationIndex == 2u) sharedFrustum[2] = extractPlane(UnjitteredVPMatrix, 1,  1.0);
        if (gl_LocalInvocationIndex == 3u) sharedFrustum[3] = extractPlane(UnjitteredVPMatrix, 1, -1.0);
        if (gl_LocalInvocationIndex == 4u) sharedFrustum[4] = extractPlane(UnjitteredVPMatrix, 2,  1.0);
        if (gl_LocalInvocationIndex == 5u) sharedFrustum[5] = extractPlane(UnjitteredVPMatrix, 2, -1.0);
    }
    barrier();

    uint instanceID = gl_GlobalInvocationID.x;
    if (instanceID >= pc.instanceCount)
        return;

    TreeInstanceGPU inst = instances[instanceID];
    vec3 center=inst.boundsSphere.xyz;
    float radius=inst.boundsSphere.w;
    // 按相机到树根的三维距离切换，最后一级不会再因距离被裁掉。
    float cameraDistance=distance(inst.modelMatrix[3].xyz,cameraPosition.xyz);
    uint lod=min(lodStates[instanceID],pc.lodCount-1u);
    float thresholds[2]=float[2](pc.lodMidDistance,pc.lodFarDistance);
    while(lod+1u<pc.lodCount && cameraDistance>thresholds[lod]*(1.0+pc.hysteresis))++lod;
    while(lod>0u && cameraDistance<thresholds[lod-1u]*(1.0-pc.hysteresis))--lod;
    lodStates[instanceID]=lod;
    // 每级阴影独立保留视野外投影者，并使用不高于主画面的网格精度。
    uint shadowLod=min(lod+1u,pc.lodCount-1u);
    if(pc.shadowCascadeCount>0u &&
       distance(inst.modelMatrix[3].xz,cameraPosition.xz)<=pc.shadowDistance) {
        TreeSpeciesCullInfo shadowInfo=speciesInfos[shadowLod];
        for(uint cascade=0u;cascade<pc.shadowCascadeCount;++cascade) {
            if(pc.cullingEnabled!=0u && pc.shadowViewValid!=0u &&
               !sphereIntersectsClipFrustum(uDirectionLight.shadowMatrix[cascade], center, radius))
                continue;
            uint shadowSlot=atomicAdd(visibleCounts[(cascade+1u)*pc.lodCount+shadowLod],1u);
            if(shadowSlot<shadowInfo.maxCount)
                visibleIndices[(cascade+1u)*pc.instanceCount*pc.lodCount+
                               shadowInfo.visibleOffset+shadowSlot]=instanceID;
        }
    }
    bool cullingEnabled=pc.cullingEnabled!=0u;
    TreeSpeciesCullInfo info=speciesInfos[lod];
    if (cullingEnabled && !sphereInsideFrustum(center, radius))
        return;

    if (cullingEnabled && pc.hizEnabled != 0 && FrameIndex >= 1.0 && conservativePreviousFrameHiZOccluded(center, radius))
        return;

    uint slot = atomicAdd(visibleCounts[lod], 1u);
    if (slot < info.maxCount)
        visibleIndices[info.visibleOffset + slot] = instanceID;
}
