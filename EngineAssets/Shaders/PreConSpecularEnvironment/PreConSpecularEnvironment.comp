#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/Common.glsl"
#include "../Common/CubemapDirection.glsl"

const uint MAX_ENVIRONMENT_MIPS = 12u;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform samplerCube inputCubemap;
layout(set = 0, binding = 2, rgba32f) uniform writeonly imageCube specularCubemap[MAX_ENVIRONMENT_MIPS];
layout(set = 0, binding = 3) uniform EnvironmentFilterInfo
{
    uvec4 filterInfo; // x=resolution, y=mipCount, z=diffuse samples, w=specular samples
};

vec2 EnvironmentHammersley(uint index, uint sampleCount)
{
    return vec2(float(index) / float(max(sampleCount, 1u)),
        RadicalInverse_VdC(index));
}

vec3 ImportanceSampleGGX(vec2 xi, vec3 normal, float roughness)
{
    float alpha = roughness * roughness;
    float phi = 2.0 * PI * xi.x;
    float cosTheta = sqrt((1.0 - xi.y) /
        max(1.0 + (alpha * alpha - 1.0) * xi.y, 1.0e-6));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 halfVector = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
    vec3 up = abs(normal.z) < 0.999
        ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * halfVector.x +
        bitangent * halfVector.y + normal * halfVector.z);
}

vec3 EvaluateSpecularRadiance(vec3 reflection, float roughness)
{
    uint sampleCount = max(filterInfo.w, 1u);
    vec3 sum = vec3(0.0);
    float totalWeight = 0.0;
    for (uint sampleIndex = 0u; sampleIndex < sampleCount; ++sampleIndex)
    {
        vec3 halfVector = ImportanceSampleGGX(
            EnvironmentHammersley(sampleIndex, sampleCount), reflection, roughness);
        vec3 lightDirection = normalize(
            2.0 * dot(reflection, halfVector) * halfVector - reflection);
        float weight = max(dot(reflection, lightDirection), 0.0);
        if (weight > 0.0)
        {
            sum += textureLod(inputCubemap, lightDirection, 0.0).rgb * weight;
            totalWeight += weight;
        }
    }
    return sum / max(totalWeight, 1.0e-6);
}

void main()
{
    uint mipCount = clamp(filterInfo.y, 1u, MAX_ENVIRONMENT_MIPS);
    uint mipLevel = gl_GlobalInvocationID.z / 6u;
    uint face = gl_GlobalInvocationID.z % 6u;
    if (mipLevel >= mipCount)
        return;
    uint resolution = max(filterInfo.x >> mipLevel, 1u);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(resolution))))
        return;

    float roughness = mipCount > 1u
        ? float(mipLevel) / float(mipCount - 1u) : 0.0;
    vec3 reflection = CubemapDirectionFromPixel(pixel, face, resolution);
    vec3 radiance = roughness <= 1.0e-4
        ? textureLod(inputCubemap, reflection, 0.0).rgb
        : EvaluateSpecularRadiance(reflection, roughness);
    imageStore(specularCubemap[mipLevel], ivec3(pixel, int(face)),
        vec4(max(radiance, vec3(0.0)), 1.0));
}
