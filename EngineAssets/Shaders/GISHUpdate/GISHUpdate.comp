#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/Common.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 1, binding = 0, std430) buffer directLightResult
{
    f16vec4 directLight[];
} directLightBuffer;

layout(set = 1, binding = 2, rgba32f) uniform image3D resultRImage;
layout(set = 1, binding = 3, rgba32f) uniform image3D resultGImage;
layout(set = 1, binding = 4, rgba32f) uniform image3D resultBImage;

layout(push_constant) uniform PushConstants
{
    vec4 gridParams;     // xyz = probe spacing, w = max ray distance
    vec4 cameraDir;
    vec4 cameraUp;
    vec4 cameraRight;
    vec4 dispatchParams; // xyz = probe counts, w = rays per probe
    vec4 frameParams;    // x = frame index, y = spatial update divisor, z = direction update slices
    vec4 regionParams;   // xyz = volume center, w = normal bias
    vec4 lightingParams; // x = sky intensity, y = max indirect radiance, z = max SH L0
} pushConstants;

void main()
{
    ivec3 originCount = ivec3(pushConstants.dispatchParams.xyz);
    int sampleCount = max(int(pushConstants.dispatchParams.w), 1);

    int updateDivisor = max(int(pushConstants.frameParams.y), 1);
    int spatialPhaseCount = updateDivisor * updateDivisor * updateDivisor;
    int spatialPhase = int(pushConstants.frameParams.x) % spatialPhaseCount;
    ivec3 spatialOffset = ivec3(
        spatialPhase % updateDivisor,
        (spatialPhase / updateDivisor) % updateDivisor,
        spatialPhase / (updateDivisor * updateDivisor));

    ivec3 probeIndex = ivec3(gl_GlobalInvocationID) * updateDivisor + spatialOffset;
    if (any(greaterThanEqual(probeIndex, originCount)))
        return;

    int bufferIndex = probeIndex.z * (originCount.x * originCount.y) + probeIndex.y * originCount.x + probeIndex.x;
    int bufferOffset = bufferIndex * sampleCount;

    int directionSlices = max(int(pushConstants.frameParams.z), 1);
    int completedDirectionCycles = int(pushConstants.frameParams.x) / spatialPhaseCount;
    int currentDirSlice = completedDirectionCycles % directionSlices;
    int endSample = (sampleCount * (currentDirSlice + 1)) / directionSlices;
    bool directionWarmup = completedDirectionCycles < directionSlices;
    int integratedSampleCount = directionWarmup ? clamp(endSample, 1, sampleCount) : sampleCount;
    float weight = FOUR_PI / float(integratedSampleCount);

    vec4 rCurrent = vec4(0.0);
    vec4 gCurrent = vec4(0.0);
    vec4 bCurrent = vec4(0.0);

    for (int rayIndex = 0; rayIndex < integratedSampleCount; ++rayIndex)
    {
        vec3 rayDirection = SampleSphere(rayIndex, sampleCount);
        vec3 radiance = directLightBuffer.directLight[bufferOffset + rayIndex].rgb;

        // 将已写入方向的入射 radiance 投影到 L0+L1 SH。
        // 冷启动阶段只积分已经更新过的方向，完整预热后每次都重新积分全方向。
        for (int i = 0; i < 4; ++i)
        {
            float basis = SHBasis(i, rayDirection);
            rCurrent[i] += radiance.r * basis * weight;
            gCurrent[i] += radiance.g * basis * weight;
            bCurrent[i] += radiance.b * basis * weight;
        }
    }

    // L1 做轻微 windowing，降低强方向光导致的低阶 SH ringing。
    const float l1Window = 0.85;
    for (int i = 1; i < 4; ++i)
    {
        rCurrent[i] *= l1Window;
        gCurrent[i] *= l1Window;
        bCurrent[i] *= l1Window;
    }

    float maxL0 = max(pushConstants.lightingParams.z, 0.0);
    if (maxL0 > 0.0)
    {
        rCurrent[0] = clamp(rCurrent[0], -maxL0, maxL0);
        gCurrent[0] = clamp(gCurrent[0], -maxL0, maxL0);
        bCurrent[0] = clamp(bCurrent[0], -maxL0, maxL0);
    }

    // 当前 SH 由 directLightBuffer 的有效方向集合直接重积分得到。
    // 历史混合会残留旧太阳亮度/颜色，导致主光变化时 GI 明显滞后，因此不在这里做混合。
    imageStore(resultRImage, probeIndex, rCurrent);
    imageStore(resultGImage, probeIndex, gCurrent);
    imageStore(resultBImage, probeIndex, bCurrent);
}
