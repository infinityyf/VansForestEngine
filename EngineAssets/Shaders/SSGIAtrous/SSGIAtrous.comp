#version 450
#extension GL_GOOGLE_include_directive : require

#include "../Common/Common.glsl"
#include "../Common/CameraData.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 1, binding = 0) uniform sampler2D inputGI;
layout(set = 1, binding = 1) uniform sampler2D inputNormal;
layout(set = 1, binding = 2) uniform sampler2D inputDepth;
layout(set = 1, binding = 3) uniform sampler2D inputMaterial;
layout(set = 1, binding = 4, rgba32f) uniform writeonly image2D outputGI;

layout(push_constant) uniform AtrousParams
{
    uint stepWidth;
    float depthSigma;
    float normalPower;
    float materialWeight;
} params;

float LinearDepthAt(ivec2 coord, ivec2 size)
{
    float d = texelFetch(inputDepth, clamp(coord, ivec2(0), size - 1), 0).r;
    return d >= 0.9999 ? FarPlane : LinearizeDepth(d, NearPlane, FarPlane);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputGI);
    if (any(greaterThanEqual(pixel, size)))
        return;

    vec4 center = texelFetch(inputGI, pixel, 0);
    vec3 centerNormal = normalize(texelFetch(inputNormal, pixel, 0).xyz);
    float centerDepth = LinearDepthAt(pixel, size);
    vec4 centerMaterial = texelFetch(inputMaterial, pixel, 0);
    vec3 sum = center.rgb;
    float weightSum = 1.0;
    const float kernel[3] = float[](1.0, 2.0, 1.0);
    int stepWidth = int(max(params.stepWidth, 1u));
    for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x)
    {
        if (x == 0 && y == 0)
            continue;
        ivec2 tap = clamp(pixel + ivec2(x, y) * stepWidth, ivec2(0), size - 1);
        vec4 sampleGI = texelFetch(inputGI, tap, 0);
        vec3 sampleNormal = normalize(texelFetch(inputNormal, tap, 0).xyz);
        float sampleDepth = LinearDepthAt(tap, size);
        vec4 sampleMaterial = texelFetch(inputMaterial, tap, 0);
        float spatialWeight = kernel[x + 1] * kernel[y + 1];
        float depthWeight = exp(-abs(sampleDepth - centerDepth) /
            max(centerDepth * params.depthSigma, 0.02));
        float normalWeight = pow(max(dot(centerNormal, sampleNormal), 0.0), params.normalPower);
        float materialMatch = abs(sampleMaterial.z - centerMaterial.z) < 0.25 ? 1.0 : params.materialWeight;
        float weight = spatialWeight * depthWeight * normalWeight * materialMatch;
        sum += sampleGI.rgb * weight;
        weightSum += weight;
    }
    imageStore(outputGI, pixel, vec4(sum / max(weightSum, 1e-5), center.a));
}
