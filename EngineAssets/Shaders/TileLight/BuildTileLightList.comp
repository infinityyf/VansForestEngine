#version 450
#extension GL_GOOGLE_include_directive : require

// ============================================================================
// BuildTileLightList.comp — 屏幕空间 Tile Light 索引表构建
//
// 功能：每帧一次，将所有点光源/聚光灯按屏幕 Tile 分格裁剪，
//       输出 TileLightHeader 数组（Grid）和光源索引数组（Indices），
//       供表面光照与 LocalMediaInjection.comp 共享读取。
//
// 设计：固定步长分配（无 atomic），每个 invocation 处理一个 Tile
//   - 点光源索引槽：tile T 占用 [T * TILE_LIGHT_MAX_PT_PER_TILE, ...)
//   - 聚光灯索引槽：tile T 占用 [totalTiles*MAX_PT + T*MAX_SP, ...)
//
// Set 0: Camera UBO (binding=0) + Lights SSBO (binding=1) — 全局只读
// Set 1: TileLightHeader SSBO (binding=0) + Indices SSBO (binding=1) + Params UBO (binding=2)
// ============================================================================

#include "../Common/Common.glsl"
#include "../Common/CameraData.glsl"
#include "../Lights/LightsData.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// --- Set 1：Build pass 专用（可写）---
struct TileLightHeaderOut
{
    uint pointOffset;
    uint pointCount;
    uint spotOffset;
    uint spotCount;
    uint rectOffset;
    uint rectCount;
    uint fallbackPoint0;
    uint fallbackPoint1;
    uint fallbackSpot;
    uint fallbackRect;
};

layout(set = 1, binding = 0, std430) buffer OutTileLightGrid
{
    TileLightHeaderOut outTileLightHeaders[];
};

layout(set = 1, binding = 1, std430) buffer OutTileLightIndices
{
    uint outTileLightIndices[];
};

layout(set = 1, binding = 2) uniform TileLightBuildParams
{
    uint tileGridX;
    uint tileGridY;
    uint totalTiles;
    uint pad0;
} uBuildParams;

// ---------------------------------------------------------------------------
// 每个 tile 最大索引槽数（与 TileLightData.glsl 保持一致）
// ---------------------------------------------------------------------------
#define TILE_LIGHT_TILE_SIZE       8
#define TILE_LIGHT_MAX_PT_PER_TILE 64
#define TILE_LIGHT_MAX_SP_PER_TILE 64
#define TILE_LIGHT_MAX_RECT_PER_TILE 16

// ---------------------------------------------------------------------------
// 球体与屏幕 Tile NDC AABB 的保守相交测试。
// 使用 view-space 包围盒在正深度区间上的透视投影区间，而不是
// radius / centerDepth 近似。后者会低估贴近相机或偏离光轴的大球，造成
// Tile 边缘漏光。球穿过 near plane 时覆盖全屏是刻意的保守处理。
// ---------------------------------------------------------------------------
bool SphereTileIntersects(vec3 worldPos, float radius, uint tx, uint ty)
{
    // 变换至视图空间（相机看向 -Z 方向）
    vec4 viewPos4 = ViewMatrix * vec4(worldPos, 1.0);
    vec3 vp       = viewPos4.xyz;

    // Z 深度检测：相机视锥 Z 范围为 [-farPlane, -nearPlane]
    // 球 Z 范围：[vp.z - radius, vp.z + radius]
    // 只要球前沿 > -farPlane 且球后沿 < -nearPlane 即有重叠
    float nearZ = -NearPlane;
    float farZ  = -FarPlane;
    if ((vp.z + radius) < farZ)   return false;  // 完全在 far plane 之外
    if ((vp.z - radius) > nearZ)  return false;  // 完全在相机后方

    float centerDepth = -vp.z;
    if (centerDepth - radius <= NearPlane)
        return true;

    float minDepth = centerDepth - radius;
    float maxDepth = centerDepth + radius;
    vec4 centerClip = ProjectionMatrix * vec4(vp, 1.0);
    vec2 centerNdc = centerClip.xy / max(centerClip.w, 1e-6);
    vec2 projectionScale = vec2(ProjectionMatrix[0][0], ProjectionMatrix[1][1]);
    vec2 projectionOffset = centerNdc - projectionScale * vp.xy / centerDepth;

    float x0 = projectionScale.x * (vp.x - radius) / minDepth + projectionOffset.x;
    float x1 = projectionScale.x * (vp.x - radius) / maxDepth + projectionOffset.x;
    float x2 = projectionScale.x * (vp.x + radius) / minDepth + projectionOffset.x;
    float x3 = projectionScale.x * (vp.x + radius) / maxDepth + projectionOffset.x;
    float sphereMinX = min(min(x0, x1), min(x2, x3));
    float sphereMaxX = max(max(x0, x1), max(x2, x3));

    float y0 = projectionScale.y * (vp.y - radius) / minDepth + projectionOffset.y;
    float y1 = projectionScale.y * (vp.y - radius) / maxDepth + projectionOffset.y;
    float y2 = projectionScale.y * (vp.y + radius) / minDepth + projectionOffset.y;
    float y3 = projectionScale.y * (vp.y + radius) / maxDepth + projectionOffset.y;
    float sphereMinY = min(min(y0, y1), min(y2, y3));
    float sphereMaxY = max(max(y0, y1), max(y2, y3));

    // tile NDC 范围（NDC X：-1 ~ +1 对应 0 ~ screenWidth；NDC Y：-1 ~ +1 对应底部 ~ 顶部）
    // 引擎中 gl_FragCoord.y 从顶部递增（0=top），对应 NDC Y+ = top（GL 约定）
    // Tile Y 编号从 0（顶部）向下增大
    float tileSzX  = 2.0 * float(TILE_LIGHT_TILE_SIZE) / ScreenParams.x;
    float tileSzY  = 2.0 * float(TILE_LIGHT_TILE_SIZE) / ScreenParams.y;
    float tileMinX = -1.0 + float(tx) * tileSzX;
    float tileMaxX = tileMinX + tileSzX;
    // NDC Y+1 = 顶部，tile ty=0 对应顶部
    float tileMaxY = 1.0 - float(ty)       * tileSzY;
    float tileMinY = 1.0 - float(ty + 1u)  * tileSzY;

    return sphereMaxX >= tileMinX && sphereMinX <= tileMaxX &&
           sphereMaxY >= tileMinY && sphereMinY <= tileMaxY;
}

bool IsFallbackCandidate(uint metaIndex)
{
    if (metaIndex == INVALID_SHADOW_INDEX || metaIndex >= uint(MAX_PUNCTUAL_SHADOWS))
        return false;
    PunctualShadowData shadow = uPunctualShadows[metaIndex];
    bool hasAtlas = HasPunctualShadowFlag(shadow.flags, PUNCTUAL_SHADOW_HAS_ATLAS);
    return HasPunctualShadowFlag(shadow.flags, PUNCTUAL_SHADOW_FALLBACK_ELIGIBLE) &&
        (!hasAtlas || shadow.atlasWeight < 0.999);
}

float FallbackImportance(uint metaIndex)
{
    return IsFallbackCandidate(metaIndex) ? uPunctualShadows[metaIndex].importance : -1.0;
}

// ---------------------------------------------------------------------------
void main()
{
    // 每个 invocation 处理一个 tile
    uint tileX   = gl_GlobalInvocationID.x;
    uint tileY   = gl_GlobalInvocationID.y;

    if (tileX >= uBuildParams.tileGridX || tileY >= uBuildParams.tileGridY)
        return;

    uint tileIdx = tileY * uBuildParams.tileGridX + tileX;

    // 计算固定步长偏移（无需 atomic）
    uint ptOffset = tileIdx * TILE_LIGHT_MAX_PT_PER_TILE;
    uint spOffset = uBuildParams.totalTiles * TILE_LIGHT_MAX_PT_PER_TILE
                    + tileIdx * TILE_LIGHT_MAX_SP_PER_TILE;
    uint rcOffset = uBuildParams.totalTiles * TILE_LIGHT_MAX_PT_PER_TILE
                    + uBuildParams.totalTiles * TILE_LIGHT_MAX_SP_PER_TILE
                    + tileIdx * TILE_LIGHT_MAX_RECT_PER_TILE;

    uint ptCount = 0u;
    uint spCount = 0u;
    uint rcCount = 0u;
    uint fallbackPoint0 = INVALID_SHADOW_INDEX;
    uint fallbackPoint1 = INVALID_SHADOW_INDEX;
    uint fallbackSpot = INVALID_SHADOW_INDEX;
    uint fallbackRect = INVALID_SHADOW_INDEX;
    float fallbackPointScore0 = -1.0;
    float fallbackPointScore1 = -1.0;
    float fallbackSpotScore = -1.0;
    float fallbackRectScore = -1.0;

    // --- 点光源 ---
    for (uint i = 0u; i < uPointLightCount && i < uint(MAX_POINT_LIGHTS); ++i)
    {
        PointLightData pl = GetPointLight(int(i));
        if (SphereTileIntersects(pl.position.xyz, pl.radius, tileX, tileY))
        {
            if (ptCount < uint(TILE_LIGHT_MAX_PT_PER_TILE))
            {
                outTileLightIndices[ptOffset + ptCount] = i;
                ptCount++;
            }
            float fallbackScore = FallbackImportance(pl.shadowMetaIndex);
            if (fallbackScore > fallbackPointScore0)
            {
                fallbackPointScore1 = fallbackPointScore0;
                fallbackPoint1 = fallbackPoint0;
                fallbackPointScore0 = fallbackScore;
                fallbackPoint0 = i;
            }
            else if (fallbackScore > fallbackPointScore1)
            {
                fallbackPointScore1 = fallbackScore;
                fallbackPoint1 = i;
            }
        }
    }

    // --- 聚光灯（保守测试：用包围球近似锥体）---
    for (uint i = 0u; i < uSpotLightCount && i < uint(MAX_SPOT_LIGHTS); ++i)
    {
        SpotLightData sl = GetSpotLight(int(i));
        if (SphereTileIntersects(sl.position.xyz, sl.radius, tileX, tileY))
        {
            if (spCount < uint(TILE_LIGHT_MAX_SP_PER_TILE))
            {
                outTileLightIndices[spOffset + spCount] = i;
                spCount++;
            }
            float fallbackScore = FallbackImportance(sl.shadowMetaIndex);
            if (fallbackScore > fallbackSpotScore)
            {
                fallbackSpotScore = fallbackScore;
                fallbackSpot = i;
            }
        }
    }

    // --- 面光源（RectLight）使用与 LightsData.glsl::GetRectSphereCenter/Radius 一致的包围球 ---
    uint rectLightCount = GetRectLightCount();
    for (uint i = 0u; i < rectLightCount && i < uint(MAX_RECT_LIGHTS); ++i)
    {
        RectLightData rl = GetRectLight(int(i));
        vec3  sc = GetRectSphereCenter(rl);
        float sr = GetRectSphereRadius(rl);
        if (SphereTileIntersects(sc, sr, tileX, tileY))
        {
            if (rcCount < uint(TILE_LIGHT_MAX_RECT_PER_TILE))
            {
                outTileLightIndices[rcOffset + rcCount] = i;
                rcCount++;
            }
            float fallbackScore = FallbackImportance(rl.shadowMetaIndex);
            if (fallbackScore > fallbackRectScore)
            {
                fallbackRectScore = fallbackScore;
                fallbackRect = i;
            }
        }
    }

    // --- 写入 Header ---
    outTileLightHeaders[tileIdx].pointOffset = ptOffset;
    outTileLightHeaders[tileIdx].pointCount  = ptCount;
    outTileLightHeaders[tileIdx].spotOffset  = spOffset;
    outTileLightHeaders[tileIdx].spotCount   = spCount;
    outTileLightHeaders[tileIdx].rectOffset  = rcOffset;
    outTileLightHeaders[tileIdx].rectCount   = rcCount;
    outTileLightHeaders[tileIdx].fallbackPoint0 = fallbackPoint0;
    outTileLightHeaders[tileIdx].fallbackPoint1 = fallbackPoint1;
    outTileLightHeaders[tileIdx].fallbackSpot   = fallbackSpot;
    outTileLightHeaders[tileIdx].fallbackRect   = fallbackRect;
}
