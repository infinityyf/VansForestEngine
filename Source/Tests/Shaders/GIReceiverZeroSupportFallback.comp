#version 460
#extension GL_GOOGLE_include_directive : require
#include "../../../EngineAssets/Shaders/SSGI/SSGISurface.glsl"
#include "../../../EngineAssets/Shaders/GI/GIProbeStateData.glsl"
layout(local_size_x=16) in;
layout(set=1,binding=0) uniform sampler2D irradianceAtlas;
layout(set=1,binding=1) uniform sampler2D visibilityAtlas;
layout(set=1,binding=2) uniform sampler2D opaquePreview;
layout(set=1,binding=3) uniform sampler2D originalPreview;
layout(set=1,binding=7,std430) readonly buffer States { GIProbeState values[]; } states[8];
layout(set=1,binding=11,std430) buffer Output { vec4 result[]; };
bool unpublished=false;
GIProbeState LoadState(uint region,uint probe)
{
    GIProbeState state=states[0].values[probe];
    if(unpublished) state.metadata.x=0u;
    return state;
}
#define GI_LOAD_PROBE_STATE(region,probe) LoadState(region,probe)
#define GI_RECEIVER_BINDING 10
#include "../../../EngineAssets/Shaders/GI/GIReceiverVisibilityRead.glsl"
#include "../../../EngineAssets/Shaders/GI/GIProbeCommon.glsl"

void main()
{
    uint i=gl_LocalInvocationID.x;
    if(i>=12u)
    {
        result[i*4u]=texelFetch(opaquePreview,ivec2(int(i-12u),0),0);
        result[i*4u+1u]=texelFetch(originalPreview,ivec2(int(i-12u),0),0);
        return;
    }
    receiverRecord=receiverRecords[i];
    receiverRecordValid=i!=4u;
    unpublished=i==5u;
    vec3 P=vec3(1.0),N=vec3(0,1,0);
    float bias=i==9u?0.2:0.0;
    float volumeWeight=i==10u?0.35:1.0;
    float support;
    vec3 value=GI_SampleProbeIrradianceAtlas(0u,ivec3(2),irradianceAtlas,visibilityAtlas,
        P,N,vec3(0),vec3(2),bias,volumeWeight,4,2,support);
    result[i*4u]=vec4(value,support);
    result[i*4u+3u]=vec4(receiverRecordValid?1.0:0.0,vec3(receiverRecord.metadata.zw,0));

    // 独立参考：使用正式候选和累加函数，但不调用新的零支持回退入口。
    GIProbeCandidates candidates=GI_GatherProbeCandidates(0u,ivec3(2),P,N,vec3(0),vec3(2),bias);
    vec3 strictSum=vec3(0);float strictSupport=0.0;
    for(uint p=0u;p<8u;++p)
        GI_AccumulateProbeIrradiance(0u,candidates.probes[p],irradianceAtlas,visibilityAtlas,
            candidates.positions[p],candidates.samplePosition,N,candidates.weights[p],ivec2(4,2),strictSum,strictSupport);
    result[i*4u+1u]=vec4(strictSupport>0.0?strictSum/strictSupport*volumeWeight*INV_PI:vec3(0),strictSupport);
    receiverRecordValid=false;
    value=GI_SampleProbeIrradianceAtlas(0u,ivec3(2),irradianceAtlas,visibilityAtlas,
        P,N,vec3(0),vec3(2),bias,volumeWeight,4,2,support);
    result[i*4u+2u]=vec4(value,support);
}
