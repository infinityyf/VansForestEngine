#version 450
#extension GL_GOOGLE_include_directive : require
#define GI_WORLD_SET 0
#include "../../../EngineAssets/Shaders/GIWorld/GIWorldQuery.glsl"
layout(local_size_x=1) in;
layout(set=0,binding=7,std430) buffer Output { vec4 results[]; };
layout(push_constant) uniform CaseData { vec4 originAndDistance; vec4 directionAndFootprint; };
void main()
{
    uint i=gl_GlobalInvocationID.x;
    GIWorldHit h=GIWorldTraceVoxels(originAndDistance.xyz,directionAndFootprint.xyz,0,
        originAndDistance.w,i==0u,directionAndFootprint.w);
    results[i]=vec4(h.t,h.transmission,h.valid?1:0,float(h.failure));
}
