#include "../../../EngineAssets/Shaders/GI/GIRegionBlend.glsl"
layout(local_size_x=32) in;
layout(set=0,binding=7,std430) buffer Output { vec4 results[]; };
void main()
{
    uint i=gl_GlobalInvocationID.x;if(i>=39u)return;GIWorldHit h;
    if(i==38u)
    {
        h=GIWorldTraceVoxels(vec3(.1,.5,.5),vec3(1,0,0),0,6,true,0,-1,GIWorldScatterStepBudget());
