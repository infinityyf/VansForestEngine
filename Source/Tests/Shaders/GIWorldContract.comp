        h=GIWorldTraceHeight(vec3(-4,i==18u?.75:.5,-4),normalize(vec3(1,0,1)),0,11.3137085);
        results[i*2]=vec4(h.t,h.transmission,h.valid?1:0,h.backface?1:0);return;
    }
    if(i>=13u)
    {
        regions[0]=BlendRegion(vec4(0),vec4(10),vec4(0,0,2,0),vec4(0));
        regions[1]=BlendRegion(vec4(-20),vec4(50),vec4(0,0,2,0),vec4(0,0,0,-1));
        testLighting[0]=vec3(.2);testLighting[1]=vec3(.6);regionInfo=vec4(1,0,0,0);
        testPublished[0]=testPublished[1]=1.0;
