        h=GIWorldTraceVoxels(vec3(4,3,3),vec3(1,0,0),0,2,true,0,0);
        results[69].x=h.scattering.w;
        h=GIWorldTraceVoxels(vec3(.1,.5,.5),vec3(1,0,0),0,.8,true,0,10);
        results[69].y=h.scattering.w;
