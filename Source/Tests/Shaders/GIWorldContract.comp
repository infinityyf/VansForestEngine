        results[77]=GIWorldTraceHeight(vec3(-4,2,-4),vec3(0,-1,0),0,10).material;return;
    }
    if(i==37u)
    {
        vec3 scattered=GIWorldSparseScatterRadiance(vec3(1),vec3(2),1.0,1.0,8.0);
        vec3 selected=GIWorldCompositeRadiance(vec3(2),.5,scattered,8.0);
        results[74]=vec4(selected,GI_WORLD_SCATTER_PROBABILITY);
        results[75]=vec4(selected*GI_WORLD_SCATTER_PROBABILITY+vec3(1)*(1-GI_WORLD_SCATTER_PROBABILITY),float(GIWorldScatterStepBudget()));
        return;
    }
    if(i==32u || i==33u || i==35u)
    {
        vec3 radiance=vec3(0);bool valid=true;float lastT=0,transmission=1;
        for(uint sampleIndex=0u;sampleIndex<1024u;++sampleIndex)
        {
            float tau=GIWorldScatterOpticalDepth((float(sampleIndex)+.5)/1024.0);
