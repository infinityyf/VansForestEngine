#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../../EngineAssets/Shaders/Common/CameraData.glsl"
#include "../../../EngineAssets/Shaders/Common/Common.glsl"
#include "../../../EngineAssets/Shaders/Grass/GrassScreenAO.glsl"
#include "../../../EngineAssets/Shaders/BRDF/GrassBSDF.glsl"
#include "../../../EngineAssets/Shaders/Grass/GrassSurfaceNormal.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(set=1,binding=0) uniform sampler2D positions;
layout(set=1,binding=1) uniform sampler2D materials;
layout(set=1,binding=2) uniform sampler2D normals;
layout(set=1,binding=3,rgba16f) uniform image2D result;
layout(push_constant) uniform TestParams { uint mode; } test;
vec3 GrassTestVisibleGGX(float NoV,float roughness,vec2 xi)
{
    float alpha=roughness*roughness;
    vec3 Vh=normalize(vec3(alpha*sqrt(1.0-NoV*NoV),0,NoV));
    vec3 T1=vec3(0,1,0),T2=cross(Vh,T1);
    float r=sqrt(xi.x),phi=2.0*PI*xi.y;
    float p1=r*cos(phi),p2=r*sin(phi),s=0.5*(1.0+Vh.z);
    p2=mix(sqrt(max(1.0-p1*p1,0.0)),p2,s);
    vec3 Nh=p1*T1+p2*T2+sqrt(max(1.0-p1*p1-p2*p2,0.0))*Vh;
    return normalize(vec3(alpha*Nh.xy,max(Nh.z,0.0)));
}
void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),size=imageSize(result);
    if(any(greaterThanEqual(pixel,size))) return;
    if(test.mode==11u)
    {
        vec3 origin=vec3(0,0,-1),N=vec3(0,0,1);
        imageStore(result,pixel,vec4(GrassRayOcclusion(positions,materials,origin,N,normalize(vec3(0.4,0,1))),
            GrassRayOcclusion(positions,materials,origin,-N,normalize(vec3(0.4,0,-1))),0,1));return;
    }
    if(test.mode>=7u && test.mode<=10u)
    {
        float NoV=1e-4+(1.0-1e-4)*pow(float(pixel.x)/float(size.x-1),3.0);
        float roughness=mix(0.045,1.0,float(pixel.y)/float(size.y-1));
        vec4 energy=GrassIntegratedEnergy(NoV,roughness);
        if(test.mode==10u)
        {
            imageStore(result,pixel,vec4(abs(GrassIntegratedEnergy(1.0,roughness).x-GrassIntegratedEnergy(0.9999,roughness).x),
                abs(GrassIntegratedEnergy(0.0,roughness).x-GrassIntegratedEnergy(1e-4,roughness).x),0,1));return;
        }
        BRDFData b;b.normal=vec3(0,0,1);b.viewDirection=vec3(sqrt(1.0-NoV*NoV),0,NoV);
        b.albedo=vec3(1);b.roughness=roughness;
        float transmission=test.mode==7u?0.0:(test.mode==8u?81.0/255.0:1.0);
        float diffuse=0.0,specular=0.0;
        const uint count=16384u;
        for(uint i=0u;i<count;++i)
        {
            vec2 xi=vec2((float(i)+0.5)/float(count),RadicalInverse_VdC(i));
            float z=1.0-2.0*xi.x,phi=2.0*PI*xi.y;
            vec3 L=vec3(sqrt(1.0-z*z)*vec2(cos(phi),sin(phi)),z),d,s;
            GrassBSDF(b,L,transmission,energy,d,s);diffuse+=d.r*(4.0*PI);
            vec3 H=GrassTestVisibleGGX(NoV,roughness,xi);
            L=reflect(-b.viewDirection,H);
            GrassBSDF(b,L,transmission,energy,d,s);
            float a2=pow(roughness,4.0);
            float G1=2.0*NoV/(NoV+sqrt(NoV*NoV*(1.0-a2)+a2));
            float pdf=D_GGX(max(H.z,0.0),roughness)*G1/(4.0*NoV);
            specular+=s.r/max(pdf,1e-10);
        }
        diffuse/=float(count);specular/=float(count);
        vec2 weights=GrassDiffuseHemisphereWeights(energy,transmission);
        imageStore(result,pixel,vec4(diffuse+specular,weights.x+weights.y+energy.x,energy.x,specular));return;
    }
    if(test.mode==0u)
    {
        vec3 N=normalize(texelFetch(normals,pixel,0).xyz);
        imageStore(result,pixel,vec4(GrassHemisphereAO(positions,materials,vec3(0,0,-1),N),
            GrassHemisphereAO(positions,materials,vec3(0,0,-1),-N),0,1));
        return;
    }
    if(test.mode==5u)
    {
        int variant=pixel.x%6;
        vec3 dpdx=vec3(1,0,0),dpdy=vec3(0,1,0);
        vec2 duvdx=vec2(1,0),duvdy=vec2(0,1);
        if(variant==1) {dpdy=-dpdy;duvdy=-duvdy;}
        if(variant==2) duvdx=-duvdx;
        if(variant==3) duvdy=-duvdy;
        if(variant==4) {duvdx=vec2(0);duvdy=vec2(0);}
        mat3 frame=GrassTangentFrame(vec3(0,0,1),dpdx,dpdy,duvdx,duvdy);
        vec3 encoded=variant==4?vec3(0.5,0.5,1):vec3(0.65,0.7,0.9330127);
        vec3 viewDirection=variant==5?vec3(0,0,-1):vec3(0,0,1);
        bool backFace=GrassIsBackFace(frame[2],dpdx,dpdy,viewDirection);
        vec3 N=GrassMappedNormal(frame,encoded,1.0,backFace);
        imageStore(result,pixel,vec4(N,length(N)));return;
    }
    if(test.mode==6u)
    {
        mat3 deformation=mat3(vec3(2,0,0),vec3(0.5,3,0),vec3(0,0,0.5));
        if((pixel.x&1)!=0) deformation[0]=-deformation[0];
        vec3 sourceN=normalize(vec3(1,1,1));
        vec3 N=GrassTransformNormal(deformation,sourceN);
        vec3 tangent=deformation*vec3(1,-1,0);
        vec3 bitangent=deformation*vec3(1,0,-1);
        imageStore(result,pixel,vec4(dot(N,normalize(tangent)),dot(N,normalize(bitangent)),length(N),1));return;
    }
    BRDFData b;
    b.normal=vec3(0,0,1);b.viewDirection=vec3(0,0,1);b.albedo=vec3(0.3,0.5,0.1);b.roughness=0.5;
    vec3 L=test.mode==1u?vec3(0,0,1):vec3(0,0,-1);
    if(test.mode==4u)
    {
        float angle=float(pixel.x)/float(size.x-1)*PI;
        L=vec3(sin(angle),0,cos(angle));
        b.roughness=mix(0.045,1.0,float(pixel.y)/float(size.y-1));
    }
    vec3 d,s;
    GrassBSDF(b,L,test.mode==3u?0.0:0.5,GrassIntegratedEnergy(1.0,b.roughness),d,s);
    imageStore(result,pixel,vec4(d,s.r));
}
